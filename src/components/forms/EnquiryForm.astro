---
import { projectTypes, investmentBands } from '@data/enquiry';
import { buildDirectWhatsAppUrl } from '@lib/whatsapp';

/**
 * Private project enquiry.
 *
 * Two things happen on submit, in this order:
 *
 *   1. WhatsApp is opened with the message pre-filled. This MUST be the first
 *      thing after validation, synchronously inside the submit handler. Any
 *      awaited call before it moves window.open outside the user gesture and
 *      Safari and Chrome then block it silently.
 *
 *   2. The same enquiry is posted to Netlify Forms. This is the safety net.
 *      A deep link only pre-fills a message — if the visitor closes the tab
 *      without pressing Send, the lead is gone unless it was captured here.
 *
 * Visually the form is a single document handed across a table: one numbered
 * header, one field grid, one solid action. Text fields are hairline
 * underlines rather than boxes; only the note is a ruled box, because it is
 * the one field that should look like somewhere to write at length. Error and
 * focus states are carried on the underline, which is the only part of a
 * field that has any weight to give.
 */

const whatsappHref = buildDirectWhatsAppUrl();

/*
  Shared field shape. `aria-invalid` is what the script sets, so the error
  colour is driven by the same attribute assistive technology reads rather
  than by a second, parallel class.
*/
const fieldBase = [
  'w-full rounded-none border-0 border-b border-beige bg-transparent px-0 py-3',
  'text-small text-charcoal transition-colors duration-300',
  'hover:border-charcoal/40',
  'focus:border-teal focus:outline-none focus:ring-0',
  'aria-[invalid=true]:border-brass',
].join(' ');

const inputClass = `${fieldBase} mt-1 placeholder:text-charcoal/30`;

/*
  The select keeps its own chevron, so the wrapper carries the spacing and the
  control itself sits flush. `invalid:` greys the placeholder option until a
  real choice is made — the form is novalidate, which suppresses browser
  validation UI but not the pseudo-class.
*/
const selectClass = `${fieldBase} appearance-none pr-8 invalid:text-charcoal/40`;

const labelClass = 'label block text-teal/55';
const errorClass = 'mt-2 text-micro text-brass hidden';
---

<form
  name="enquiry"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  data-enquiry-form
  novalidate
  class="w-full"
>
  {/* Required by Netlify Forms on a JavaScript-submitted form. */}
  <input type="hidden" name="form-name" value="enquiry" />
  <input type="hidden" name="source" value="website" />

  {/* Honeypot. Hidden from people, irresistible to bots. */}
  <p class="visually-hidden" aria-hidden="true">
    <label>
      Do not fill this in
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <fieldset class="m-0 border-0 p-0">
    {/*
      The legend carries the counter and the required-field note on one line.
      A legend is not a reliable flex container across engines, so the row is a
      span inside it rather than the legend itself.
    */}
    <legend class="w-full p-0">
      <span class="flex w-full flex-wrap items-center justify-between gap-x-6 gap-y-2">
        <span class="label flex items-center gap-3 text-teal">
          <span class="text-brass" aria-hidden="true">01</span>
          <span class="h-px w-8 bg-brass/40" aria-hidden="true"></span>
          Your Details
        </span>
        <span class="label text-charcoal/35">
          Fields marked <span class="text-brass" aria-hidden="true">*</span> are required
        </span>
      </span>
    </legend>

    <div class="mt-9 grid gap-x-10 gap-y-7 sm:grid-cols-2">
      <div>
        <label class={labelClass} for="name">
          Full Name <span class="text-brass" aria-hidden="true">*</span>
        </label>
        <input
          class={inputClass}
          id="name"
          name="name"
          type="text"
          autocomplete="name"
          placeholder="Your name"
          required
        />
        <p class={errorClass} data-error-for="name" role="alert"></p>
      </div>

      <div>
        <label class={labelClass} for="phone">
          Phone <span class="text-brass" aria-hidden="true">*</span>
        </label>
        <input
          class={inputClass}
          id="phone"
          name="phone"
          type="tel"
          inputmode="tel"
          autocomplete="tel"
          placeholder="+91 98765 43210"
          required
        />
        <p class={errorClass} data-error-for="phone" role="alert"></p>
      </div>

      <div>
        <label class={labelClass} for="email">
          Email <span class="text-brass" aria-hidden="true">*</span>
        </label>
        <input
          class={inputClass}
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="you@example.com"
          required
        />
        <p class={errorClass} data-error-for="email" role="alert"></p>
      </div>

      <div>
        <label class={labelClass} for="location">
          Project Location <span class="text-brass" aria-hidden="true">*</span>
        </label>
        <input
          class={inputClass}
          id="location"
          name="location"
          type="text"
          placeholder="City or area"
          required
        />
        <p class={errorClass} data-error-for="location" role="alert"></p>
      </div>

      <div>
        <label class={labelClass} for="projectType">
          Project Type <span class="text-brass" aria-hidden="true">*</span>
        </label>
        <div class="relative mt-1">
          <select class={selectClass} id="projectType" name="projectType" required>
            <option value="">Please select</option>
            {projectTypes.map((type) => <option value={type}>{type}</option>)}
          </select>
          <span
            class="pointer-events-none absolute inset-y-0 right-0 flex items-center text-teal/45"
            aria-hidden="true"
          >
            <svg width="11" height="7" viewBox="0 0 11 7" fill="none" aria-hidden="true">
              <path
                d="M1 1L5.5 5.5L10 1"
                stroke="currentColor"
                stroke-width="1"
                stroke-linecap="square"></path>
            </svg>
          </span>
        </div>
        <p class={errorClass} data-error-for="projectType" role="alert"></p>
      </div>

      <div>
        {/*
          "Estimated Project Investment", never "Budget". The bands themselves
          communicate the level the studio operates at.
        */}
        <label class={labelClass} for="investment">
          Estimated Project Investment <span class="text-brass" aria-hidden="true">*</span>
        </label>
        <div class="relative mt-1">
          <select class={selectClass} id="investment" name="investment" required>
            <option value="">Please select</option>
            {investmentBands.map((band) => <option value={band}>{band}</option>)}
          </select>
          <span
            class="pointer-events-none absolute inset-y-0 right-0 flex items-center text-teal/45"
            aria-hidden="true"
          >
            <svg width="11" height="7" viewBox="0 0 11 7" fill="none" aria-hidden="true">
              <path
                d="M1 1L5.5 5.5L10 1"
                stroke="currentColor"
                stroke-width="1"
                stroke-linecap="square"></path>
            </svg>
          </span>
        </div>
        <p class={errorClass} data-error-for="investment" role="alert"></p>
      </div>

      <div class="sm:col-span-2">
        <label class={labelClass} for="requirements">
          Tell Us About Your Project
          <span class="ml-3 text-teal/35">Optional</span>
        </label>
        <textarea
          class="mt-2 w-full resize-y rounded-zen border border-beige bg-ivory/60 px-4 py-3.5 text-small text-charcoal transition-colors duration-300 placeholder:text-charcoal/30 hover:border-charcoal/30 focus:border-teal focus:outline-none focus:ring-0 aria-[invalid=true]:border-brass"
          id="requirements"
          name="requirements"
          rows="4"
          placeholder="Share your thoughts, requirements, timeline or any reference ideas."
          data-char-input></textarea>

        <div class="mt-2 flex items-baseline justify-between gap-4">
          <p class={errorClass} data-error-for="requirements" role="alert"></p>
          {/*
            A live count, not a limit. The field is never truncated in the
            browser; validation still owns what is acceptable.
          */}
          <p class="ml-auto text-micro text-charcoal/35" data-char-count aria-hidden="true">
            0 / 2000
          </p>
        </div>
      </div>
    </div>
  </fieldset>

  <div class="mt-[--stack-md] border-t border-beige pt-8">
    <div class="flex flex-col gap-7 sm:flex-row sm:items-center sm:gap-9">
      <button
        type="submit"
        data-enquiry-submit
        class="group label inline-flex shrink-0 items-center justify-center gap-3 rounded-zen bg-teal px-9 py-4 text-ivory transition-colors duration-300 hover:bg-teal-deep disabled:pointer-events-none disabled:opacity-50"
      >
        <span data-submit-label>Send Enquiry</span>
        <span
          class="inline-block transition-transform duration-[--duration-base] ease-[--ease-zen] group-hover:translate-x-1"
          aria-hidden="true">&#8594;</span
        >
      </button>

      <span class="hidden w-px self-stretch bg-beige sm:block" aria-hidden="true"></span>

      {/*
        The quieter way in, kept beside the action rather than below it. Some
        visitors will never fill in a form, and sending them off to hunt for a
        number is how that enquiry is lost.
      */}
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-4 text-left"
      >
        <span
          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-beige text-teal transition-colors duration-300 group-hover:border-brass group-hover:text-brass"
          aria-hidden="true"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.1"
          >
            <path d="M4 20l1.25-3.9A7.7 7.7 0 1 1 8 18.75L4 20Z" stroke-linejoin="round" />
            <path
              d="M9.3 8.6c.15-.35.31-.36.5-.37h.43c.14 0 .33 0 .5.36l.62 1.4c.08.16.06.34-.03.48l-.35.44c-.11.14-.22.28-.06.53a5.7 5.7 0 0 0 2.5 2.2c.24.11.38.09.53-.05l.5-.55c.14-.16.3-.18.48-.11l1.36.64c.19.09.3.22.3.42 0 .27-.1.78-.4 1.06-.3.29-.87.5-1.5.42a8.4 8.4 0 0 1-5.6-4.3c-.4-.7-.4-1.6-.18-2.17Z"
              fill="currentColor"
              stroke="none"
            />
          </svg>
        </span>
        <span>
          <span class="block text-small text-charcoal/60">Prefer to chat?</span>
          <span
            class="mt-0.5 flex items-center gap-2 font-display text-display-sm text-teal transition-colors duration-300 group-hover:text-brass"
          >
            Message us on WhatsApp
            <span
              class="inline-block text-small transition-transform duration-[--duration-base] ease-[--ease-zen] group-hover:translate-x-1"
              aria-hidden="true">&#8594;</span
            >
          </span>
        </span>
      </a>
    </div>

    <p class="mt-8 flex items-center gap-3 text-micro text-charcoal/50">
      <svg
        class="h-4 w-4 shrink-0 text-brass"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.1"
        aria-hidden="true"
      >
        <rect x="3.25" y="7" width="9.5" height="6.25" rx="1" />
        <path d="M5.6 7V5.1a2.4 2.4 0 0 1 4.8 0V7" />
      </svg>
      Your information is kept private and confidential.
    </p>

    <p
      class="mt-6 hidden border-l border-brass pl-4 text-micro text-brass"
      data-form-error
      role="alert"
    >
    </p>
  </div>
</form>

{/* Success state. Replaces the form once the enquiry has been handed over. */}
<div data-enquiry-success hidden class="border-t border-brass/40 pt-10">
  <p class="label text-brass">Enquiry Received</p>
  <h3 class="mt-6 font-display text-display-md text-teal">Thank you. We have it.</h3>
  <p class="lede mt-6 max-w-[46ch] text-charcoal/72">
    WhatsApp should have opened with your enquiry ready to send. If it did not, use the
    link below and we will pick it up from there.
  </p>

  <a
    href="#"
    data-enquiry-fallback
    target="_blank"
    rel="noopener noreferrer"
    class="group label mt-8 inline-flex items-center gap-3 border-b border-beige py-1 text-teal transition-colors duration-300 hover:border-brass hover:text-brass"
  >
    Open WhatsApp
    <span
      class="inline-block transition-transform duration-[--duration-base] ease-[--ease-zen] group-hover:translate-x-1"
      aria-hidden="true">&#8594;</span
    >
  </a>

  <p class="mt-10 border-t border-beige pt-6 text-micro text-charcoal/55">
    We will follow up personally on the details you sent. Nothing you shared goes any
    further than the studio.
  </p>
</div>

<script>
  import { createEnquiry, validateEnquiry, isValid } from '@lib/enquiry';
  import type { EnquiryField } from '@lib/enquiry';
  import { buildWhatsAppUrl, openWhatsApp } from '@lib/whatsapp';

  const form = document.querySelector<HTMLFormElement>('[data-enquiry-form]');
  const success = document.querySelector<HTMLElement>('[data-enquiry-success]');
  const fallback = document.querySelector<HTMLAnchorElement>('[data-enquiry-fallback]');
  const formError = document.querySelector<HTMLElement>('[data-form-error]');

  if (form) {
    const showErrors = (errors: Partial<Record<EnquiryField, string>>) => {
      form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((node) => {
        const field = node.dataset.errorFor as EnquiryField;
        const message = errors[field];
        node.textContent = message ?? '';
        node.classList.toggle('hidden', !message);

        const input = form.elements.namedItem(field);
        if (input instanceof HTMLElement) {
          input.setAttribute('aria-invalid', message ? 'true' : 'false');
        }
      });
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      const data = new FormData(form);

      // Honeypot: a filled hidden field means a bot. Fail silently.
      if ((data.get('bot-field') as string)?.length) return;

      const enquiry = createEnquiry({
        name: String(data.get('name') ?? ''),
        phone: String(data.get('phone') ?? ''),
        email: String(data.get('email') ?? ''),
        location: String(data.get('location') ?? ''),
        projectType: String(data.get('projectType') ?? '') as never,
        investment: String(data.get('investment') ?? '') as never,
        requirements: String(data.get('requirements') ?? ''),
        source: 'website',
      });

      const errors = validateEnquiry(enquiry);
      showErrors(errors);

      if (!isValid(errors)) {
        const firstField = Object.keys(errors)[0];
        const input = firstField ? form.elements.namedItem(firstField) : null;
        if (input instanceof HTMLElement) input.focus();
        return;
      }

      const whatsappUrl = buildWhatsAppUrl(enquiry);

      // Step 1 — still inside the user gesture. Nothing may be awaited above.
      openWhatsApp(whatsappUrl);

      // Step 2 — capture the lead regardless of whether the visitor sends it.
      data.set('createdAt', enquiry.createdAt);
      fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
      }).catch(() => {
        // Netlify Forms is unavailable in local dev, and a failure here must
        // never block the visitor. The WhatsApp handover already happened.
      });

      if (fallback) fallback.href = whatsappUrl;
      if (formError) formError.classList.add('hidden');

      form.hidden = true;
      if (success) {
        success.hidden = false;
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });

    // Clear a field's error as soon as the visitor starts fixing it.
    form.addEventListener('input', (event) => {
      const target = event.target as HTMLElement;
      const name = target.getAttribute('name');
      if (!name) return;
      const node = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (node && !node.classList.contains('hidden')) {
        node.classList.add('hidden');
        target.setAttribute('aria-invalid', 'false');
      }
    });
  }
</script>

<script>
  /*
    Character count for the note field. Presentation only, deliberately kept
    out of the submit path: it never blocks, truncates or validates anything.
  */
  const note = document.querySelector<HTMLTextAreaElement>('[data-char-input]');
  const counter = document.querySelector<HTMLElement>('[data-char-count]');

  if (note && counter) {
    const render = () => {
      counter.textContent = `${note.value.length} / 2000`;
      counter.classList.toggle('text-brass', note.value.length > 2000);
    };

    note.addEventListener('input', render);
    render();
  }
</script>
