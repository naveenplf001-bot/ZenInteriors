---
import Logo from './Logo.astro';
import MobileMenu from './MobileMenu.astro';
import { primaryNav, primaryAction, isActive } from '@data/navigation';

interface Props {
  /**
   * overlay — sits transparently over a full-bleed hero, then turns solid on scroll.
   * solid   — ivory ground from the first pixel, for pages without a hero image.
   */
  variant?: 'overlay' | 'solid';
}

const { variant = 'solid' } = Astro.props;
const pathname = Astro.url.pathname;

const shell =
  'fixed inset-x-0 top-0 z-[50] h-[--header-h] transition-[background-color,color,border-color] duration-500 ease-[--ease-zen]';

const skins = {
  overlay:
    'text-ivory border-b border-transparent data-[scrolled=true]:bg-ivory/92 data-[scrolled=true]:text-teal data-[scrolled=true]:border-beige/70 data-[scrolled=true]:backdrop-blur-md',
  solid: 'bg-ivory text-teal border-b border-beige/70',
} as const;
---

<header data-header data-scrolled="false" class:list={[shell, skins[variant]]}>
  <div class="container-zen flex h-full items-center justify-between gap-8">
    <a href="/" class="shrink-0" aria-label="Zen Interior, home">
      <Logo />
    </a>

    <nav class="hidden lg:block" aria-label="Primary">
      <ul class="flex items-center gap-10">
        {
          primaryNav.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href, pathname) ? 'page' : undefined}
                class="label relative py-2 transition-opacity duration-300 hover:opacity-60 aria-[current=page]:opacity-100"
              >
                {link.label}
                <span
                  class:list={[
                    'absolute -bottom-0.5 left-0 h-px w-full origin-left scale-x-0 bg-current transition-transform duration-500 ease-[--ease-zen]',
                    isActive(link.href, pathname) && 'scale-x-100',
                  ]}
                  aria-hidden="true"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-5">
      <a
        href={primaryAction.href}
        class="label hidden shrink-0 rounded-zen border border-current px-6 py-3 transition-colors duration-300 hover:bg-current lg:inline-block"
      >
        <span class="mix-blend-normal transition-colors duration-300">
          {primaryAction.label}
        </span>
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="label flex items-center gap-3 py-3 lg:hidden"
      >
        <span>Menu</span>
        <span class="flex flex-col gap-[5px]" aria-hidden="true">
          <span class="block h-px w-6 bg-current"></span>
          <span class="block h-px w-6 bg-current"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<MobileMenu />

<script>
  import { initHeader } from '@/scripts/header';
  initHeader();
</script>
