---
import Logo from './Logo.astro';
import MobileMenu from './MobileMenu.astro';
import { primaryNav, primaryAction, isActive } from '@data/navigation';

interface Props {
  /**
   * overlay — sits transparently over a full-bleed hero, then settles onto a
   *           deep teal ground on scroll. Type stays ivory throughout, so the
   *           reversed lockup is correct in both states and only one logo
   *           file is ever downloaded.
   * solid   — ivory ground from the first pixel, for pages without a hero.
   */
  variant?: 'overlay' | 'solid';
}

const { variant = 'solid' } = Astro.props;
const pathname = Astro.url.pathname;

const isOverlay = variant === 'overlay';

const shell =
  'fixed inset-x-0 top-0 z-[50] h-[--header-h] transition-[background-color,border-color,backdrop-filter] duration-500 ease-[--ease-zen]';

const skins = {
  overlay:
    'text-ivory border-b border-transparent data-[scrolled=true]:bg-teal/95 data-[scrolled=true]:border-ivory/12 data-[scrolled=true]:backdrop-blur-md',
  solid: 'bg-ivory text-teal border-b border-beige/70',
} as const;

const ctaSkin = isOverlay
  ? 'border-ivory/40 text-ivory hover:bg-ivory hover:text-teal'
  : 'border-teal/25 text-teal hover:bg-teal hover:text-ivory';
---

<header data-header data-scrolled="false" class:list={[shell, skins[variant]]}>
  <div class="container-zen flex h-full items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label="Zen Interior, home">
      <Logo tone={isOverlay ? 'dark' : 'light'} eager />
    </a>

    <nav class="hidden lg:block" aria-label="Primary">
      <ul class="flex items-center gap-9">
        {
          primaryNav.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href, pathname) ? 'page' : undefined}
                class="label relative py-2 opacity-75 transition-opacity duration-300 hover:opacity-100 aria-[current=page]:opacity-100"
              >
                {link.label}
                <span
                  class:list={[
                    'absolute -bottom-0.5 left-0 h-px w-full origin-left scale-x-0 bg-current transition-transform duration-500 ease-[--ease-zen]',
                    isActive(link.href, pathname) && 'scale-x-100',
                  ]}
                  aria-hidden="true"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-7">
      <a
        href={primaryAction.href}
        class:list={[
          'label hidden shrink-0 rounded-zen border px-6 py-3 transition-colors duration-300 lg:inline-block',
          ctaSkin,
        ]}
      >
        {primaryAction.label}
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="label flex items-center gap-3 py-3 lg:hidden"
      >
        <span>Menu</span>
        <span class="flex flex-col gap-[5px]" aria-hidden="true">
          <span class="block h-px w-6 bg-current"></span>
          <span class="block h-px w-6 bg-current"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<MobileMenu />

<script>
  import { initHeader } from '@/scripts/header';
  initHeader();
</script>
