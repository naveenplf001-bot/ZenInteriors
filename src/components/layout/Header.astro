---
import Logo from './Logo.astro';
import MobileMenu from './MobileMenu.astro';
import { primaryNav, primaryAction, isActive } from '@data/navigation';

interface Props {
  /**
   * The header is the same ivory bar with the standard lockup on every page,
   * so the logo never changes as a visitor moves around the site.
   *
   * overlay — a full-bleed hero runs up underneath the bar. Those heroes
   *           already pad their content by --header-h, so nothing is hidden.
   * solid   — pages without a hero; the layout pads <main> instead.
   */
  variant?: 'overlay' | 'solid';
}

const pathname = Astro.url.pathname;

const shell =
  'fixed inset-x-0 top-0 z-[50] h-(--header-h) bg-ivory text-teal border-b border-beige/70';
---

<header data-header data-scrolled="false" class={shell}>
  <div class="container-zen flex h-full items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label="Zen Interior, home">
      <Logo tone="light" eager />
    </a>

    <nav class="hidden lg:block" aria-label="Primary">
      <ul class="flex items-center gap-9">
        {
          primaryNav.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href, pathname) ? 'page' : undefined}
                class="label relative py-2 opacity-75 transition-opacity duration-300 hover:opacity-100 aria-[current=page]:opacity-100"
              >
                {link.label}
                <span
                  class:list={[
                    'absolute -bottom-0.5 left-0 h-px w-full origin-left scale-x-0 bg-current transition-transform duration-500 ease-(--ease-zen)',
                    isActive(link.href, pathname) && 'scale-x-100',
                  ]}
                  aria-hidden="true"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-7">
      <a
        href={primaryAction.href}
        class="label hidden shrink-0 rounded-zen border border-teal/25 px-6 py-3 text-teal transition-colors duration-300 hover:bg-teal hover:text-ivory lg:inline-block"
      >
        {primaryAction.label}
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="label flex items-center gap-3 py-3 lg:hidden"
      >
        <span>Menu</span>
        <span class="flex flex-col gap-[5px]" aria-hidden="true">
          <span class="block h-px w-6 bg-current"></span>
          <span class="block h-px w-6 bg-current"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<MobileMenu />

<script>
  import { initHeader } from '@/scripts/header';
  initHeader();
</script>
