---
import Logo from './Logo.astro';
import { footerNav } from '@data/navigation';
import { site } from '@config/site';
import { buildDirectWhatsAppUrl } from '@lib/whatsapp';

const year = new Date().getFullYear();
const whatsappHref = buildDirectWhatsAppUrl();
---

<footer class="bg-teal text-ivory on-dark">
  <div class="container-zen py-[--section-y-tight]">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5">
        <Logo tone="dark" />
        <p class="lede mt-8 max-w-[34ch] text-ivory/70">
          {site.tagline}
        </p>
      </div>

      {
        footerNav.map((group) => (
          <nav class="lg:col-span-2" aria-label={group.heading}>
            <p class="label mb-6 text-brass-soft">{group.heading}</p>
            <ul class="flex flex-col gap-3.5">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-small text-ivory/72 transition-colors duration-300 hover:text-ivory"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="lg:col-span-3">
        <p class="label mb-6 text-brass-soft">Enquiries</p>
        <ul class="flex flex-col gap-3.5">
          <li>
            <a
              href={site.contact.phoneHref}
              class="text-small text-ivory/72 transition-colors duration-300 hover:text-ivory"
            >
              {site.contact.phone}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${site.contact.email}`}
              class="text-small text-ivory/72 transition-colors duration-300 hover:text-ivory"
            >
              {site.contact.email}
            </a>
          </li>
          <li>
            <a
              href={whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              class="text-small text-ivory/72 transition-colors duration-300 hover:text-ivory"
            >
              WhatsApp
            </a>
          </li>
        </ul>
      </div>
    </div>

    <hr class="rule-inverse mt-16 mb-8" />

    <div
      class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="label text-ivory/45">
        {site.regions.map((region) => region.name).join(' · ')}
      </p>
      <p class="label text-ivory/45">
        &#169; {year} {site.name}
      </p>
    </div>
  </div>
</footer>
