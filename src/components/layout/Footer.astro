---
import Logo from './Logo.astro';
import { footerNav } from '@data/navigation';
import { site } from '@config/site';
import { buildDirectWhatsAppUrl } from '@lib/whatsapp';

/**
 * The footer is the last thing a prospect reads, so it carries the positioning
 * rather than just a sitemap: the lockup and the studio line on the left, then
 * three ruled columns, then the only place on the site that asks for an email
 * without asking for a brief.
 *
 * The tagline is split on its own full stops rather than hard-coded, so
 * `site.tagline` stays the single source of the studio line.
 *
 * The Follow column is data-driven and disappears entirely when no channel is
 * live. An empty column is better than a dead link to an account that does not
 * exist, or worse, to someone else's.
 */

const year = new Date().getFullYear();
const whatsappHref = buildDirectWhatsAppUrl();

const taglineLines = site.tagline
  .split(/(?<=\.)\s+/)
  .map((line) => line.trim())
  .filter(Boolean);

const regionLine = site.regions.map((region) => region.name).join(' · ');

const connectLinks = [
  { label: site.contact.phone, href: site.contact.phoneHref, external: false },
  { label: 'Email the studio', href: `mailto:${site.contact.email}`, external: false },
  { label: 'WhatsApp', href: whatsappHref, external: true },
  ...site.social.map((channel) => ({ ...channel, external: true })),
];

/* Shared column chrome. The hairline is the rule between columns in the
   reference, so it only exists once the columns actually sit side by side. */
const columnClass =
  'lg:border-l lg:border-ivory/12 lg:pl-[clamp(1.5rem,2.4vw,2.75rem)]';
const linkClass =
  'text-small text-ivory/70 transition-colors duration-300 hover:text-ivory focus-visible:text-ivory';
---

<footer class="relative isolate overflow-hidden bg-teal text-ivory on-dark">
  {/* Tonal depth. Two soft washes rather than a photograph, so the footer
      never competes with the project imagery directly above it. */}
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0"
      style="background:
        radial-gradient(125% 95% at 8% 105%, color-mix(in srgb, var(--color-ivory) 8%, transparent) 0%, transparent 58%),
        radial-gradient(85% 75% at 88% -10%, color-mix(in srgb, var(--color-brass) 10%, transparent) 0%, transparent 62%);"
    >
    </div>
  </div>

  <div class="container-zen pt-[clamp(3.5rem,6vw,6rem)] pb-9">
    <div
      class="grid gap-x-[clamp(1.5rem,2.4vw,2.75rem)] gap-y-12 sm:grid-cols-2 lg:grid-cols-[1.4fr_0.85fr_1fr_0.8fr_1.3fr] lg:gap-y-0"
    >
      {/* ------------------------------------------------------- the studio */}
      <div class="sm:col-span-2 lg:col-span-1 lg:pr-[clamp(1rem,2vw,2.5rem)]">
        <Logo tone="dark" />

        <p
          class="mt-8 font-display text-[clamp(1.5rem,1.1rem+1.4vw,2.125rem)] leading-[1.28] tracking-[-0.015em] text-ivory"
        >
          {
            taglineLines.map((line, index) => (
              <>
                {index > 0 && <br />}
                {line}
              </>
            ))
          }
        </p>

        <span class="mt-9 block h-px w-14 bg-brass" aria-hidden="true"></span>

        <p class="label mt-7 text-ivory/55">{regionLine}</p>
        <p class="label mt-2.5 text-ivory/40">Serving spaces across South India</p>
      </div>

      {/* ------------------------------------------------- explore and work */}
      {
        footerNav.map((group) => (
          <nav class={columnClass} aria-label={group.heading}>
            <p class="label text-brass-soft">{group.heading}</p>
            <ul class="mt-7 flex flex-col gap-3.5">
              {group.links.map((link) => (
                <li>
                  <a href={link.href} class={linkClass}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      {/* ----------------------------------------------------------- direct */}
      <div class={columnClass}>
        <p class="label text-brass-soft">Connect</p>
        <ul class="mt-7 flex flex-col gap-3.5">
          {
            connectLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class={linkClass}
                  {...link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* -------------------------------------------------------- the list */}
      <div class:list={[columnClass, 'sm:col-span-2 lg:col-span-1']}>
        <p class="label text-brass-soft">Stay Inspired</p>

        <p class="mt-7 max-w-[32ch] text-small text-ivory/70">
          Ideas, materials and stories from the studio. No campaigns, only work
          worth showing.
        </p>

        {/*
          Netlify picks the form up from the built HTML. Submission is posted
          with fetch rather than a navigation so the visitor is never thrown
          off the page they were reading.
        */}
        <form
          name="newsletter"
          method="POST"
          data-netlify="true"
          netlify-honeypot="newsletter-bot"
          data-newsletter
          class="mt-6 max-w-[30rem]"
        >
          <input type="hidden" name="form-name" value="newsletter" />
          <p class="visually-hidden" aria-hidden="true">
            <label>
              Leave this field empty
              <input name="newsletter-bot" tabindex="-1" autocomplete="off" />
            </label>
          </p>

          <div
            class="flex overflow-hidden rounded-zen border border-ivory/15 bg-ivory transition-colors duration-300 focus-within:border-brass"
          >
            <label class="visually-hidden" for="newsletter-email">Your email address</label>
            <input
              id="newsletter-email"
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="Your email address"
              class="min-w-0 flex-1 bg-transparent px-5 py-3.5 text-small text-charcoal placeholder:text-charcoal/45 focus:outline-none"
            />
            <button
              type="submit"
              class="flex w-14 shrink-0 items-center justify-center border-l border-beige bg-stone text-teal transition-colors duration-300 hover:bg-brass hover:text-ivory focus-visible:outline-offset-[-2px]"
              aria-label="Subscribe to studio updates"
            >
              <svg
                width="20"
                height="14"
                viewBox="0 0 20 14"
                fill="none"
                aria-hidden="true"
                class="transition-transform duration-300 ease-(--ease-zen)"
                data-newsletter-arrow
              >
                <path
                  d="M0 7h18M12.5 1.5 18.5 7l-6 5.5"
                  stroke="currentColor"
                  stroke-width="1.25"
                  stroke-linecap="square"></path>
              </svg>
            </button>
          </div>

          <label class="mt-4 flex cursor-pointer items-start gap-3">
            <input
              type="checkbox"
              name="consent"
              required
              class="mt-0.5 size-4 shrink-0 accent-(--color-brass)"
            />
            <span class="text-micro text-ivory/55">I agree to receive studio updates.</span>
          </label>

          <p
            data-newsletter-status
            role="status"
            aria-live="polite"
            class="mt-3 text-micro text-brass-soft empty:mt-0"
          >
          </p>
        </form>
      </div>
    </div>

    {/* ------------------------------------------------------------- legal */}
    <hr class="rule-inverse mt-[clamp(3rem,5vw,4.5rem)]" />

    <div
      class="flex flex-col gap-4 pt-7 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-micro text-ivory/45">
        &#169; {year} {site.name}. All rights reserved.
      </p>
      <div class="flex items-center gap-6">
        <span class="hidden h-px w-20 bg-ivory/20 sm:block" aria-hidden="true"></span>
        <p class="label text-ivory/45">Interiors for a more considered tomorrow</p>
      </div>
    </div>
  </div>
</footer>

<script>
  /**
   * Newsletter submit.
   *
   * Posted to the site root as urlencoded, which is how Netlify Forms accepts
   * a static form. The field stays on screen and reports its own outcome; a
   * failure never silently swallows the address.
   */
  const form = document.querySelector<HTMLFormElement>('[data-newsletter]');
  const status = form?.querySelector<HTMLElement>('[data-newsletter-status]');

  if (form && status) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      status.textContent = 'Sending…';

      try {
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>),
        });
        if (!response.ok) throw new Error(String(response.status));

        form.reset();
        status.textContent = 'Thank you. You are on the list.';
      } catch {
        status.textContent =
          'That did not go through. Please email the studio and we will add you.';
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
</script>
