---
/**
 * Zen Interior wordmark.
 *
 * A horizontal lockup: an ornate torana arch containing a yali figure, set
 * beside a lowercase high-contrast serif "zen" over letter-spaced serif small
 * caps "INTERIOR".
 *
 * Assets are generated by `node tools/brand-assets.mjs` from the artwork in
 * `brand-source/`. The reversed variant is a true two-tone inversion, not a
 * silhouette, so the yali inside the arch survives on dark grounds.
 *
 * The heritage motif is the brand's strongest asset. Do not flatten it into
 * generic minimalism, do not recolour it beyond the two supplied variants, and
 * do not redraw it. The contrast between a traditional mark and a contemporary
 * editorial interface is the whole idea.
 */

interface Props {
  /** dark renders the reversed lockup for teal, black and photographic grounds. */
  tone?: 'light' | 'dark';
  /** full is the complete lockup, mark is the arch and yali alone. */
  variant?: 'full' | 'mark';
  class?: string;
  /** Only the header logo above the fold should load eagerly. */
  eager?: boolean;
}

const {
  tone = 'light',
  variant = 'full',
  class: className = '',
  eager = false,
} = Astro.props;

const sources = {
  full: {
    light: '/brand/zen-interior.png',
    dark: '/brand/zen-interior-reversed.png',
  },
  mark: {
    light: '/brand/zen-mark.png',
    dark: '/brand/zen-mark.png',
  },
} as const;

// Intrinsic ratios of the generated files, declared so the header reserves
// space before the image decodes and nothing shifts on load.
const dimensions = variant === 'full' ? { w: 480, h: 209 } : { w: 256, h: 256 };
---

<img
  src={sources[variant][tone]}
  alt="Zen Interior"
  width={dimensions.w}
  height={dimensions.h}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  decoding="async"
  class:list={[
    'w-auto',
    variant === 'full' ? 'h-10 lg:h-12' : 'h-10',
    className,
  ]}
/>
