---
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Reveal from '@components/ui/Reveal.astro';
import SplitHeading from '@components/ui/SplitHeading.astro';
import { methodStages } from '@data/methodology';

/**
 * The Zen method.
 *
 * High-value clients are not buying interiors. They are buying certainty.
 * A named, sequenced process is what communicates that a studio is not
 * improvising on site.
 *
 * A sticky scroll sequence: the statement holds still on the left while the
 * five stages move past it. What changes on the left is a single enormous
 * numeral and a stage index, not a photograph. A swapping image panel here
 * read as a generic product-page pattern; the type is the brand, and at this
 * size it carries the section on its own.
 *
 * The section numeral is deliberately omitted. Two numbering systems in one
 * column compete, and the stage counter is the more useful of the two.
 *
 * position: sticky plus one observer. No animation library.
 */
---

<section class="bg-teal text-ivory on-dark">
  <Container class="section">
    <div class="lg:grid lg:grid-cols-12 lg:items-start lg:gap-x-16">
      <div
        class="lg:sticky lg:top-[calc(var(--header-h)+clamp(1.5rem,5vh,4rem))] lg:col-span-5"
        data-reveal-group
      >
        <Reveal variant="fade">
          <Eyebrow index="06" tone="inverse">The Zen Method</Eyebrow>
        </Reveal>

        <SplitHeading lines={['Certainty,', 'in five stages.']} tone="dark" class="mt-7" />

        {/*
          The stage numeral, at a size that makes it a graphic rather than a
          label. Stacked and crossfaded so the column never reflows as the
          number changes underneath the heading.
        */}
        <div
          class="relative mt-[--stack-lg] hidden h-[clamp(5rem,10vw,8.5rem)] lg:block"
          aria-hidden="true"
        >
          {
            methodStages.map((stage, index) => (
              <span
                data-method-numeral={index}
                class="absolute inset-0 flex items-center font-display text-[clamp(5rem,10vw,8.5rem)] leading-none tracking-[-0.045em] text-brass-soft opacity-0 transition-all duration-700 ease-[--ease-zen] data-[active]:translate-y-0 data-[active]:opacity-100"
                style="transform: translateY(0.18em)"
              >
                {stage.index}
              </span>
            ))
          }
        </div>

        {/*
          The stage index. Reads as a chapter list, and it is the one place
          the whole process is visible at once.
        */}
        <ul class="mt-9 hidden lg:block">
          {
            methodStages.map((stage, index) => (
              <li data-method-name={index} class="group flex items-center gap-5 py-2">
                <span class="h-px w-4 shrink-0 bg-ivory/25 transition-all duration-700 ease-[--ease-zen] group-data-[active]:w-12 group-data-[active]:bg-brass" />
                <span class="font-display text-display-sm text-ivory/30 transition-colors duration-700 ease-[--ease-zen] group-data-[active]:text-ivory">
                  {stage.title}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <ol class="mt-12 lg:col-span-6 lg:col-start-7 lg:mt-0">
        {
          methodStages.map((stage, index) => (
            <li
              data-method-stage={index}
              class="border-t border-ivory/12 py-10 lg:flex lg:min-h-[54vh] lg:items-center lg:py-0"
            >
              <Reveal class="w-full">
                {/* Narrow screens have no sticky column, so the row carries
                    its own numeral. */}
                <span
                  class="block font-display text-[clamp(3rem,12vw,4.5rem)] leading-none tracking-[-0.035em] text-brass-soft/25 lg:hidden"
                  aria-hidden="true"
                >
                  {stage.index}
                </span>
                <h3 class="mt-4 font-display text-display-md text-ivory lg:mt-0">
                  {stage.title}
                </h3>
                <p class="mt-4 max-w-[46ch] text-small text-ivory/60">{stage.description}</p>
              </Reveal>
            </li>
          ))
        }
      </ol>
    </div>
  </Container>
</section>

<script>
  /**
   * Drives the numeral and the stage index as each stage passes the middle of
   * the viewport. A narrow band rather than a threshold, so the active stage
   * is unambiguous and never two at once.
   */
  const stages = Array.from(document.querySelectorAll<HTMLElement>('[data-method-stage]'));
  const numerals = Array.from(document.querySelectorAll<HTMLElement>('[data-method-numeral]'));
  const names = Array.from(document.querySelectorAll<HTMLElement>('[data-method-name]'));

  if (stages.length > 0 && 'IntersectionObserver' in window) {
    const mark = (nodes: HTMLElement[], active: number) => {
      nodes.forEach((node, i) => {
        if (i === active) node.setAttribute('data-active', '');
        else node.removeAttribute('data-active');
      });
    };

    const setActive = (active: number) => {
      mark(numerals, active);
      mark(names, active);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          setActive(Number((entry.target as HTMLElement).dataset.methodStage ?? 0));
        }
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );

    stages.forEach((stage) => observer.observe(stage));
    setActive(0);
  }
</script>

<style>
  /* The inline transform is the resting state; the active state lifts it. */
  [data-method-numeral][data-active] {
    transform: translateY(0) !important;
  }
</style>
