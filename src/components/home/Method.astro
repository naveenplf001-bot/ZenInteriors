---
import { Image } from 'astro:assets';
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Reveal from '@components/ui/Reveal.astro';
import SplitHeading from '@components/ui/SplitHeading.astro';
import SectionNumber from '@components/ui/SectionNumber.astro';
import { methodStages } from '@data/methodology';
import { pad } from '@lib/format';

import discover from '@/assets/images/projects/the-emerald-residence/01-threshold.jpg';
import design from '@/assets/images/projects/the-quiet-villa/01-living-volume.jpg';
import source from '@/assets/images/home/sourcing.jpg';
import craft from '@/assets/images/projects/the-slate-apartment/02-kitchen-detail.jpg';
import deliver from '@/assets/images/projects/the-quiet-villa/02-lounge.jpg';

/**
 * The Zen method.
 *
 * High-value clients are not buying interiors. They are buying certainty.
 * A named, sequenced process is what communicates that a studio is not
 * improvising on site.
 *
 * Built as a sticky scroll sequence: the statement holds still on the left
 * while the five stages move past it, and the photograph beside it changes
 * to match whichever stage is on screen. Without that image the section was
 * five paragraphs on a flat green field, which is a lot of colour asking the
 * reader to do all the work.
 *
 * position: sticky plus one observer. No animation library.
 */

const stageImages = [
  { src: discover, alt: 'Timber archway framing a dining and tea area beyond' },
  { src: design, alt: 'Open living and dining volume under layered architectural lighting' },
  { src: source, alt: 'Entrance joinery with concealed storage below a floating console' },
  { src: craft, alt: 'Kitchen detail showing the handleless drawer line and undercabinet lighting' },
  { src: deliver, alt: 'Double-height lounge with a floating stone stair and brass ring pendant' },
];

const total = methodStages.length;
---

<section class="bg-teal text-ivory on-dark">
  <Container class="section">
    <div class="lg:grid lg:grid-cols-12 lg:items-start lg:gap-x-16">
      <div
        class="lg:sticky lg:top-[calc(var(--header-h)+clamp(1.5rem,4vh,3.5rem))] lg:col-span-5"
        data-reveal-group
      >
        <Reveal variant="fade">
          <SectionNumber value="06" tone="dark" />
        </Reveal>

        <Reveal variant="fade" class="mt-4">
          <Eyebrow tone="inverse">The Zen Method</Eyebrow>
        </Reveal>

        <SplitHeading lines={['Certainty,', 'in five stages.']} tone="dark" class="mt-6" />

        {/*
          The photograph tracks the stage on screen. Stacked and crossfaded
          rather than swapped, so nothing reflows and every frame is already
          decoded before it is needed.
        */}
        <Reveal variant="clip" class="mt-[--stack-md] hidden lg:block">
          <div class="relative aspect-[4/3] overflow-hidden rounded-zen bg-teal-deep">
            {
              stageImages.map((frame, index) => (
                <Image
                  src={frame.src}
                  alt={frame.alt}
                  widths={[480, 800, 1100]}
                  sizes="40vw"
                  loading="lazy"
                  data-method-frame={index}
                  class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-[900ms] ease-[--ease-zen] data-[active]:opacity-100"
                />
              ))
            }

            <span
              class="label absolute bottom-4 left-4 rounded-zen bg-ink/45 px-3 py-2 text-ivory backdrop-blur-sm"
              aria-hidden="true"
            >
              <span data-method-current>01</span> / {pad(total)}
            </span>
          </div>
        </Reveal>

        {/* Chapter marker rather than a scrollbar. */}
        <div class="mt-8 hidden items-center gap-4 lg:flex" aria-hidden="true">
          <div class="flex flex-1 gap-1.5" data-method-track>
            {
              methodStages.map(() => (
                <span class="block h-px flex-1 bg-ivory/20 transition-colors duration-500 ease-[--ease-zen]" />
              ))
            }
          </div>
          <span class="label shrink-0 text-brass-soft" data-method-label>Discover</span>
        </div>
      </div>

      <ol class="mt-12 lg:col-span-6 lg:col-start-7 lg:mt-0">
        {
          methodStages.map((stage, index) => (
            <li
              data-method-stage={index}
              class="border-t border-ivory/12 py-10 lg:flex lg:min-h-[52vh] lg:items-center lg:py-0"
            >
              <Reveal class="w-full">
                <span
                  class="block font-display text-[clamp(3rem,5.4vw,5rem)] leading-none tracking-[-0.035em] text-brass-soft/20"
                  aria-hidden="true"
                >
                  {stage.index}
                </span>
                <h3 class="mt-4 font-display text-display-md text-ivory">{stage.title}</h3>
                <p class="mt-4 max-w-[44ch] text-small text-ivory/60">{stage.description}</p>

                {/* Narrow screens have no sticky panel, so the row shows its own frame. */}
                <div class="mt-7 aspect-[16/10] overflow-hidden rounded-zen bg-teal-deep lg:hidden">
                  <Image
                    src={stageImages[index]!.src}
                    alt={stageImages[index]!.alt}
                    widths={[480, 800, 1100]}
                    sizes="92vw"
                    loading="lazy"
                    class="h-full w-full object-cover"
                  />
                </div>
              </Reveal>
            </li>
          ))
        }
      </ol>
    </div>
  </Container>
</section>

<script>
  /**
   * Lights the progress marks, swaps the photograph and names the stage as
   * each one passes the middle of the viewport. A narrow band rather than a
   * threshold, so the active stage is unambiguous and never two at once.
   */
  const stages = Array.from(document.querySelectorAll<HTMLElement>('[data-method-stage]'));
  const track = document.querySelector<HTMLElement>('[data-method-track]');
  const frames = Array.from(document.querySelectorAll<HTMLElement>('[data-method-frame]'));
  const current = document.querySelector<HTMLElement>('[data-method-current]');
  const label = document.querySelector<HTMLElement>('[data-method-label]');

  if (stages.length > 0 && 'IntersectionObserver' in window) {
    const marks = track ? (Array.from(track.children) as HTMLElement[]) : [];
    const names = stages.map((stage) => stage.querySelector('h3')?.textContent?.trim() ?? '');

    const setActive = (active: number) => {
      marks.forEach((mark, i) => {
        mark.classList.toggle('bg-brass', i <= active);
        mark.classList.toggle('bg-ivory/20', i > active);
      });

      frames.forEach((frame, i) => {
        if (i === active) frame.setAttribute('data-active', '');
        else frame.removeAttribute('data-active');
      });

      if (current) current.textContent = String(active + 1).padStart(2, '0');
      if (label) label.textContent = names[active] ?? '';
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          setActive(Number((entry.target as HTMLElement).dataset.methodStage ?? 0));
        }
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );

    stages.forEach((stage) => observer.observe(stage));
    setActive(0);
  }
</script>
