---
import { Image } from 'astro:assets';
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Reveal from '@components/ui/Reveal.astro';
import SplitHeading from '@components/ui/SplitHeading.astro';
import SectionNumber from '@components/ui/SectionNumber.astro';
import sourcingImage from '@/assets/images/home/sourcing.jpg';

/**
 * The global sourcing story.
 *
 * This section must never read as an import business. "We import products from
 * China" describes a trading company. Access, judgement and accountability
 * describe a design studio that happens to source globally.
 */

const pillars = [
  {
    title: 'Access',
    body: 'Established relationships with manufacturing partners across Asia and Europe, giving projects surfaces and architectural products rarely available locally.',
  },
  {
    title: 'Judgement',
    body: 'Materials are selected against the drawing that will use them, in person, before anything is committed. A specification is not a selection.',
  },
  {
    title: 'Accountability',
    body: 'One studio holds the design, the sourcing and the site. Nothing is resolved by three parties who never meet.',
  },
];
---

<section class="bg-stone">
  <Container class="section">
    <div class="grid items-start gap-y-12 lg:grid-cols-12 lg:gap-x-16">
      <div class="lg:col-span-5" data-reveal-group>
        <Reveal variant="fade">
          <SectionNumber value="03" />
        </Reveal>

        <Reveal variant="fade" class="mt-4">
          <Eyebrow>Global Sourcing</Eyebrow>
        </Reveal>

        <SplitHeading lines={['Global materials.', 'Local mastery.']} class="mt-6" />

        <Reveal>
          <p class="lede mt-(--stack-md) max-w-[46ch] text-charcoal/82">
            We source distinctive materials, architectural elements and interior products
            from global manufacturing partners, bringing international design possibilities
            together with meticulous execution in India.
          </p>
        </Reveal>

        <dl class="mt-(--stack-lg) grid gap-x-10 sm:grid-cols-3 lg:grid-cols-1">
          {
            pillars.map((pillar) => (
              <Reveal>
                <div class="group relative border-t border-beige pt-5 pb-5 lg:pb-6">
                  <span
                    class="pointer-events-none absolute inset-x-0 -top-px block h-px origin-left scale-x-0 bg-brass transition-transform duration-700 ease-(--ease-zen) group-hover:scale-x-100"
                    aria-hidden="true"
                  />
                  <dt class="label text-teal">{pillar.title}</dt>
                  <dd class="mt-3 max-w-[44ch] text-micro text-charcoal/75">{pillar.body}</dd>
                </div>
              </Reveal>
            ))
          }
        </dl>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <Reveal variant="clip">
          <div class="aspect-[4/3] overflow-hidden rounded-zen bg-beige sm:aspect-[16/10] lg:aspect-[4/5]">
            <Image
              src={sourcingImage}
              alt="Entrance joinery with concealed storage below a floating walnut console"
              widths={[640, 1024, 1400, 1800]}
              sizes="(min-width: 1024px) 46vw, 92vw"
              loading="lazy"
              class="zen-parallax h-full w-full object-cover"
            />
          </div>
        </Reveal>
      </div>
    </div>
  </Container>
</section>
