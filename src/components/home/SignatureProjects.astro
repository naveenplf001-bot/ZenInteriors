---
import { Image } from 'astro:assets';
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Reveal from '@components/ui/Reveal.astro';
import Button from '@components/ui/Button.astro';
import SectionNumber from '@components/ui/SectionNumber.astro';
import { counter, pad } from '@lib/format';
import type { Project } from '@lib/content';

interface Props {
  /** The whole portfolio. The index lists all of it. */
  projects: Project[];
}

const { projects } = Astro.props;
const total = projects.length;

/*
  The lead is the first project flagged as featured, falling back to the first
  in manual order. Passing only the featured subset in was the earlier mistake:
  it silently shortened the portfolio index to whatever happened to be flagged.
*/
const lead = projects.find((project) => project.data.featured) ?? projects[0];
const leadPosition = lead ? projects.indexOf(lead) + 1 : 1;

/**
 * The lead project runs full width, then hands over to an interactive index.
 *
 * Hovering or focusing a row in the index swaps the preview beside it. That
 * pattern earns its place here for a reason the card grid could not: it puts
 * one large photograph on screen at all times while still letting someone
 * move through the whole portfolio, so the section stays photographic rather
 * than becoming a list.
 *
 * The preview is a fixed panel, not something that follows the cursor. A
 * cursor-tracking image is a different thing entirely and it fails on touch,
 * on keyboard, and for anyone who finds motion under the pointer unpleasant.
 */

const facts = lead
  ? [
      { label: 'Location', value: lead.data.location },
      { label: 'Typology', value: lead.data.category },
      { label: 'Year', value: String(lead.data.year) },
      { label: 'Scope', value: lead.data.scope },
    ]
  : [];
---

<section class="bg-ivory">
  <Container class="pt-[--section-y]">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal-group>
      <div>
        <Reveal variant="fade">
          <SectionNumber value="02" />
        </Reveal>
        <Reveal variant="fade" class="mt-4">
          <Eyebrow>Signature Projects</Eyebrow>
        </Reveal>
      </div>
      <Reveal variant="fade">
        <Button href="/projects" variant="link">All Projects</Button>
      </Reveal>
    </div>
  </Container>

  {
    lead && (
      <>
        <Reveal variant="clip" class="mt-[--stack-lg] block">
          <a href={`/projects/${lead.id}`} class="group block focus-visible:outline-offset-4">
            <div class="aspect-[4/5] w-full overflow-hidden bg-stone sm:aspect-[16/9] lg:aspect-[21/9]">
              <Image
                src={lead.data.cover}
                alt={lead.data.coverAlt}
                widths={[768, 1280, 1600, 1920]}
                sizes="100vw"
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-[1600ms] ease-[--ease-zen] group-hover:scale-[1.03]"
              />
            </div>
          </a>
        </Reveal>

        {/*
          A real two-column meta block. The previous version pushed a small
          counter to the far right with justify-between, which left a wide
          void doing nothing.
        */}
        <Container class="mt-9">
          <div class="grid gap-y-9 lg:grid-cols-12 lg:gap-x-16">
            <div class="lg:col-span-6" data-reveal-group>
              <Reveal variant="fade">
                <p class="label text-teal/55">
                  {counter(leadPosition, total)} &nbsp;·&nbsp; Featured
                </p>
              </Reveal>
              <Reveal>
                <h3 class="mt-4 font-display text-[clamp(1.875rem,1.1rem+3.1vw,3.75rem)] leading-[1.04] tracking-[-0.022em] font-light text-teal">
                  <a
                    href={`/projects/${lead.id}`}
                    class="transition-colors duration-500 hover:text-brass"
                  >
                    {lead.data.title}
                  </a>
                </h3>
              </Reveal>
              <Reveal>
                <p class="lede mt-5 max-w-[46ch] text-charcoal/70">{lead.data.summary}</p>
              </Reveal>
              <Reveal variant="fade" class="mt-8">
                <Button href={`/projects/${lead.id}`} variant="outline">View Project</Button>
              </Reveal>
            </div>

            <dl
              class="grid grid-cols-2 gap-x-8 gap-y-7 self-end lg:col-span-5 lg:col-start-8"
              data-reveal-group="70"
            >
              {facts.map((fact) => (
                <Reveal>
                  <div class="border-t border-beige pt-4">
                    <dt class="label text-teal/45">{fact.label}</dt>
                    <dd class="mt-2.5 font-display text-display-sm text-teal">{fact.value}</dd>
                  </div>
                </Reveal>
              ))}
            </dl>
          </div>
        </Container>
      </>
    )
  }

  {/* ---------------------------------------------------------------- index */}
  <Container class="pt-[--section-y-tight] pb-[--section-y]">
    <Reveal variant="fade">
      <Eyebrow>The Portfolio</Eyebrow>
    </Reveal>

    <div class="mt-9 grid lg:grid-cols-12 lg:gap-x-16" data-project-index>
      <div class="lg:col-span-7">
        {
          projects.map((project, index) => (
            <a
              href={`/projects/${project.id}`}
              data-index-row={index}
              class="group block border-t border-beige py-7 transition-colors duration-500 last:border-b hover:border-brass focus-visible:outline-offset-4 lg:py-9"
            >
              <div class="flex items-baseline gap-5 sm:gap-8">
                <span class="label shrink-0 text-teal/30 transition-colors duration-500 group-hover:text-brass">
                  {pad(index + 1)}
                </span>

                <div class="min-w-0 flex-1">
                  <h3 class="font-display text-display-md text-teal transition-colors duration-500 group-hover:text-brass">
                    {project.data.title}
                  </h3>
                  <p class="label mt-3 text-teal/50">
                    {project.data.location} &nbsp;/&nbsp; {project.data.category}
                  </p>
                </div>

                <span
                  class="label hidden shrink-0 self-center text-teal opacity-0 transition-all duration-500 ease-[--ease-zen] group-hover:translate-x-1 group-hover:opacity-100 lg:inline-block"
                  aria-hidden="true"
                >
                  View &#8594;
                </span>
              </div>

              {/* On narrow screens the row carries its own image, since the
                  preview panel beside it is not there to do the job. */}
              <div class="mt-6 aspect-[16/10] overflow-hidden rounded-zen bg-stone lg:hidden">
                <Image
                  src={project.data.cover}
                  alt={project.data.coverAlt}
                  widths={[480, 800, 1200]}
                  sizes="92vw"
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              </div>
            </a>
          ))
        }
      </div>

      <div class="hidden lg:col-span-5 lg:block">
        <div class="relative aspect-[4/5] overflow-hidden rounded-zen bg-stone">
          {
            projects.map((project, index) => (
              <Image
                src={project.data.cover}
                alt=""
                widths={[480, 800, 1200]}
                sizes="40vw"
                loading="lazy"
                data-index-preview={index}
                class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700 ease-[--ease-zen] data-[active]:opacity-100"
              />
            ))
          }
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  /**
   * Swaps the preview beside the project index.
   *
   * Pointer and focus both drive it, so the interaction is not hover-only.
   * The panel itself is hidden below the large breakpoint, where each row
   * carries its own image instead, so there is nothing to wire up on mobile.
   */
  const index = document.querySelector<HTMLElement>('[data-project-index]');

  if (index) {
    const rows = Array.from(index.querySelectorAll<HTMLElement>('[data-index-row]'));
    const previews = Array.from(index.querySelectorAll<HTMLElement>('[data-index-preview]'));

    if (rows.length > 0 && previews.length > 0) {
      const show = (active: number) => {
        previews.forEach((preview, i) => {
          if (i === active) preview.setAttribute('data-active', '');
          else preview.removeAttribute('data-active');
        });
      };

      rows.forEach((row, i) => {
        row.addEventListener('pointerenter', () => show(i));
        row.addEventListener('focus', () => show(i));
      });

      // The first project stays up until something else is chosen, so the
      // panel is never empty.
      show(0);
    }
  }
</script>
