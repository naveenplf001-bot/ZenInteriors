---
import { Image } from 'astro:assets';
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Reveal from '@components/ui/Reveal.astro';
import Button from '@components/ui/Button.astro';
import ProjectCard from '@components/projects/ProjectCard.astro';
import { counter } from '@lib/format';
import type { Project } from '@lib/content';

interface Props {
  projects: Project[];
  total: number;
}

const { projects, total } = Astro.props;
const [lead, ...rest] = projects;
---

<section class="bg-ivory">
  <Container class="pt-[--section-y] pb-[--section-y]">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal-group>
      <Reveal variant="fade">
        <Eyebrow index="02">Signature Projects</Eyebrow>
      </Reveal>
      <Reveal variant="fade">
        <Button href="/projects" variant="link">All Projects</Button>
      </Reveal>
    </div>

    {
      lead && (
        <>
          {/*
            The lead project runs the full width of the container. An
            architecture studio shows one project properly before it shows
            six in a grid.
          */}
          <Reveal variant="clip" class="mt-[--stack-lg] block">
            <a href={`/projects/${lead.id}`} class="group block focus-visible:outline-offset-8">
              <div class="aspect-[4/5] overflow-hidden rounded-zen bg-stone sm:aspect-[16/9] lg:aspect-[21/9]">
                <Image
                  src={lead.data.cover}
                  alt={lead.data.coverAlt}
                  widths={[768, 1280, 1600, 1920]}
                  sizes="(min-width: 1440px) 1360px, 92vw"
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-[1400ms] ease-[--ease-zen] group-hover:scale-[1.03]"
                />
              </div>

              <div class="mt-6 flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
                <div>
                  <p class="label text-teal/55">
                    {lead.data.location} &nbsp;/&nbsp; {lead.data.category}
                  </p>
                  <h3 class="mt-3 font-display text-display-md text-teal transition-colors duration-300 group-hover:text-brass">
                    {lead.data.title}
                  </h3>
                  <p class="mt-3 max-w-[58ch] text-small text-charcoal/65">
                    {lead.data.summary}
                  </p>
                </div>
                <p class="label text-teal/30" aria-hidden="true">
                  {counter(1, total)}
                </p>
              </div>
            </a>
          </Reveal>

          {rest.length > 0 && (
            <div class="mt-[--section-y-tight] grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:gap-x-14">
              {rest.map((project, index) => (
                /*
                  Offset composition rather than a uniform row, so the second
                  and third projects do not read as a catalogue. The offset is
                  dropped below the two-column breakpoint, where it would only
                  create a stray gap.
                */
                <div class:list={[index % 2 === 1 && 'sm:mt-16 lg:mt-24']}>
                  <ProjectCard project={project} index={index + 2} delay={index * 90} />
                </div>
              ))}
            </div>
          )}
        </>
      )
    }
  </Container>
</section>
