---
import { Image } from 'astro:assets';
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Reveal from '@components/ui/Reveal.astro';
import Button from '@components/ui/Button.astro';
import SectionNumber from '@components/ui/SectionNumber.astro';
import ProjectCard from '@components/projects/ProjectCard.astro';
import { counter } from '@lib/format';
import type { Project } from '@lib/content';

interface Props {
  projects: Project[];
  total: number;
}

const { projects, total } = Astro.props;
const [lead, ...rest] = projects;
---

<section class="bg-ivory">
  <Container class="pt-[--section-y]">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal-group>
      <div>
        <Reveal variant="fade">
          <SectionNumber value="02" />
        </Reveal>
        <Reveal variant="fade" class="mt-4">
          <Eyebrow>Signature Projects</Eyebrow>
        </Reveal>
      </div>
      <Reveal variant="fade">
        <Button href="/projects" variant="link">All Projects</Button>
      </Reveal>
    </div>
  </Container>

  {
    lead && (
      <>
        {/*
          The lead project breaks the container and runs the full width of the
          viewport. Photography is the product here, so once per page it gets
          to own the screen instead of sitting inside a grid column.
        */}
        <Reveal variant="clip" class="mt-[--stack-lg] block">
          <a href={`/projects/${lead.id}`} class="group block focus-visible:outline-offset-4">
            <div class="aspect-[4/5] w-full overflow-hidden bg-stone sm:aspect-[16/9] lg:aspect-[21/9]">
              <Image
                src={lead.data.cover}
                alt={lead.data.coverAlt}
                widths={[768, 1280, 1600, 1920]}
                sizes="100vw"
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-[1600ms] ease-[--ease-zen] group-hover:scale-[1.03]"
              />
            </div>

            <Container class="mt-7">
              <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-5">
                <div>
                  <p class="label text-teal/55">
                    {lead.data.location} &nbsp;/&nbsp; {lead.data.category}
                  </p>
                  {/*
                    One of only three things on this page allowed to be large.
                    Scale contrast is what creates hierarchy; inflating
                    everything just restores the flatness it was meant to fix.
                  */}
                  <h3 class="mt-3 font-display text-[clamp(1.875rem,1.1rem+3.1vw,3.75rem)] leading-[1.04] tracking-[-0.022em] font-light text-teal transition-colors duration-500 group-hover:text-brass">
                    {lead.data.title}
                  </h3>
                  <p class="mt-4 max-w-[52ch] text-small text-charcoal/65">
                    {lead.data.summary}
                  </p>
                  <span class="label mt-6 inline-flex items-center gap-2.5 text-teal transition-colors duration-300 group-hover:text-brass">
                    View Project
                    <span
                      class="inline-block transition-transform duration-500 ease-[--ease-zen] group-hover:translate-x-1"
                      aria-hidden="true"
                    >
                      &#8594;
                    </span>
                  </span>
                </div>
                <p class="label text-teal/25" aria-hidden="true">
                  {counter(1, total)}
                </p>
              </div>
            </Container>
          </a>
        </Reveal>

        {rest.length > 0 && (
          <Container class="pb-[--section-y]">
            <div class="mt-[--section-y-tight] grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:gap-x-14">
              {rest.map((project, index) => (
                /*
                  Offset composition rather than a uniform row, so the second
                  and third projects do not read as a catalogue. Dropped below
                  the two-column breakpoint, where it only creates a stray gap.
                */
                <div class:list={[index % 2 === 1 && 'sm:mt-16 lg:mt-24']}>
                  <ProjectCard project={project} index={index + 2} delay={index * 90} />
                </div>
              ))}
            </div>
          </Container>
        )}
      </>
    )
  }
</section>
