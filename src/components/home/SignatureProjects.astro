---
import { Image } from 'astro:assets';
import { pad } from '@lib/format';
import type { Project } from '@lib/content';

interface Props {
  /** The whole portfolio. Every project becomes a slide. */
  projects: Project[];
}

const { projects } = Astro.props;
const total = projects.length;

/**
 * The featured project band.
 *
 * A full-bleed editorial slide rather than a section inside the container:
 * a dark photo rail on the left, the project written out in the middle over a
 * watermark numeral, the photograph large in the centre-right, and a rail on
 * the far right carrying detail thumbnails and the slide index.
 *
 * All slides are rendered into the same grid cell and crossfaded. Stacking
 * them costs a little markup for three projects and buys two things worth
 * more than that: the band never changes height as you move through it, and
 * every photograph is already decoded before it is needed.
 *
 * The two rails are desktop only. Below that width they would compress into
 * unreadable slivers, so the band reflows into a single column instead.
 */

const slides = projects.map((project, index) => ({
  index,
  id: project.id,
  data: project.data,
  /** The rail takes a detail frame, falling back to the cover. */
  rail: project.data.gallery[0]?.src ?? project.data.cover,
  railAlt: project.data.gallery[0]?.alt ?? project.data.coverAlt,
  thumbs: project.data.gallery.slice(1, 3),
}));
---

<section
  class="relative overflow-hidden bg-ivory"
  data-featured
  aria-roledescription="carousel"
  aria-label="Featured projects"
>
  <div
    class="lg:grid lg:min-h-[min(86vh,880px)] lg:grid-cols-[13fr_27fr_47fr_10fr] lg:items-stretch"
  >
    {/* ---------------------------------------------------------- left rail */}
    <div class="relative hidden overflow-hidden bg-ink lg:block">
      {
        slides.map((slide) => (
          <Image
            src={slide.rail}
            alt=""
            widths={[320, 480, 720]}
            sizes="14vw"
            loading="lazy"
            data-featured-rail={slide.index}
            class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-[900ms] ease-(--ease-zen) data-[active]:opacity-100"
          />
        ))
      }
      <div class="absolute inset-0 bg-ink/55" aria-hidden="true"></div>

      <div class="absolute top-[clamp(2rem,5vh,4rem)] left-8">
        {/*
          Stacked one word per line rather than rotated. Rotated type is the
          cliché of this genre and it is genuinely hard to read; stacking gets
          the same vertical rhythm without either problem.
        */}
        <p class="label leading-[2.1] text-ivory/95">
          Spaces<br />That<br />Stay<br />With<br />You
        </p>
        <span class="mt-7 block h-14 w-px bg-ivory/35" aria-hidden="true"></span>
      </div>
    </div>

    {/* ------------------------------------------------------------ content */}
    <div
      class="relative flex flex-col justify-center px-(--gutter) pt-[calc(var(--header-h)+2rem)] pb-12 lg:px-[clamp(2rem,3.4vw,3.5rem)] lg:py-16"
    >
      {/* Watermark numeral, sitting behind the title. */}
      <div class="pointer-events-none absolute inset-y-0 right-0 hidden items-start lg:flex" aria-hidden="true">
        {
          slides.map((slide) => (
            <span
              data-featured-watermark={slide.index}
              class="absolute top-[6%] right-[4%] font-display text-[clamp(9rem,15vw,17rem)] leading-none tracking-[-0.05em] text-teal/[0.055] opacity-0 transition-opacity duration-[900ms] ease-(--ease-zen) data-[active]:opacity-100"
            >
              {pad(slide.index + 1)}
            </span>
          ))
        }
      </div>

      <div class="relative grid">
        {
          slides.map((slide) => (
            <div
              data-featured-panel={slide.index}
              class="col-start-1 row-start-1 opacity-0 transition-opacity duration-[700ms] ease-(--ease-zen) data-[active]:opacity-100"
              aria-hidden="true"
            >
              <p class="label flex flex-wrap items-center gap-x-4 gap-y-2 text-teal/68">
                <span>
                  {pad(slide.index + 1)} / {pad(total)}
                </span>
                <span class="h-px w-6 bg-teal/25" aria-hidden="true" />
                <span>Featured Project</span>
              </p>

              <h3 class="mt-7 font-display text-[clamp(2.25rem,1.1rem+3.6vw,4.25rem)] leading-[1.02] tracking-[-0.025em] font-normal text-teal">
                {slide.data.title}
              </h3>

              <p class="label mt-5 text-teal/72">
                {slide.data.location} &nbsp;/&nbsp; {slide.data.category}
              </p>

              <span class="mt-8 block h-px w-full max-w-[22rem] bg-beige" aria-hidden="true" />

              <p class="mt-7 max-w-[38ch] text-small leading-[1.75] text-charcoal/80">
                {slide.data.summary}
              </p>

              <div class="mt-9 flex flex-col items-start gap-5">
                <a
                  href={`/projects/${slide.id}`}
                  data-featured-link
                  tabindex="-1"
                  class="label group inline-flex items-center gap-4 rounded-zen bg-teal px-8 py-4 text-ivory transition-colors duration-300 hover:bg-teal-deep"
                >
                  View Project
                  <span
                    class="inline-block transition-transform duration-500 ease-(--ease-zen) group-hover:translate-x-1"
                    aria-hidden="true"
                  >
                    &#8594;
                  </span>
                </a>

                <a
                  href="/projects"
                  data-featured-link
                  tabindex="-1"
                  class="label border-b border-beige py-1 text-teal transition-colors duration-300 hover:border-brass hover:text-brass"
                >
                  Explore All Projects
                </a>
              </div>

              <dl class="mt-[clamp(2.5rem,4vh,3.5rem)] flex flex-wrap gap-x-8 gap-y-6">
                {[
                  { label: 'Year', value: String(slide.data.year) },
                  { label: 'Typology', value: slide.data.category },
                  { label: 'Scope', value: slide.data.scope },
                ].map((fact, i) => (
                  <div class:list={[i > 0 && 'border-l border-beige pl-8', 'max-w-[16ch]']}>
                    <dt class="label text-teal/60">{fact.label}</dt>
                    <dd class="mt-2.5 font-display text-[1.0625rem] leading-snug text-teal">
                      {fact.value}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          ))
        }
      </div>
    </div>

    {/* -------------------------------------------------------------- image */}
    <div class="relative">
      <div class="relative grid aspect-[4/3] w-full overflow-hidden bg-stone lg:aspect-auto lg:h-full">
        {
          slides.map((slide) => (
            <Image
              src={slide.data.cover}
              alt={slide.data.coverAlt}
              widths={[640, 1024, 1400, 1800]}
              sizes="(min-width: 1024px) 47vw, 100vw"
              loading={slide.index === 0 ? 'eager' : 'lazy'}
              data-featured-image={slide.index}
              class="col-start-1 row-start-1 h-full w-full object-cover opacity-0 transition-opacity duration-[900ms] ease-(--ease-zen) data-[active]:opacity-100"
            />
          ))
        }

        {/* Controls, set into the lower right corner of the frame. */}
        <div class="col-start-1 row-start-1 flex items-end justify-end self-end p-0">
          <div class="flex bg-ivory">
            <button
              type="button"
              data-featured-prev
              class="flex h-14 w-14 items-center justify-center text-teal transition-colors duration-300 hover:bg-teal hover:text-ivory lg:h-16 lg:w-16"
              aria-label="Previous project"
            >
              <span aria-hidden="true">&#8592;</span>
            </button>
            <span class="my-4 w-px bg-beige" aria-hidden="true"></span>
            <button
              type="button"
              data-featured-next
              class="flex h-14 w-14 items-center justify-center text-teal transition-colors duration-300 hover:bg-teal hover:text-ivory lg:h-16 lg:w-16"
              aria-label="Next project"
            >
              <span aria-hidden="true">&#8594;</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    {/* --------------------------------------------------------- right rail */}
    <div class="relative hidden flex-col items-center pt-0 pb-12 lg:flex">
      {/* Detail thumbnails, running off the right edge of the screen. */}
      <div class="relative h-[clamp(6rem,11vh,9rem)] w-full">
        {
          slides.map((slide) => (
            <div
              data-featured-thumbs={slide.index}
              class="absolute inset-0 flex gap-3 opacity-0 transition-opacity duration-[900ms] ease-(--ease-zen) data-[active]:opacity-100"
            >
              {slide.thumbs.map((thumb) => (
                <div class="h-full flex-1 overflow-hidden bg-stone">
                  <Image
                    src={thumb.src}
                    alt=""
                    widths={[240, 400, 600]}
                    sizes="10vw"
                    loading="lazy"
                    class="h-full w-full object-cover"
                  />
                </div>
              ))}
            </div>
          ))
        }
      </div>

      <span class="mt-8 block h-[clamp(2rem,6vh,4rem)] w-px bg-beige" aria-hidden="true"></span>

      <p class="label mt-8 text-center leading-[2.1] text-teal/68">
        Details<br />Define<br />Excellence
      </p>

      <span class="mt-8 block h-[clamp(2rem,6vh,4rem)] w-px bg-beige" aria-hidden="true"></span>

      {/* Slide index. Real buttons, so the band is operable from the keyboard. */}
      <div class="mt-auto flex flex-col items-center gap-4 pt-8" role="tablist" aria-label="Choose a project">
        {
          slides.map((slide) => (
            <button
              type="button"
              role="tab"
              data-featured-dot={slide.index}
              aria-selected={slide.index === 0 ? 'true' : 'false'}
              aria-label={`${slide.data.title}, project ${slide.index + 1} of ${total}`}
              class="label px-2 py-1 text-teal/45 transition-colors duration-500 ease-(--ease-zen) hover:text-teal aria-selected:text-teal"
            >
              {pad(slide.index + 1)}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  {/* Index for narrow screens, where the right rail is not rendered. */}
  <div class="flex items-center gap-3 px-(--gutter) pb-12 lg:hidden">
    {
      slides.map((slide) => (
        <button
          type="button"
          data-featured-dot={slide.index}
          aria-label={`${slide.data.title}, project ${slide.index + 1} of ${total}`}
          class="h-px flex-1 bg-beige transition-colors duration-500 aria-[current=true]:bg-brass"
          aria-current={slide.index === 0 ? 'true' : 'false'}
        />
      ))
    }
  </div>

  {/* One live region announces the change rather than each panel shouting. */}
  <p class="visually-hidden" aria-live="polite" data-featured-live></p>
</section>

<script>
  /**
   * Featured project band.
   *
   * Panels are stacked and crossfaded, so only the active one may be reachable:
   * an invisible panel that still takes focus is a keyboard trap in slow motion.
   * `aria-hidden` and `tabindex="-1"` are therefore driven together with the
   * visual state, and a single live region announces the change.
   */
  const root = document.querySelector<HTMLElement>('[data-featured]');

  if (root) {
    const groups = [
      '[data-featured-panel]',
      '[data-featured-image]',
      '[data-featured-rail]',
      '[data-featured-watermark]',
      '[data-featured-thumbs]',
    ].map((selector) => Array.from(root.querySelectorAll<HTMLElement>(selector)));

    const panels = groups[0]!;
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-featured-dot]'));
    const live = root.querySelector<HTMLElement>('[data-featured-live]');
    const total = panels.length;

    if (total > 0) {
      let current = 0;

      const show = (next: number, announce = true) => {
        current = (next + total) % total;

        for (const group of groups) {
          group.forEach((node, i) => {
            if (i === current) node.setAttribute('data-active', '');
            else node.removeAttribute('data-active');
          });
        }

        panels.forEach((panel, i) => {
          const active = i === current;
          panel.setAttribute('aria-hidden', active ? 'false' : 'true');
          panel
            .querySelectorAll<HTMLAnchorElement>('[data-featured-link]')
            .forEach((link) => link.setAttribute('tabindex', active ? '0' : '-1'));
        });

        dots.forEach((dot) => {
          const active = Number(dot.dataset.featuredDot) === current;
          if (dot.hasAttribute('role')) dot.setAttribute('aria-selected', String(active));
          else dot.setAttribute('aria-current', String(active));
        });

        if (announce && live) {
          const title = panels[current]?.querySelector('h3')?.textContent?.trim() ?? '';
          live.textContent = `${title}, project ${current + 1} of ${total}`;
        }
      };

      root
        .querySelector<HTMLButtonElement>('[data-featured-prev]')
        ?.addEventListener('click', () => show(current - 1));
      root
        .querySelector<HTMLButtonElement>('[data-featured-next]')
        ?.addEventListener('click', () => show(current + 1));

      dots.forEach((dot) => {
        dot.addEventListener('click', () => show(Number(dot.dataset.featuredDot ?? 0)));
      });

      // Arrow keys, once something inside the band has focus.
      root.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          show(current + 1);
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          show(current - 1);
        }
      });

      show(0, false);
    }
  }
</script>
