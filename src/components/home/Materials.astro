---
import { Image } from 'astro:assets';
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Reveal from '@components/ui/Reveal.astro';
import { materials } from '@data/methodology';
import materialsImage from '@/assets/images/home/materials.jpg';
---

<section class="bg-ivory">
  <Container class="section">
    <div class="grid gap-14 lg:grid-cols-12 lg:items-center lg:gap-16">
      <div class="lg:col-span-5 lg:order-2">
        <Reveal variant="fade">
          <Eyebrow index="06">Material Story</Eyebrow>
        </Reveal>

        <Reveal delay={80}>
          <h2 class="mt-7 font-display text-display-lg text-teal">
            Chosen for how they age.
          </h2>
        </Reveal>

        <Reveal delay={150}>
          <p class="lede mt-9 text-charcoal/75">
            Every material is selected for how it looks, feels, ages and belongs within
            the larger composition.
          </p>
        </Reveal>

        <ul class="mt-12 flex flex-col">
          {
            materials.map((material, index) => (
              <Reveal as="li" delay={180 + index * 45}>
                <div class="flex items-baseline gap-6 border-t border-beige py-5">
                  <span class="font-display text-display-sm text-teal">
                    {material.name}
                  </span>
                  <span class="text-small text-charcoal/60">{material.note}</span>
                </div>
              </Reveal>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-6 lg:order-1">
        <Reveal variant="clip">
          <div class="aspect-[4/5] overflow-hidden rounded-zen bg-stone">
            <Image
              src={materialsImage}
              alt="Macro detail of honed stone meeting rift-sawn oak and blackened steel"
              widths={[640, 1024, 1400, 1800]}
              sizes="(min-width: 1024px) 48vw, 92vw"
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </div>
        </Reveal>
      </div>
    </div>
  </Container>
</section>
