---
import { Image } from 'astro:assets';
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Reveal from '@components/ui/Reveal.astro';
import { materials } from '@data/methodology';
import materialsImage from '@/assets/images/home/materials.jpg';
---

<section class="bg-ivory">
  <Container class="section">
    <div class="grid items-center gap-y-12 lg:grid-cols-12 lg:gap-x-16">
      <div class="lg:order-2 lg:col-span-5 lg:col-start-8" data-reveal-group>
        <Reveal variant="fade">
          <Eyebrow index="06">Material Story</Eyebrow>
        </Reveal>

        <Reveal>
          <h2 class="mt-6 font-display text-display-lg text-teal">Chosen for how they age.</h2>
        </Reveal>

        <Reveal>
          <p class="lede mt-[--stack-md] max-w-[44ch] text-charcoal/72">
            Every material is selected for how it looks, feels, ages and belongs within the
            larger composition.
          </p>
        </Reveal>

        <ul class="mt-[--stack-lg]">
          {
            materials.map((material) => (
              <Reveal as="li">
                <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1 border-t border-beige py-4">
                  <span class="font-display text-display-sm text-teal">{material.name}</span>
                  <span class="text-micro text-charcoal/55">{material.note}</span>
                </div>
              </Reveal>
            ))
          }
        </ul>
      </div>

      <div class="lg:order-1 lg:col-span-6">
        <Reveal variant="clip">
          <div class="aspect-[4/3] overflow-hidden rounded-zen bg-stone sm:aspect-[16/10] lg:aspect-[4/5]">
            <Image
              src={materialsImage}
              alt="Kitchen elevation in low-sheen grey lacquer with a curved end return"
              widths={[640, 1024, 1400, 1800]}
              sizes="(min-width: 1024px) 46vw, 92vw"
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </div>
        </Reveal>
      </div>
    </div>
  </Container>
</section>
