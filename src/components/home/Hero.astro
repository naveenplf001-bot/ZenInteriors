---
import { getImage } from 'astro:assets';
import Container from '@components/ui/Container.astro';

import heroDesktop from '@/assets/images/home/hero.jpg';
import heroMobile from '@/assets/images/home/hero-mobile.jpg';

/**
 * The hero.
 *
 * Layout follows the supplied reference: eyebrow, a two-line headline with the
 * second line in brass, a short positioning line, a paragraph, the service
 * geography, two actions, and a capability bar pinned to the bottom edge.
 *
 * Art directed with a real <picture> element rather than two images hidden by
 * CSS, because a display:none image is still fetched by most browsers. The
 * mobile crop is a separate 4:5 frame, since a 2.3:1 composition squeezed into
 * a 390px screen loses the room entirely.
 *
 * This is the only asset on the site decoded eagerly. Everything else is lazy.
 */

const widthsDesktop = [1280, 1600, 1920];
const widthsMobile = [640, 828, 1080, 1310];

const [desktopAvif, desktopWebp, desktopJpeg, mobileAvif, mobileWebp, mobileJpeg] =
  await Promise.all([
    getImage({ src: heroDesktop, widths: widthsDesktop, format: 'avif' }),
    getImage({ src: heroDesktop, widths: widthsDesktop, format: 'webp' }),
    getImage({ src: heroDesktop, widths: widthsDesktop, format: 'jpeg' }),
    getImage({ src: heroMobile, widths: widthsMobile, format: 'avif' }),
    getImage({ src: heroMobile, widths: widthsMobile, format: 'webp' }),
    getImage({ src: heroMobile, widths: widthsMobile, format: 'jpeg' }),
  ]);

/**
 * Capability bar.
 *
 * Three claims, stated broadly. This is positioning copy tied to this one
 * section, so it lives here rather than in the content layer.
 */
const capabilities = [
  {
    title: 'Global Sourcing',
    body: 'Curated products from international markets',
  },
  {
    title: 'Turnkey Execution',
    body: 'From concept through to final finishing',
  },
  {
    title: 'Residential and Commercial',
    body: 'Homes, villas, offices and workspaces',
  },
];
---

<section class="relative flex min-h-[100svh] flex-col overflow-hidden bg-ink">
  <picture>
    <source
      media="(min-width: 768px)"
      type="image/avif"
      srcset={desktopAvif.srcSet.attribute}
      sizes="100vw"
    />
    <source
      media="(min-width: 768px)"
      type="image/webp"
      srcset={desktopWebp.srcSet.attribute}
      sizes="100vw"
    />
    <source
      media="(min-width: 768px)"
      type="image/jpeg"
      srcset={desktopJpeg.srcSet.attribute}
      sizes="100vw"
    />
    <source type="image/avif" srcset={mobileAvif.srcSet.attribute} sizes="100vw" />
    <source type="image/webp" srcset={mobileWebp.srcSet.attribute} sizes="100vw" />
    <img
      src={mobileJpeg.src}
      srcset={mobileJpeg.srcSet.attribute}
      sizes="100vw"
      alt=""
      width={heroDesktop.width}
      height={heroDesktop.height}
      fetchpriority="high"
      loading="eager"
      decoding="sync"
      data-hero-image
      class="absolute inset-0 h-full w-full object-cover"
    />
  </picture>

  {/*
    Two scrims rather than one. The photograph is warm and bright on the right,
    so the horizontal pass buys legibility behind the type while leaving the
    sunset intact, and the vertical pass anchors the capability bar.
  */}
  <div
    class="absolute inset-0 bg-gradient-to-r from-ink/88 via-ink/45 to-ink/5"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-ink/45"
    aria-hidden="true"
  >
  </div>

  {/*
    A plain container element rather than the Container component, so the
    short-viewport rules at the bottom of this file can reach it. Astro scopes
    styles per component, and a class passed into a child component is scoped
    to that child, not to this one.
  */}
  <div
    class="hero-content container-zen relative z-[1] flex flex-1 flex-col justify-end pt-[calc(var(--header-h)+2.5rem)] pb-12 lg:pb-14"
  >
    <p class="label flex flex-wrap items-center gap-3 text-brass-soft" data-hero-line style="--line: 0">
      <span>Zen Interior</span>
      <span class="opacity-50" aria-hidden="true">&#183;</span>
      <span>Design &nbsp;|&nbsp; Furnish &nbsp;|&nbsp; Execute</span>
    </p>

    <h1
      class="hero-headline mt-6 font-display text-[clamp(2.375rem,1.3rem+4.2vw,5.5rem)] leading-[1.01] tracking-[-0.022em] font-light"
    >
      <span class="block overflow-hidden">
        <span class="block text-ivory" data-hero-line style="--line: 1">Interiors Crafted</span>
      </span>
      <span class="block overflow-hidden">
        <span class="block text-brass-soft" data-hero-line style="--line: 2">
          Beyond Expectations.
        </span>
      </span>
    </h1>

    <p
      class="mt-7 font-display text-[clamp(1.125rem,1rem+0.55vw,1.5rem)] leading-snug text-ivory/92"
      data-hero-line
      style="--line: 3"
    >
      Global materials. Refined design. Meticulous execution.
    </p>

    <p class="mt-5 max-w-[50ch] text-small text-ivory/75" data-hero-line style="--line: 4">
      We create sophisticated residential and commercial interiors by combining globally
      sourced products, bespoke design, premium furnishings and seamless execution, all
      under one roof.
    </p>

    <p
      class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-micro text-ivory/80"
      data-hero-line
      style="--line: 5"
    >
      <svg
        class="h-4 w-4 shrink-0 text-brass-soft"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.1"
        aria-hidden="true"
      >
        <path d="M8 14.5s5-4.2 5-8a5 5 0 1 0-10 0c0 3.8 5 8 5 8Z" />
        <circle cx="8" cy="6.4" r="1.8" />
      </svg>
      Serving discerning clients across
      <span class="font-medium text-ivory">Tamil Nadu &amp; Bangalore</span>
    </p>

    <div class="mt-9 flex flex-wrap items-center gap-3.5" data-hero-line style="--line: 6">
      <span class="order-last ml-auto hidden items-center gap-3.5 lg:flex" aria-hidden="true">
        <span class="label text-ivory/55">Scroll</span>
        <span class="scroll-cue block h-11 w-px bg-ivory/20"></span>
      </span>
      {/*
        Brass carries the single primary action here. It stays an accent
        everywhere else: hairlines, labels and this one button. Never a
        gradient, never a large field.
      */}
      <a
        href="/projects"
        class="label group inline-flex items-center gap-3 rounded-zen bg-brass px-7 py-3.5 text-ink transition-colors duration-300 hover:bg-brass-soft"
      >
        Explore Our Projects
        <span
          class="inline-block transition-transform duration-500 ease-(--ease-zen) group-hover:translate-x-1"
          aria-hidden="true">&#8594;</span
        >
      </a>
      <a
        href="/contact"
        class="label group inline-flex items-center gap-3 rounded-zen border border-ivory/40 px-7 py-3.5 text-ivory transition-colors duration-300 hover:bg-ivory hover:text-teal"
      >
        Start Your Project
        <span
          class="inline-block transition-transform duration-500 ease-(--ease-zen) group-hover:translate-x-1"
          aria-hidden="true">&#8594;</span
        >
      </a>
    </div>
  </div>

  {/* Capability bar, pinned to the bottom edge of the hero. */}
  <div class="relative z-[1] border-t border-ivory/15 bg-ink/30 backdrop-blur-[3px]">
    <Container>
      <ul class="grid gap-x-10 gap-y-6 py-6 sm:grid-cols-3 lg:py-7">
        {
          capabilities.map((capability, index) => (
            <li
              class="flex items-start gap-4 sm:border-l sm:border-ivory/12 sm:pl-8 sm:first:border-l-0 sm:first:pl-0"
              data-hero-line
              style={`--line: ${7 + index}`}
            >
              <span class="mt-0.5 shrink-0 text-brass-soft" aria-hidden="true">
                {index === 0 && (
                  <svg
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1"
                  >
                    <circle cx="12" cy="12" r="9" />
                    <path d="M3 12h18" />
                    <path d="M12 3c2.6 2.6 2.6 15.4 0 18-2.6-2.6-2.6-15.4 0-18Z" />
                  </svg>
                )}
                {index === 1 && (
                  <svg
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1"
                  >
                    <path d="M5 9h14l-7 11L5 9Z" />
                    <path d="M8 4h8l3 5H5l3-5Z" />
                    <path d="M9 9l3 11 3-11" />
                  </svg>
                )}
                {index === 2 && (
                  <svg
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1"
                  >
                    <path d="M4 10.5 12 4l8 6.5V20H4v-9.5Z" />
                    <path d="M10 20v-5.5h4V20" />
                  </svg>
                )}
              </span>
              <span>
                <span class="label block text-ivory">{capability.title}</span>
                <span class="mt-1.5 block text-micro leading-relaxed text-ivory/68">
                  {capability.body}
                </span>
              </span>
            </li>
          ))
        }
      </ul>
    </Container>
  </div>
</section>

<style>
  /*
    The hero carries the strongest motion on the site. Everything else
    breathes. Two effects only: a very slow scale on the photograph and a
    staggered rise on the type.
  */
  @media (prefers-reduced-motion: no-preference) {
    [data-hero-image] {
      animation: hero-scale 16s var(--ease-zen-out) forwards;
    }

    [data-hero-line] {
      opacity: 0;
      transform: translateY(1.2em);
      animation: hero-line 1100ms var(--ease-zen-out) forwards;
      animation-delay: calc(120ms + var(--line) * 95ms);
    }

    @keyframes hero-scale {
      from {
        transform: scale(1.07);
      }
      to {
        transform: scale(1);
      }
    }

    @keyframes hero-line {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  /*
    Scroll cue. A lit segment travelling down a hairline, not a bouncing
    mouse icon. Runs only where motion is welcome.
  */
  .scroll-cue {
    position: relative;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue::after {
      content: '';
      position: absolute;
      inset-inline: 0;
      top: 0;
      height: 45%;
      background: var(--color-brass-soft);
      animation: scroll-cue 2.4s var(--ease-zen) infinite;
    }

    @keyframes scroll-cue {
      0% {
        transform: translateY(-110%);
      }
      65%,
      100% {
        transform: translateY(240%);
      }
    }
  }

  /*
    Short laptop screens. Without this the capability bar is pushed below the
    fold on a 1366x768 display, which is the most common business laptop.
  */
  @media (min-width: 1024px) and (max-height: 840px) {
    .hero-content {
      padding-top: calc(var(--header-h) + 1.25rem);
      padding-bottom: 2.5rem;
    }

    .hero-headline {
      font-size: clamp(2rem, 0.6rem + 3vw, 4rem);
    }
  }
</style>
