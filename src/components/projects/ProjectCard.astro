---
import { Image } from 'astro:assets';
import Reveal from '@components/ui/Reveal.astro';
import type { Project } from '@lib/content';
import { pad } from '@lib/format';

interface Props {
  project: Project;
  index?: number;
  /** portrait for the grid, wide for editorial rows. */
  ratio?: 'portrait' | 'wide';
  delay?: number;
  /** Only the first card above the fold should load eagerly. */
  priority?: boolean;
}

const { project, index, ratio = 'portrait', delay, priority = false } = Astro.props;
const { title, summary, location, category, cover, coverAlt } = project.data;

const href = `/projects/${project.id}`;
const aspect = ratio === 'portrait' ? 'aspect-[4/5]' : 'aspect-[16/10]';
const sizes =
  ratio === 'portrait'
    ? '(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw'
    : '(min-width: 1024px) 60vw, 92vw';
---

<Reveal as="article" delay={delay} class="group">
  <a href={href} class="block focus-visible:outline-offset-8">
    <div class:list={['relative overflow-hidden rounded-zen bg-stone', aspect]}>
      <Image
        src={cover}
        alt={coverAlt}
        widths={[480, 800, 1200, 1600]}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        class="h-full w-full object-cover transition-transform duration-[1200ms] ease-(--ease-zen) group-hover:scale-[1.04]"
      />
    </div>

    {/* Hairline that draws across on hover, so the card responds without moving. */}
    <span
      class="mt-5 block h-px w-full origin-left scale-x-100 bg-beige transition-colors duration-500 ease-(--ease-zen) group-hover:bg-brass"
      aria-hidden="true"></span>

    <div class="mt-4 flex items-start justify-between gap-5">
      <div>
        <p class="label text-teal/50">
          {location} &nbsp;/&nbsp; {category}
        </p>
        <h3
          class="mt-2.5 font-display text-display-sm text-teal transition-colors duration-300 group-hover:text-brass"
        >
          {title}
        </h3>
        <p class="mt-2.5 max-w-[44ch] text-micro text-charcoal/65">
          {summary}
        </p>
        <span
          class="label mt-5 inline-flex items-center gap-2.5 text-teal transition-colors duration-300 group-hover:text-brass"
        >
          View Project
          <span
            class="inline-block transition-transform duration-500 ease-(--ease-zen) group-hover:translate-x-1"
            aria-hidden="true">&#8594;</span
          >
        </span>
      </div>

      {
        typeof index === 'number' && (
          <span class="label shrink-0 pt-0.5 text-teal/25" aria-hidden="true">
            {pad(index)}
          </span>
        )
      }
    </div>
  </a>
</Reveal>
