---
import { Image } from 'astro:assets';
import Reveal from '@components/ui/Reveal.astro';
import type { Project } from '@lib/content';
import { pad } from '@lib/format';

interface Props {
  project: Project;
  index?: number;
  /** portrait for the grid, wide for editorial rows. */
  ratio?: 'portrait' | 'wide';
  delay?: number;
  /** Only the first card above the fold should load eagerly. */
  priority?: boolean;
  /** Projects index only: image settle, scroll drift, cursor label and a drawn hairline. */
  enhance?: boolean;
}

const {
  project,
  index,
  ratio = 'portrait',
  delay,
  priority = false,
  enhance = false,
} = Astro.props;
const { title, summary, location, category, cover, coverAlt } = project.data;

const href = `/projects/${project.id}`;
const aspect = ratio === 'portrait' ? 'aspect-[4/5]' : 'aspect-[16/10]';
const sizes =
  ratio === 'portrait'
    ? '(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw'
    : '(min-width: 1024px) 60vw, 92vw';
---

<Reveal as="article" delay={delay} class="group">
  <a href={href} class="block focus-visible:outline-offset-8">
    <div
      class:list={['relative overflow-hidden rounded-zen bg-stone', aspect]}
      data-project-frame={enhance ? '' : undefined}
    >
      {
        enhance ? (
          <div class="zen-project-media h-full w-full">
            <div class="h-full w-full transition-transform duration-[1200ms] ease-(--ease-zen) group-hover:scale-[1.04]">
              <Image
                src={cover}
                alt={coverAlt}
                widths={[480, 800, 1200, 1600]}
                sizes={sizes}
                loading={priority ? 'eager' : 'lazy'}
                fetchpriority={priority ? 'high' : 'auto'}
                class="zen-parallax h-full w-full object-cover"
              />
            </div>
          </div>
        ) : (
          <Image
            src={cover}
            alt={coverAlt}
            widths={[480, 800, 1200, 1600]}
            sizes={sizes}
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : 'auto'}
            class="h-full w-full object-cover transition-transform duration-[1200ms] ease-(--ease-zen) group-hover:scale-[1.04]"
          />
        )
      }
      {
        enhance && (
          <span class="zen-project-cursor label" aria-hidden="true">
            View
          </span>
        )
      }
    </div>

    {/* Hairline that draws across on hover, so the card responds without moving. */}
    <span
      class="relative mt-5 block h-px w-full origin-left scale-x-100 bg-beige transition-colors duration-500 ease-(--ease-zen) group-hover:bg-brass"
      aria-hidden="true"
    >
      {enhance && <span class="zen-project-rule absolute inset-0 origin-left bg-brass" />}
    </span>

    <div class="mt-4 flex items-start justify-between gap-5">
      <div>
        <p class="label text-teal/65">
          {location} &nbsp;/&nbsp; {category}
        </p>
        <h3
          class="mt-2.5 font-display text-display-sm text-teal transition-colors duration-300 group-hover:text-brass"
        >
          {title}
        </h3>
        <p class="mt-2.5 max-w-[44ch] text-micro text-charcoal/75">
          {summary}
        </p>
        <span
          class="label mt-5 inline-flex items-center gap-2.5 text-teal transition-colors duration-300 group-hover:text-brass"
        >
          View Project
          <span
            class="inline-block transition-transform duration-500 ease-(--ease-zen) group-hover:translate-x-1"
            aria-hidden="true">&#8594;</span
          >
        </span>
      </div>

      {
        typeof index === 'number' && (
          <span class="label shrink-0 pt-0.5 text-teal/45" aria-hidden="true">
            {pad(index)}
          </span>
        )
      }
    </div>
  </a>
</Reveal>

<style>
  /* The photograph settles back from a slight over-scale as the card arrives. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) [data-project-frame] .zen-project-media {
      scale: 1.1;
      transition: scale 1700ms var(--ease-zen-out);
    }

    :global(html.js .is-revealed) [data-project-frame] .zen-project-media {
      scale: 1;
    }

    /* The hairline draws in beneath the photograph as the card arrives. */
    :global(html.js) .zen-project-rule {
      transform: scaleX(0);
      transition: transform 1300ms var(--ease-zen-out) 350ms;
    }

    :global(html.js .is-revealed) .zen-project-rule {
      transform: scaleX(1);
    }
  }

  /* Brass only while the card is hovered; beige again at rest. */
  .zen-project-rule {
    opacity: 0.55;
    transition: opacity 500ms var(--ease-zen);
  }

  @media (hover: hover) {
    :global(.group:hover) .zen-project-rule {
      opacity: 1;
    }
  }

  .zen-project-cursor {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .zen-project-cursor {
      position: absolute;
      top: 0;
      left: 0;
      z-index: 1;
      display: flex;
      width: 6rem;
      height: 6rem;
      margin: -3rem 0 0 -3rem;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
      background: color-mix(in srgb, var(--color-ivory) 88%, transparent);
      color: var(--color-teal);
      backdrop-filter: blur(6px);
      pointer-events: none;
      opacity: 0;
      scale: 0.5;
      translate: var(--mx, 50%) var(--my, 50%);
      transition:
        opacity 400ms var(--ease-zen),
        scale 500ms var(--ease-zen),
        translate 220ms var(--ease-zen-out);
    }

    [data-project-frame]:hover .zen-project-cursor {
      opacity: 1;
      scale: 1;
    }
  }
</style>

<script>
  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-project-frame]').forEach((frame) => {
      frame.addEventListener('pointermove', (event) => {
        const rect = frame.getBoundingClientRect();
        frame.style.setProperty('--mx', `${event.clientX - rect.left}px`);
        frame.style.setProperty('--my', `${event.clientY - rect.top}px`);
      });
    });
  }
</script>
