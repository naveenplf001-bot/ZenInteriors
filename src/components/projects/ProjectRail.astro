---
import { Image } from 'astro:assets';

import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Reveal from '@components/ui/Reveal.astro';
import SectionNumber from '@components/ui/SectionNumber.astro';
import type { Project } from '@lib/content';
import { pad } from '@lib/format';

/**
 * More projects.
 *
 * The rest of the portfolio, run horizontally: the section number and the
 * portfolio figures on the left, the projects through the middle, the controls
 * held on the right so the row reads as one line rather than as a block with a
 * toolbar under it.
 *
 * The project currently in the hero is withheld — this section is what you are
 * not already looking at, which is the only reason it earns its place above
 * the index. The hero announces its slide on a document event and the strip
 * follows; the withheld card is chosen on the server too, so the first paint
 * is already correct.
 *
 * Native scrolling with scroll-snap does the work. The script only adds arrow
 * state, a position marker and pointer dragging on top, so with JavaScript
 * disabled the strip still scrolls with a trackpad, a touchscreen and the
 * keyboard.
 */

interface Props {
  projects: Project[];
  /** The project the hero opens on. Withheld from the strip. */
  activeId?: string;
  /** Portfolio figures, shown under the section title. */
  stats?: Array<{ label: string; value: string }>;
}

const { projects, activeId, stats = [] } = Astro.props;
---

<section id="more-projects" class="scroll-mt-(--header-h) border-t border-beige/60 bg-ivory">
  <Container class="section-tight">
    <div class="grid gap-y-(--stack-md) lg:grid-cols-12 lg:gap-x-10">
      {/* ------------------------------------------------------------ title */}
      <div class="lg:col-span-2">
        <Reveal variant="fade">
          <SectionNumber value="02" />
        </Reveal>
        <Reveal variant="line" class="mt-5 hidden h-px w-full bg-beige lg:block" />
        <Reveal variant="fade" class="mt-5">
          <Eyebrow>More Projects</Eyebrow>
        </Reveal>

        {
          stats.length > 0 && (
            <dl class="mt-9 hidden lg:block" data-reveal-group="70">
              {stats.map((stat) => (
                <Reveal variant="fade">
                  <div class="flex items-baseline justify-between gap-4 border-t border-beige/70 py-3">
                    <dt class="label text-teal/40">{stat.label}</dt>
                    <dd class="font-display text-[1.0625rem] leading-none text-teal">
                      {stat.value}
                    </dd>
                  </div>
                </Reveal>
              ))}
            </dl>
          )
        }
      </div>

      {/* ------------------------------------------------------------- rail */}
      <div class="lg:col-span-8" data-rail>
        <div
          class="zen-rail-track flex snap-x snap-mandatory gap-6 overflow-x-auto pb-1 lg:gap-8"
          data-rail-track
          tabindex="0"
        >
          {
            projects.map((project, index) => (
              <div
                data-rail-project={project.id}
                hidden={project.id === activeId}
                class="w-[78%] shrink-0 snap-start sm:w-[46%] lg:w-[calc((100%-4rem)/3)]"
              >
                <Reveal as="article" delay={Math.min(index, 3) * 110}>
                <a
                  href={`/projects/${project.id}`}
                  class="group block focus-visible:outline-offset-8"
                >
                  <div class="relative aspect-[4/3] overflow-hidden rounded-zen bg-stone">
                    <Image
                      src={project.data.cover}
                      alt={project.data.coverAlt}
                      widths={[400, 640, 900, 1200]}
                      sizes="(min-width: 1024px) 26vw, (min-width: 640px) 46vw, 78vw"
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-[1400ms] ease-(--ease-zen) group-hover:scale-[1.05]"
                    />
                    {/* Wash that lifts on hover, so the card responds without moving. */}
                    <span
                      class="pointer-events-none absolute inset-0 bg-ink/10 transition-opacity duration-700 ease-(--ease-zen) group-hover:opacity-0"
                      aria-hidden="true"
                    />
                  </div>

                  <div class="relative mt-5 h-px w-full bg-beige" aria-hidden="true">
                    <span class="absolute inset-0 origin-left scale-x-0 bg-brass transition-transform duration-700 ease-(--ease-zen) group-hover:scale-x-100" />
                  </div>

                  <div class="mt-4 flex items-start justify-between gap-4">
                    <h3 class="font-display text-display-sm text-teal transition-colors duration-500 group-hover:text-brass">
                      {project.data.title}
                    </h3>
                    <span
                      class="label flex shrink-0 items-center gap-3 pt-1.5 text-teal/30"
                      aria-hidden="true"
                    >
                      {pad(index + 1)}
                      <span class="inline-block text-teal/45 transition-transform duration-500 ease-(--ease-zen) group-hover:translate-x-1 group-hover:text-brass">
                        &#8594;
                      </span>
                    </span>
                  </div>

                  <p class="label mt-2.5 text-teal/45">
                    {project.data.location} &nbsp;/&nbsp; {project.data.category}
                  </p>
                </a>
                </Reveal>
              </div>
            ))
          }
        </div>

        {/* Position marker. Faded out where the strip does not scroll. */}
        <div
          class="mt-8 h-px w-full overflow-hidden bg-beige opacity-0 transition-opacity duration-500"
          data-rail-meter
          aria-hidden="true"
        >
          <div
            class="h-full w-0 bg-brass transition-[width] duration-300 ease-out"
            data-rail-progress
          >
          </div>
        </div>
      </div>

      {/* --------------------------------------------------------- controls */}
      <div
        class="flex items-center justify-between gap-6 lg:col-span-2 lg:flex-col lg:items-start lg:justify-center lg:gap-12"
      >
        <Reveal variant="fade">
          <div class="flex gap-3">
            <button
              type="button"
              data-rail-prev
              aria-label="Previous projects"
              aria-controls="more-projects"
              class="flex h-12 w-12 items-center justify-center rounded-full border border-teal/25 text-teal transition-colors duration-300 ease-(--ease-zen) hover:border-teal hover:bg-teal hover:text-ivory disabled:pointer-events-none disabled:opacity-25"
            >
              <span aria-hidden="true">&#8592;</span>
            </button>
            <button
              type="button"
              data-rail-next
              aria-label="Next projects"
              aria-controls="more-projects"
              class="flex h-12 w-12 items-center justify-center rounded-full border border-teal/25 text-teal transition-colors duration-300 ease-(--ease-zen) hover:border-teal hover:bg-teal hover:text-ivory disabled:pointer-events-none disabled:opacity-25"
            >
              <span aria-hidden="true">&#8594;</span>
            </button>
          </div>
        </Reveal>

        <Reveal variant="fade">
          <a
            href="#index"
            class="group label inline-flex items-center gap-4 text-teal transition-colors duration-300 hover:text-brass"
          >
            All Projects
            <span
              class="block h-px w-8 origin-left bg-beige transition-[transform,background-color] duration-500 ease-(--ease-zen) group-hover:scale-x-125 group-hover:bg-brass"
              aria-hidden="true"></span>
          </a>
        </Reveal>
      </div>
    </div>
  </Container>
</section>

<style>
  .zen-rail-track {
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .zen-rail-track::-webkit-scrollbar {
    display: none;
  }

  .zen-rail-track:focus-visible {
    outline: 2px solid var(--color-brass);
    outline-offset: 6px;
  }

  .zen-rail-track[data-draggable='true'] {
    cursor: grab;
  }

  .zen-rail-track[data-dragging='true'] {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
    user-select: none;
  }
</style>

<script>
  /** Progressive enhancement over a native scroller. Everything here is additive. */
  const root = document.querySelector<HTMLElement>('[data-rail]');
  const track = root?.querySelector<HTMLElement>('[data-rail-track]');

  if (root && track) {
    const section = root.closest('section');
    const prev = section?.querySelector<HTMLButtonElement>('[data-rail-prev]');
    const next = section?.querySelector<HTMLButtonElement>('[data-rail-next]');
    const progress = root.querySelector<HTMLElement>('[data-rail-progress]');
    const meter = root.querySelector<HTMLElement>('[data-rail-meter]');

    const maxScroll = () => track.scrollWidth - track.clientWidth;

    /** One card plus its gap, so an arrow press advances exactly one project. */
    const step = () => {
      const card = track.firstElementChild as HTMLElement | null;
      if (!card) return track.clientWidth * 0.8;
      const gap = Number.parseFloat(getComputedStyle(track).columnGap || '0') || 0;
      return card.offsetWidth + gap;
    };

    const update = () => {
      const max = maxScroll();
      const scrollable = max > 1;

      track.dataset.draggable = scrollable ? 'true' : 'false';
      // A position marker for a strip that cannot move is just a rule.
      if (meter) meter.style.opacity = scrollable ? '1' : '0';

      if (prev) prev.disabled = !scrollable || track.scrollLeft <= 1;
      if (next) next.disabled = !scrollable || track.scrollLeft >= max - 1;

      if (progress) {
        // A floor, so the bar reads as a position marker rather than vanishing
        // at the start of the strip.
        const ratio = scrollable ? track.scrollLeft / max : 1;
        progress.style.width = `${Math.max(10, ratio * 100)}%`;
      }
    };

    prev?.addEventListener('click', () =>
      track.scrollBy({ left: -step(), behavior: 'smooth' }),
    );
    next?.addEventListener('click', () =>
      track.scrollBy({ left: step(), behavior: 'smooth' }),
    );

    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });

    /*
      The hero announces which project it is showing. That one is withheld
      here, so the two sections never show the same photograph at once.
    */
    const cards = Array.from(
      track.querySelectorAll<HTMLElement>('[data-rail-project]'),
    );

    document.addEventListener('zen:hero-change', (event) => {
      const id = (event as CustomEvent<{ id?: string }>).detail?.id;
      for (const card of cards) card.hidden = card.dataset.railProject === id;
      update();
    });

    /* ---- pointer dragging ------------------------------------------------ */

    let dragging = false;
    let startX = 0;
    let startScroll = 0;
    let moved = 0;

    track.addEventListener('pointerdown', (event) => {
      // Mouse only. Touch already drags natively, and hijacking it there
      // fights the platform's own momentum scrolling.
      if (event.pointerType !== 'mouse' || maxScroll() <= 1) return;
      dragging = true;
      moved = 0;
      startX = event.clientX;
      startScroll = track.scrollLeft;
      track.dataset.dragging = 'true';
      track.setPointerCapture(event.pointerId);
    });

    track.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      const delta = event.clientX - startX;
      moved = Math.max(moved, Math.abs(delta));
      track.scrollLeft = startScroll - delta;
    });

    const endDrag = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      delete track.dataset.dragging;
      if (track.hasPointerCapture(event.pointerId)) {
        track.releasePointerCapture(event.pointerId);
      }
    };

    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);

    // A drag that ends on a card must not also follow that card's link.
    track.addEventListener(
      'click',
      (event) => {
        if (moved > 6) {
          event.preventDefault();
          event.stopPropagation();
          moved = 0;
        }
      },
      true,
    );

    update();
    window.addEventListener('load', update, { once: true });
  }
</script>
