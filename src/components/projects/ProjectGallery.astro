---
import { Image } from 'astro:assets';
import Container from '@components/ui/Container.astro';
import Reveal from '@components/ui/Reveal.astro';
import { pad } from '@lib/format';
import type { Project } from '@lib/content';

interface Props {
  gallery: Project['data']['gallery'];
  title: string;
}

const { gallery, title } = Astro.props;

/**
 * Asymmetric gallery.
 *
 * `span` comes from the content, so the project decides which frames carry
 * weight. A hero interior and a joinery detail are not shown at the same size.
 * On mobile everything becomes a single column: a shrunken collage is worse
 * than one image at a time.
 */
const spans = {
  full: 'lg:col-span-12',
  wide: 'lg:col-span-8',
  half: 'lg:col-span-6',
  detail: 'lg:col-span-4',
} as const;

const ratios = {
  full: 'aspect-[16/9]',
  wide: 'aspect-[3/2]',
  half: 'aspect-[4/3]',
  detail: 'aspect-square',
} as const;

const sizes = {
  full: '(min-width: 1024px) 92vw, 92vw',
  wide: '(min-width: 1024px) 62vw, 92vw',
  half: '(min-width: 1024px) 46vw, 92vw',
  detail: '(min-width: 1024px) 30vw, 92vw',
} as const;
---

{
  gallery.length > 0 && (
    <section class="bg-ivory pb-[--section-y]">
      <Container>
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10">
          {gallery.map((item, index) => (
            <Reveal
              variant="clip"
              delay={(index % 3) * 70}
              class:list={[spans[item.span], 'w-full']}
            >
              <figure class="w-full">
                <button
                  type="button"
                  class="group relative block w-full overflow-hidden rounded-zen bg-stone focus-visible:outline-offset-4"
                  data-lightbox-open={index}
                  aria-label={`View image ${index + 1} of ${gallery.length}, ${item.alt}`}
                >
                  <div class:list={[ratios[item.span], 'w-full']}>
                    <Image
                      src={item.src}
                      alt={item.alt}
                      widths={[480, 800, 1200, 1600, 2000]}
                      sizes={sizes[item.span]}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-[1200ms] ease-[--ease-zen] group-hover:scale-[1.03]"
                    />
                  </div>
                  <span
                    class="label absolute bottom-4 left-4 rounded-zen bg-ink/45 px-3 py-2 text-ivory opacity-0 backdrop-blur-sm transition-opacity duration-300 group-hover:opacity-100"
                    aria-hidden="true"
                  >
                    {pad(index + 1)} / {pad(gallery.length)}
                  </span>
                </button>

                {item.caption && (
                  <figcaption class="mt-4 text-small text-charcoal/55">
                    {item.caption}
                  </figcaption>
                )}
              </figure>
            </Reveal>
          ))}
        </div>
      </Container>

      {/*
        Native <dialog> is used deliberately. showModal() gives a real focus
        trap, an inert background and Escape-to-close from the platform,
        which is more reliable than hand-rolling all three.
      */}
      <dialog
        data-lightbox
        aria-label={`${title} gallery`}
        class="fixed inset-0 m-0 h-full max-h-none w-full max-w-none bg-ink/97 p-0 backdrop:bg-ink/90"
      >
        <div class="relative flex h-full w-full flex-col">
          <div class="flex shrink-0 items-center justify-between px-[--gutter] py-6">
            <p class="label text-ivory/60">
              <span data-lightbox-counter>01</span> / {pad(gallery.length)}
            </p>
            <button
              type="button"
              data-lightbox-close
              class="label flex items-center gap-3 py-2 text-ivory transition-colors duration-300 hover:text-brass-soft"
            >
              Close
              <span class="relative block h-4 w-4" aria-hidden="true">
                <span class="absolute top-1/2 left-0 block h-px w-4 rotate-45 bg-current" />
                <span class="absolute top-1/2 left-0 block h-px w-4 -rotate-45 bg-current" />
              </span>
            </button>
          </div>

          <div class="relative flex min-h-0 flex-1 items-center justify-center px-[--gutter] pb-4">
            {gallery.map((item, index) => (
              <figure
                data-lightbox-slide={index}
                hidden={index !== 0}
                class="flex h-full w-full flex-col items-center justify-center"
              >
                <Image
                  src={item.src}
                  alt={item.alt}
                  widths={[800, 1200, 1600, 2000, 2400]}
                  sizes="(min-width: 1024px) 82vw, 96vw"
                  loading="lazy"
                  class="max-h-[76vh] w-auto max-w-full object-contain"
                />
                <figcaption class="mt-5 max-w-[60ch] text-center text-small text-ivory/55">
                  {item.caption ?? item.alt}
                </figcaption>
              </figure>
            ))}
          </div>

          <div class="flex shrink-0 items-center justify-between gap-6 px-[--gutter] pb-8">
            <button
              type="button"
              data-lightbox-prev
              class="label py-3 text-ivory transition-colors duration-300 hover:text-brass-soft"
            >
              &#8592; Previous
            </button>
            <p class="label truncate text-ivory/35">{title}</p>
            <button
              type="button"
              data-lightbox-next
              class="label py-3 text-ivory transition-colors duration-300 hover:text-brass-soft"
            >
              Next &#8594;
            </button>
          </div>
        </div>
      </dialog>
    </section>
  )
}

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const slides = Array.from(
    document.querySelectorAll<HTMLElement>('[data-lightbox-slide]'),
  );
  const counter = document.querySelector<HTMLElement>('[data-lightbox-counter]');

  if (dialog && slides.length > 0) {
    let current = 0;

    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.hidden = i !== current;
      });
      if (counter) counter.textContent = String(current + 1).padStart(2, '0');
    };

    const open = (index: number) => {
      show(index);
      dialog.showModal();
      document.body.dataset.scrollLocked = 'true';
    };

    const close = () => {
      dialog.close();
    };

    document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]').forEach((button) => {
      button.addEventListener('click', () => open(Number(button.dataset.lightboxOpen ?? 0)));
    });

    dialog
      .querySelector<HTMLButtonElement>('[data-lightbox-close]')
      ?.addEventListener('click', close);
    dialog
      .querySelector<HTMLButtonElement>('[data-lightbox-prev]')
      ?.addEventListener('click', () => show(current - 1));
    dialog
      .querySelector<HTMLButtonElement>('[data-lightbox-next]')
      ?.addEventListener('click', () => show(current + 1));

    // Escape is handled natively by <dialog>. Arrows are not.
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(current + 1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(current - 1);
      }
    });

    // Clicking the backdrop closes. The dialog element itself is the backdrop,
    // so a click that lands on it rather than on its contents means outside.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });

    dialog.addEventListener('close', () => {
      delete document.body.dataset.scrollLocked;
    });
  }
</script>
