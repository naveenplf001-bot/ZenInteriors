---
import { Image } from 'astro:assets';
import type { Project } from '@lib/content';
import { pad } from '@lib/format';

/**
 * The featured project hero.
 *
 * An editorial spread rather than a section: the project written out on the
 * left, the photograph running to the right edge of the screen, and a dark
 * index panel set into it carrying the running order and the scroll cue.
 *
 * Every project is a slide, and all slides are rendered into the same grid
 * cell, so the band never changes height as you move through it and every
 * photograph is decoded before it is needed. Movement is CSS only: entering
 * text is animated rather than transitioned, which is what lets the same
 * keyframes replay each time a slide becomes active.
 *
 * On load the frame wipes open and the index panel rises into place. Slides
 * then advance on their own, with the active number's hairline counting down
 * the interval; the pointer over the band, keyboard focus inside it or
 * scrolling it away holds the count. Reduced motion turns all of it off.
 */

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const total = projects.length;

/*
  The title breaks before its last word so the second line can carry the brass
  accent the display headings use elsewhere. Declared, not measured: a headline
  that has to be laid out before it can be broken cannot be revealed for free.
*/
function splitTitle(title: string): [string, string] {
  const words = title.trim().split(/\s+/);
  if (words.length < 2) return [title, ''];
  return [words.slice(0, -1).join(' '), words[words.length - 1]!];
}

const slides = projects.map((project, index) => {
  const [head, tail] = splitTitle(project.data.title);
  return {
    index,
    id: project.id,
    data: project.data,
    head,
    tail,
    frames: project.data.gallery.length,
    /* A line of the project's own copy, set over the photograph. */
    caption: project.data.highlights[0] ?? project.data.summary,
    facts: [
      { label: 'Year', value: String(project.data.year) },
      { label: 'Typology', value: project.data.category },
      { label: 'Location', value: project.data.location },
      { label: 'Scope', value: project.data.scope },
    ],
  };
});
---

<section
  class="zen-hero relative bg-ivory"
  data-hero
  aria-roledescription="carousel"
  aria-label="Featured projects"
>
  <div
    class="max-lg:relative max-lg:isolate lg:grid lg:min-h-[min(88vh,900px)] lg:grid-cols-[minmax(0,35fr)_minmax(0,65fr)] lg:items-stretch"
  >
    {/* ----------------------------------------------------------- written */}
    <div
      class="zen-hero-written relative z-10 flex flex-col justify-center px-(--gutter) pt-[clamp(1.75rem,4vh,2.75rem)] pb-[clamp(2.25rem,5vh,3.25rem)] max-lg:pt-14 max-lg:pb-20 lg:py-[clamp(2.5rem,6vh,4.5rem)] lg:pr-[clamp(1.5rem,2.6vw,2.75rem)]"
    >
      {/*
        The page heading, set as the stacked label the reference puts against
        the frame. Small on purpose: the project title is the largest thing on
        the screen, and two display headings would fight.
      */}
      <h1 class="hero-intro label leading-[2] text-teal/60" style="--d:120ms">
        Spaces that hold<br />their composure.
      </h1>
      <span class="hero-intro-rule mt-5 block h-px w-12 bg-beige" aria-hidden="true"></span>

      <div class="relative mt-[clamp(1.25rem,2.6vh,2.25rem)] grid">
        {
          slides.map((slide) => (
            <div
              data-hero-panel={slide.index}
              data-active={slide.index === 0 ? '' : undefined}
              aria-hidden={slide.index === 0 ? 'false' : 'true'}
              class="col-start-1 row-start-1"
            >
              <p class="hero-in label flex items-center gap-4 text-teal/65" style="--d:40ms">
                <span>
                  {pad(slide.index + 1)}
                  <span class="px-1 opacity-40">/</span>
                  {pad(total)}
                </span>
                <span class="h-px w-7 bg-teal/25" aria-hidden="true" />
                <span>Featured Project</span>
                <span class="hidden h-px flex-1 bg-beige sm:block" aria-hidden="true" />
              </p>

              <h2 class="mt-[clamp(1rem,2.2vh,1.75rem)] font-display text-[clamp(2.375rem,1.1rem+4vw,4.25rem)] leading-[0.98] font-light tracking-[-0.028em]">
                <span class="block overflow-hidden pb-[0.06em]">
                  <span class="hero-line block text-teal" style="--d:110ms">
                    {slide.head}
                  </span>
                </span>
                {slide.tail && (
                  <span class="block overflow-hidden pb-[0.06em]">
                    <span class="hero-line block text-brass" style="--d:200ms">
                      {slide.tail}
                    </span>
                  </span>
                )}
              </h2>

              <p
                class="hero-in label mt-[clamp(0.875rem,2vh,1.375rem)] text-teal/68"
                style="--d:300ms"
              >
                {slide.data.location} &nbsp;/&nbsp; {slide.data.category}
              </p>

              <p
                class="hero-in mt-[clamp(1rem,2.1vh,1.5rem)] max-w-[38ch] text-small leading-[1.75] text-charcoal/80"
                style="--d:360ms"
              >
                {slide.data.summary}
              </p>

              <div class="hero-in mt-[clamp(1.25rem,2.6vh,2rem)]" style="--d:430ms">
                <a
                  href={`/projects/${slide.id}`}
                  data-hero-link
                  tabindex={slide.index === 0 ? undefined : '-1'}
                  class="label group inline-flex items-center gap-4 rounded-zen border border-teal/30 px-8 py-4 text-teal transition-colors duration-(--duration-base) ease-(--ease-zen) hover:border-teal hover:bg-teal hover:text-ivory"
                >
                  View Project
                  <span
                    class="inline-block transition-transform duration-500 ease-(--ease-zen) group-hover:translate-x-1"
                    aria-hidden="true"
                  >
                    &#8594;
                  </span>
                </a>
              </div>

              {/* A title block, read the way a drawing sheet is read. */}
              <dl class="hero-facts mt-[clamp(1.5rem,3.2vh,2.5rem)] grid grid-cols-2 gap-y-6 xl:grid-cols-4">
                {slide.facts.map((fact, i) => (
                  <div class="hero-in" style={`--d:${480 + i * 60}ms`}>
                    <dt class="label text-teal/60">{fact.label}</dt>
                    <dd class="mt-2.5 max-w-[18ch] text-micro leading-[1.55] text-charcoal/85">
                      {fact.value}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          ))
        }
      </div>
    </div>

    {/* ------------------------------------------------------------- framed */}
    {/*
      Below lg the photograph is the ground of the band, behind the written
      panel, rather than a second row under it: the same text-on-photograph
      reading the spread has on a desktop.
    */}
    <div class="relative flex flex-col max-lg:absolute max-lg:inset-0 lg:pt-(--hero-top)">
      {/* Dark flag hung from the top edge, breaking the ivory band. */}
      <span
        class="hero-flag absolute top-0 right-[calc(var(--hero-panel-right)+var(--hero-panel-w)+clamp(2rem,5vw,5rem))] hidden h-(--hero-top) w-[clamp(3.5rem,6vw,7rem)] origin-top bg-teal lg:block"
        aria-hidden="true"></span>

      {/*
        The photographs are taken out of flow. Left in it, an image with an
        intrinsic height and no ratio of its own would drive the frame's height
        on desktop instead of filling the space the grid row gives it.
      */}
      <div
        class="hero-frame relative flex aspect-[4/5] w-full overflow-hidden bg-stone sm:aspect-[16/10] max-lg:aspect-auto max-lg:h-full lg:aspect-auto lg:flex-1"
        data-hero-frame
      >
        {/* Where you are, set on the photograph for screens without the index panel. */}
        <span
          class="label absolute top-4 right-4 z-[2] flex items-center gap-1.5 rounded-full bg-ink/35 px-3.5 py-2 text-ivory tabular-nums backdrop-blur-sm lg:hidden"
          aria-hidden="true"
        >
          <span data-hero-count>01</span>
          <span class="text-ivory/55">/ {pad(total)}</span>
        </span>

        <div class="absolute inset-0 grid overflow-hidden" data-hero-parallax>
          {
            slides.map((slide) => (
              <Image
                src={slide.data.cover}
                alt={slide.data.coverAlt}
                widths={[640, 1024, 1400, 1800, 2200]}
                sizes="(min-width: 1024px) 65vw, 100vw"
                loading={slide.index === 0 ? 'eager' : 'lazy'}
                fetchpriority={slide.index === 0 ? 'high' : 'auto'}
                data-hero-image={slide.index}
                data-project={slide.id}
                data-active={slide.index === 0 ? '' : undefined}
                class="col-start-1 row-start-1 h-full w-full object-cover"
              />
            ))
          }
        </div>

        {/* Scrim, so ivory type over a bright interior stays legible. */}
        <div
          class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/60 via-ink/5 to-transparent"
          aria-hidden="true"
        >
        </div>

        {/* Below lg only: the wash that holds the written panel's ivory type. */}
        <div
          class="pointer-events-none absolute inset-0 z-[1] bg-gradient-to-t from-ink/90 via-ink/62 to-ink/45 lg:hidden"
          aria-hidden="true"
        >
        </div>

        {/* The written panel already carries the project link below lg. */}
        <div
          class="relative mt-auto grid w-full items-end gap-6 p-[clamp(1.25rem,2.6vw,2.5rem)] max-lg:hidden sm:grid-cols-[auto_minmax(0,1fr)] lg:pr-[calc(var(--hero-panel-right)+var(--hero-panel-w)+1.5rem)]"
        >
          <div class="grid">
            {
              slides.map((slide) => (
                <a
                  href={`/projects/${slide.id}`}
                  data-hero-panel={slide.index}
                  data-active={slide.index === 0 ? '' : undefined}
                  data-hero-link
                  tabindex={slide.index === 0 ? undefined : '-1'}
                  aria-hidden={slide.index === 0 ? 'false' : 'true'}
                  class="group col-start-1 row-start-1 flex items-center gap-4 self-end justify-self-start"
                >
                  <span class="relative flex h-14 w-14 shrink-0 items-center justify-center rounded-full border border-ivory/45 text-ivory transition-colors duration-500 ease-(--ease-zen) group-hover:border-ivory lg:h-16 lg:w-16">
                    <span
                      class="hero-ring pointer-events-none absolute inset-0 rounded-full border border-ivory/40"
                      aria-hidden="true"
                    />
                    <span
                      class="inline-block transition-transform duration-500 ease-(--ease-zen) group-hover:translate-x-1"
                      aria-hidden="true"
                    >
                      &#8594;
                    </span>
                  </span>
                  <span class="label leading-[1.9] text-ivory/92">
                    Explore the project
                    <br />
                    <span class="text-ivory/65">{pad(slide.frames)} frames</span>
                  </span>
                </a>
              ))
            }
          </div>

          <div class="hidden max-w-[32ch] justify-self-end sm:grid">
            {
              slides.map((slide) => (
                <p
                  data-hero-panel={slide.index}
                  data-active={slide.index === 0 ? '' : undefined}
                  aria-hidden="true"
                  class="col-start-1 row-start-1 self-end text-right font-display text-[clamp(1rem,1.4vw,1.375rem)] leading-[1.45] text-ivory italic"
                >
                  <span class="hero-in block" style="--d:260ms">
                    &ldquo;{slide.caption}.&rdquo;
                  </span>
                </p>
              ))
            }
          </div>
        </div>
      </div>

      {/* ------------------------------------------------------- index panel */}
      <div
        class="hero-panel absolute right-(--hero-panel-right) bottom-0 hidden w-(--hero-panel-w) flex-col items-center bg-teal pt-[clamp(1.75rem,3.4vh,2.75rem)] pb-[clamp(1.5rem,3vh,2.5rem)] lg:flex"
        style="top: calc(var(--hero-top) + clamp(2.5rem, 7vh, 5.5rem))"
      >
        <div
          class="flex flex-col items-center gap-3"
          role="tablist"
          aria-label="Choose a project"
        >
          {
            slides.map((slide) => (
              <button
                type="button"
                role="tab"
                data-hero-dot={slide.index}
                aria-selected={slide.index === 0 ? 'true' : 'false'}
                aria-label={`${slide.data.title}, project ${slide.index + 1} of ${total}`}
                class="label relative px-2 py-1 text-ivory/55 transition-colors duration-500 ease-(--ease-zen) hover:text-ivory/88 aria-selected:text-ivory"
              >
                {pad(slide.index + 1)}
                <span
                  class="hero-dot-rule absolute inset-x-1 -bottom-1 h-px origin-left bg-brass-soft"
                  data-hero-dot-rule
                  aria-hidden="true"
                />
              </button>
            ))
          }
        </div>

        <a
          href="#index"
          class="group mt-auto flex flex-col items-center gap-5 pt-10 text-ivory/80 transition-colors duration-500 hover:text-ivory"
        >
          <span
            class="relative block h-[clamp(2.5rem,9vh,5rem)] w-px overflow-hidden bg-ivory/25"
            aria-hidden="true"
          >
            <span class="hero-cue absolute inset-x-[-1px] top-0 block h-1/4 bg-brass-soft"></span>
          </span>
          <span aria-hidden="true" class="text-[0.75rem] leading-none">&#8595;</span>
          <span class="label text-center leading-[1.9]">Scroll<br />to explore</span>
        </a>
      </div>
    </div>
  </div>

  {/* Running order for narrow screens, where the panel is not rendered. */}
  <div class="hero-intro flex items-center gap-4 px-(--gutter) pt-6 pb-2 lg:hidden" style="--d:700ms">
    {
      slides.map((slide) => (
        <button
          type="button"
          data-hero-dot={slide.index}
          aria-label={`${slide.data.title}, project ${slide.index + 1} of ${total}`}
          aria-current={slide.index === 0 ? 'true' : 'false'}
          class="label relative flex-1 border-t border-beige py-3 text-left text-teal/50 transition-colors duration-500 aria-[current=true]:text-teal"
        >
          <span
            class="hero-dot-rule absolute inset-x-0 -top-px h-px origin-left bg-brass"
            data-hero-dot-rule
            aria-hidden="true"
          />
          {pad(slide.index + 1)}
          <span class="mt-1.5 block truncate text-[0.625rem] tracking-[0.14em] normal-case opacity-0 transition-opacity duration-500 sm:opacity-100">
            {slide.data.location}
          </span>
        </button>
      ))
    }
  </div>

  <p class="visually-hidden" aria-live="polite" data-hero-live></p>
</section>

<style>
  .zen-hero {
    /* Geometry of the right-hand furniture, declared once. */
    --hero-top: clamp(1.75rem, 5vh, 4rem);
    --hero-panel-w: clamp(5rem, 6.4vw, 7rem);
    --hero-panel-right: clamp(1.25rem, 2.8vw, 3.25rem);
  }

  /* Stacked slides. Only the active one is visible or clickable. */
  [data-hero-panel] {
    opacity: 0;
    pointer-events: none;
    transition: opacity 460ms var(--ease-zen);
  }

  [data-hero-panel][data-active] {
    opacity: 1;
    pointer-events: auto;
  }

  [data-hero-image] {
    opacity: 0;
    transition: opacity 900ms var(--ease-zen);
  }

  [data-hero-image][data-active] {
    z-index: 1;
    opacity: 1;
  }

  /* The outgoing photograph holds underneath while the next one wipes across. */
  [data-hero-image][data-leaving] {
    opacity: 1;
    transition: none;
  }

  /* Running-order hairlines: full on the active number. */
  .hero-dot-rule {
    transform: scaleX(0);
    transition: transform 700ms var(--ease-zen);
  }

  [aria-selected='true'] > .hero-dot-rule,
  [aria-current='true'] > .hero-dot-rule {
    transform: scaleX(1);
  }

  /* Vertical rules between the fact cells, following the column count. */
  .hero-facts > *:nth-child(2n) {
    border-left: 1px solid var(--color-beige);
    padding-left: clamp(0.875rem, 1.4vw, 1.5rem);
  }

  @media (min-width: 80rem) {
    .hero-facts > *:not(:first-child) {
      border-left: 1px solid var(--color-beige);
      padding-left: clamp(0.875rem, 1.4vw, 1.5rem);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /*
      Entering content is animated, not transitioned. A transition cannot be
      replayed on an element that never changed its resting state, and every
      slide has to land the same way each time it is chosen.
    */
    [data-hero-panel] .hero-line {
      transform: translate3d(0, 110%, 0);
    }

    [data-hero-panel][data-active] .hero-line {
      animation: hero-line-in 1100ms var(--ease-zen-out) var(--d, 0ms) both;
    }

    [data-hero-panel] .hero-in {
      opacity: 0;
    }

    [data-hero-panel][data-active] .hero-in {
      animation: hero-in 900ms var(--ease-zen-out) var(--d, 0ms) both;
    }

    /* The photograph settles back from an over-scale as it crossfades. */
    [data-hero-image] {
      transform: scale(1.07);
      transition:
        opacity 900ms var(--ease-zen),
        transform 2200ms var(--ease-zen-out);
    }

    [data-hero-image][data-active] {
      transform: scale(1);
    }

    /*
      The layer is held slightly over size so the counter-movement never pulls
      an edge into the frame.
    */
    [data-hero-parallax] {
      transform: translate3d(0, var(--parallax, 0px), 0) scale(1.09);
      will-change: transform;
    }

    .hero-ring {
      animation: hero-ring 3200ms var(--ease-zen) infinite;
    }

    .hero-cue {
      animation: hero-cue 2600ms var(--ease-zen) infinite;
    }

    /* ---- load ---- */
    .hero-intro {
      animation: hero-in 1000ms var(--ease-zen-out) var(--d, 0ms) both;
    }

    .hero-intro-rule {
      transform-origin: left center;
      animation: hero-rule-in 1100ms var(--ease-zen-out) 260ms both;
    }

    .hero-frame {
      animation: hero-frame-in 1500ms var(--ease-zen-out) 60ms both;
    }

    .hero-flag {
      animation: hero-flag-in 1000ms var(--ease-zen-out) 900ms both;
    }

    .hero-panel {
      animation: hero-panel-in 1300ms var(--ease-zen-out) 520ms both;
    }

    /* ---- slide change ---- */
    [data-hero-image][data-active][data-wipe] {
      animation: hero-wipe 1250ms var(--ease-zen-out) both;
    }

    /* ---- autoplay: the active hairline counts down the interval ---- */
    [data-hero][data-autoplay] [aria-selected='true'] > .hero-dot-rule,
    [data-hero][data-autoplay] [aria-current='true'] > .hero-dot-rule {
      transition: none;
      animation: hero-count var(--hero-cycle, 7000ms) linear both;
    }

    [data-hero][data-paused] .hero-dot-rule {
      animation-play-state: paused;
    }
  }

  /*
    Below lg the written panel sits on the photograph, so its type turns ivory.
    Scoped, unlayered rules outrank the utility colours; none of this reaches
    lg, where the panel sits on ivory beside the frame.
  */
  @media (width < 64rem) {
    .zen-hero-written .label {
      color: color-mix(in srgb, var(--color-ivory) 80%, transparent);
    }

    .zen-hero-written h2 .text-teal {
      color: var(--color-ivory);
    }

    .zen-hero-written h2 .text-brass {
      color: var(--color-brass-soft);
    }

    .zen-hero-written p:not(.label),
    .zen-hero-written dd {
      color: color-mix(in srgb, var(--color-ivory) 90%, transparent);
    }

    .zen-hero-written .bg-beige,
    .zen-hero-written [class*='bg-teal/'] {
      background-color: color-mix(in srgb, var(--color-ivory) 30%, transparent);
    }

    .zen-hero-written a[data-hero-link] {
      border-color: color-mix(in srgb, var(--color-ivory) 55%, transparent);
      color: var(--color-ivory);
    }

    .zen-hero-written .hero-facts > * {
      border-left-color: color-mix(in srgb, var(--color-ivory) 25%, transparent);
    }
  }

  /* The mobile running order names each place once there is room for it. */
  [aria-current='true'] > span.truncate {
    opacity: 1;
  }

  @keyframes hero-frame-in {
    from {
      clip-path: inset(0 0 0 100%);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes hero-wipe {
    from {
      clip-path: inset(0 0 0 100%);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes hero-flag-in {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  @keyframes hero-panel-in {
    from {
      opacity: 0;
      transform: translate3d(0, 3rem, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-rule-in {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes hero-count {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes hero-line-in {
    from {
      transform: translate3d(0, 110%, 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translate3d(0, 0.875rem, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-ring {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    70%,
    100% {
      transform: scale(1.45);
      opacity: 0;
    }
  }

  @keyframes hero-cue {
    0% {
      transform: translateY(-100%);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    100% {
      transform: translateY(400%);
      opacity: 0;
    }
  }
</style>

<script>
  /**
   * Hero band.
   *
   * Slides are stacked and crossfaded, so only the active one may be
   * reachable: an invisible panel that still takes focus is a keyboard trap in
   * slow motion. Visual state, `aria-hidden` and `tabindex` therefore move
   * together, and one live region announces the change.
   */
  const root = document.querySelector<HTMLElement>('[data-hero]');

  if (root) {
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-panel]'));
    const images = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-image]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-dot]'));
    const live = root.querySelector<HTMLElement>('[data-hero-live]');
    const count = root.querySelector<HTMLElement>('[data-hero-count]');
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const total = images.length;

    if (total > 0) {
      let current = 0;
      let leaving = 0;

      const show = (next: number, announce = true) => {
        const index = (next + total) % total;
        if (index === current && announce) return;

        if (index !== current) {
          const outgoing = images[current];
          window.clearTimeout(leaving);
          images.forEach((image) => image.removeAttribute('data-leaving'));
          if (outgoing && !calm) {
            outgoing.setAttribute('data-leaving', '');
            leaving = window.setTimeout(() => outgoing.removeAttribute('data-leaving'), 1300);
          }
          images[index]?.setAttribute('data-wipe', '');
        }

        current = index;
        if (count) count.textContent = String(current + 1).padStart(2, '0');

        for (const node of [...panels, ...images]) {
          const key = node.dataset.heroPanel ?? node.dataset.heroImage;
          const active = Number(key) === current;
          if (active) node.setAttribute('data-active', '');
          else node.removeAttribute('data-active');

          if (node.dataset.heroPanel !== undefined) {
            node.setAttribute('aria-hidden', active ? 'false' : 'true');
            const links = node.matches('[data-hero-link]')
              ? [node]
              : Array.from(node.querySelectorAll<HTMLElement>('[data-hero-link]'));
            for (const link of links) link.setAttribute('tabindex', active ? '0' : '-1');
          }
        }

        for (const dot of dots) {
          const active = Number(dot.dataset.heroDot) === current;
          if (dot.hasAttribute('role')) dot.setAttribute('aria-selected', String(active));
          else dot.setAttribute('aria-current', String(active));
        }

        if (announce && live) {
          const title =
            root.querySelector(`[data-hero-panel="${current}"] h2`)?.textContent?.trim() ?? '';
          live.textContent = `${title}, project ${current + 1} of ${total}`;
        }
      };

      for (const dot of dots) {
        dot.addEventListener('click', () => show(Number(dot.dataset.heroDot ?? 0)));
      }

      root.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          show(current + 1);
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          show(current - 1);
        }
      });

      /*
        Swipe, anywhere on the band. Touch and pen; the mouse has the index.
        Below lg the written panel sits over the photograph, so listening on
        the frame alone would miss every swipe that lands on the type.
      */
      const frame: HTMLElement | null = root;
      let startX = 0;
      let startY = 0;
      let tracking = false;

      frame?.addEventListener(
        'pointerdown',
        (event) => {
          if (event.pointerType === 'mouse') return;
          tracking = true;
          startX = event.clientX;
          startY = event.clientY;
        },
        { passive: true },
      );

      frame?.addEventListener(
        'pointerup',
        (event) => {
          if (!tracking) return;
          tracking = false;
          const dx = event.clientX - startX;
          // Ignore anything that was mostly a vertical scroll.
          if (Math.abs(dx) < 48 || Math.abs(event.clientY - startY) > Math.abs(dx)) return;
          show(dx < 0 ? current + 1 : current - 1);
        },
        { passive: true },
      );

      show(0, false);

      /*
        Autoplay. The countdown is the CSS animation on the active hairline, so
        pausing is a single attribute and the next slide follows its end.
      */
      if (!calm && total > 1) {
        root.setAttribute('data-autoplay', '');
        const holds = new Set<string>();
        const hold = (key: string, on: boolean) => {
          if (on) holds.add(key);
          else holds.delete(key);
          root.toggleAttribute('data-paused', holds.size > 0);
        };

        if (window.matchMedia('(hover: hover)').matches) {
          root.addEventListener('pointerenter', () => hold('pointer', true));
          root.addEventListener('pointerleave', () => hold('pointer', false));
        }
        root.addEventListener('focusin', (event) =>
          hold('focus', (event.target as HTMLElement).matches(':focus-visible')),
        );
        root.addEventListener('focusout', () => hold('focus', false));
        document.addEventListener('visibilitychange', () => hold('tab', document.hidden));

        if ('IntersectionObserver' in window) {
          new IntersectionObserver(([entry]) => hold('view', !entry?.isIntersecting), {
            threshold: 0.4,
          }).observe(root);
        }

        root.addEventListener('animationend', (event) => {
          if ((event.target as HTMLElement).matches('[data-hero-dot-rule]')) {
            show(current + 1, false);
          }
        });
      }
    }

    /*
      Parallax on the photograph. A few per cent of counter-movement while the
      band is on screen, driven off scroll rather than a timer, and skipped
      entirely for reduced motion.
    */
    const layer = root.querySelector<HTMLElement>('[data-hero-parallax]');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (layer && !still) {
      let ticking = false;

      const place = () => {
        const rect = root.getBoundingClientRect();
        if (rect.bottom < 0 || rect.top > window.innerHeight) return;
        // 0 at the top of the band, 1 once it has fully passed the fold.
        const progress = Math.min(1, Math.max(0, -rect.top / (rect.height || 1)));
        layer.style.setProperty('--parallax', `${(progress * 4).toFixed(2)}%`);
      };

      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(() => {
            place();
            ticking = false;
          });
        },
        { passive: true },
      );

      place();
    }
  }
</script>
