---
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Reveal from '@components/ui/Reveal.astro';
import Button from '@components/ui/Button.astro';
import SplitHeading from '@components/ui/SplitHeading.astro';
import { site } from '@config/site';
import { buildDirectWhatsAppUrl } from '@lib/whatsapp';

interface Props {
  eyebrow?: string;
  /** Supplied as explicit lines so the break is a design decision. */
  title?: string[];
  lede?: string;
}

const {
  eyebrow = 'Private Enquiry',
  title = ['Your space deserves', 'a considered beginning.'],
  lede = 'Every project starts with a conversation about how you want to live, not a price list. Tell us what you are planning and we will tell you honestly whether we are the right studio for it.',
} = Astro.props;

const whatsappHref = buildDirectWhatsAppUrl();

/**
 * The closing invitation, on every page above the footer.
 *
 * The ground is ink rather than teal. Sitting a teal band directly on top of a
 * teal footer merged the two into one undifferentiated dark block, so the page
 * now steps light → ink → teal and each band reads as its own object.
 *
 * The service region was removed from here because the footer states it two
 * inches below. What replaces it is the direct line, which is the one thing a
 * ready buyer wants at this point and which the footer only lists in small type.
 */
---

<section class="relative isolate overflow-hidden bg-ink text-ivory on-dark">
  {/* A brass hairline against the light section above, so the band has a
      defined top edge rather than simply going dark. */}
  <div class="absolute inset-x-0 top-0 h-px bg-brass/40" aria-hidden="true"></div>

  {/* Wordmark watermark. Set in the display face and bled off two edges so it
      reads as a printed ghost rather than as a heading someone forgot to size. */}
  <span
    class="pointer-events-none absolute -right-[3vw] -bottom-[0.28em] font-display text-[clamp(11rem,32vw,26rem)] leading-none tracking-[-0.05em] text-ivory/[0.045] select-none"
    aria-hidden="true">zen</span
  >

  <div
    class="pointer-events-none absolute inset-0 -z-10"
    aria-hidden="true"
    style="background: radial-gradient(90% 120% at 82% 110%, color-mix(in srgb, var(--color-teal) 55%, transparent) 0%, transparent 62%);"
  >
  </div>

  <Container class="section">
    <div class="grid gap-y-12 lg:grid-cols-12 lg:items-end lg:gap-x-16" data-reveal-group>
      <div class="lg:col-span-6">
        <Reveal variant="fade">
          <Eyebrow tone="inverse">{eyebrow}</Eyebrow>
        </Reveal>

        <Reveal variant="line">
          <span class="mt-6 block h-px w-16 origin-left bg-brass" aria-hidden="true"></span>
        </Reveal>

        <SplitHeading lines={title} tone="dark" accentFrom={1} class="mt-7" />
      </div>

      <div class="lg:col-span-5 lg:col-start-8">
        <Reveal>
          <p class="lede max-w-[46ch] text-ivory/65">{lede}</p>
        </Reveal>

        <Reveal class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
          <Button href="/contact" variant="primary" tone="dark">Start Your Project</Button>
          <Button href="/projects" variant="link" tone="dark">Explore Our Projects</Button>
        </Reveal>

        {/* The direct line. Anyone who has read a whole page and is ready to
            speak should not have to find the contact page first. */}
        <Reveal variant="fade">
          <div
            class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-ivory/12 pt-6"
          >
            <span class="label text-ivory/35">Or speak to us</span>
            <a
              href={site.contact.phoneHref}
              class="text-small text-ivory/80 transition-colors duration-300 hover:text-brass-soft"
            >
              {site.contact.phone}
            </a>
            <a
              href={whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              class="text-small text-ivory/80 transition-colors duration-300 hover:text-brass-soft"
            >
              WhatsApp
            </a>
          </div>
        </Reveal>
      </div>
    </div>
  </Container>
</section>
