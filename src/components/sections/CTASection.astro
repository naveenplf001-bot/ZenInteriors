---
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Reveal from '@components/ui/Reveal.astro';
import Button from '@components/ui/Button.astro';
import SplitHeading from '@components/ui/SplitHeading.astro';
import { site } from '@config/site';

interface Props {
  eyebrow?: string;
  /** Supplied as explicit lines so the break is a design decision. */
  title?: string[];
  lede?: string;
}

const {
  eyebrow = 'Private Enquiry',
  title = ['Your space deserves', 'a considered beginning.'],
  lede = 'Every project starts with a conversation about how you want to live, not a price list. Tell us what you are planning and we will tell you honestly whether we are the right studio for it.',
} = Astro.props;
---

<section class="bg-teal text-ivory on-dark">
  <Container class="section">
    <div class="grid gap-y-10 lg:grid-cols-12 lg:items-end lg:gap-x-16" data-reveal-group>
      <div class="lg:col-span-6">
        <Reveal variant="fade">
          <Eyebrow tone="inverse">{eyebrow}</Eyebrow>
        </Reveal>
        <SplitHeading lines={title} tone="dark" accentFrom={1} class="mt-6" />
      </div>

      <div class="lg:col-span-5 lg:col-start-8">
        <Reveal>
          <p class="lede max-w-[46ch] text-ivory/65">{lede}</p>
        </Reveal>
        <Reveal class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
          <Button href="/contact" variant="primary" tone="dark">Start Your Project</Button>
          <Button href="/projects" variant="link" tone="dark">Explore Our Projects</Button>
        </Reveal>
        <Reveal variant="fade">
          <p class="label mt-9 text-ivory/35">
            {site.regions.map((region) => region.name).join(' · ')}
          </p>
        </Reveal>
      </div>
    </div>
  </Container>
</section>
