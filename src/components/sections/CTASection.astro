---
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Reveal from '@components/ui/Reveal.astro';
import Button from '@components/ui/Button.astro';
import { site } from '@config/site';

interface Props {
  eyebrow?: string;
  title?: string;
  lede?: string;
}

const {
  eyebrow = 'Private Enquiry',
  title = 'Your space deserves a considered beginning.',
  lede = 'Every project starts with a conversation about how you want to live, not a price list. Tell us what you are planning and we will tell you honestly whether we are the right studio for it.',
} = Astro.props;
---

<section class="bg-teal text-ivory on-dark">
  <Container class="section">
    <div class="grid gap-14 lg:grid-cols-12 lg:items-end lg:gap-16">
      <div class="lg:col-span-7">
        <Reveal variant="fade">
          <Eyebrow tone="inverse">{eyebrow}</Eyebrow>
        </Reveal>
        <Reveal delay={80}>
          <h2 class="mt-7 font-display text-display-lg text-ivory">
            {title}
          </h2>
        </Reveal>
      </div>

      <div class="lg:col-span-5">
        <Reveal delay={140}>
          <p class="lede text-ivory/70">{lede}</p>
        </Reveal>
        <Reveal delay={200} class="mt-10 flex flex-wrap items-center gap-6">
          <Button href="/contact" variant="primary" tone="dark" size="lg">
            Start Your Project
          </Button>
          <Button href="/projects" variant="link" tone="dark">
            Explore Our Projects
          </Button>
        </Reveal>
        <Reveal variant="fade" delay={260}>
          <p class="label mt-10 text-ivory/40">
            {site.regions.map((region) => region.name).join(' · ')}
          </p>
        </Reveal>
      </div>
    </div>
  </Container>
</section>
