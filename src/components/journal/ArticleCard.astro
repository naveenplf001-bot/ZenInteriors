---
import { Image } from 'astro:assets';
import Reveal from '@components/ui/Reveal.astro';
import type { Article } from '@lib/content';
import { formatDate } from '@lib/format';

interface Props {
  article: Article;
  delay?: number;
  /** feature gives the lead article a wider frame on the journal index. */
  variant?: 'default' | 'feature';
}

const { article, delay, variant = 'default' } = Astro.props;
const { title, excerpt, category, cover, coverAlt, publishedAt } = article.data;

const href = `/journal/${article.id}`;
const aspect = variant === 'feature' ? 'aspect-[16/9]' : 'aspect-[3/2]';
---

<Reveal as="article" delay={delay} class="group">
  <a href={href} class="block focus-visible:outline-offset-8">
    <div class:list={['relative overflow-hidden rounded-zen bg-stone', aspect]}>
      <Image
        src={cover}
        alt={coverAlt}
        widths={[480, 800, 1200, 1600]}
        sizes={variant === 'feature'
          ? '(min-width: 1024px) 76vw, 92vw'
          : '(min-width: 1024px) 44vw, 92vw'}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-[1200ms] ease-[--ease-zen] group-hover:scale-[1.03]"
      />
    </div>

    <p class="label mt-5 text-teal/50">
      Journal &nbsp;/&nbsp; {category}
    </p>

    <h3
      class:list={[
        'mt-2.5 font-display text-teal transition-colors duration-300 group-hover:text-brass',
        variant === 'feature' ? 'text-display-md' : 'text-display-sm',
      ]}
    >
      {title}
    </h3>

    {/*
      The excerpt runs to roughly six lines and is written to create curiosity.
      It is deliberately not clamped shorter, because the whole point is that
      the reader gets far enough in to want the rest.
    */}
    <p class="mt-3.5 max-w-[54ch] text-micro leading-[1.8] text-charcoal/68">
      {excerpt}
    </p>

    <div class="mt-5 flex items-center gap-5">
      <span
        class="label inline-flex shrink-0 items-center gap-2.5 text-teal transition-colors duration-300 group-hover:text-brass"
      >
        Read Article
        <span
          class="inline-block transition-transform duration-500 ease-[--ease-zen] group-hover:translate-x-1"
          aria-hidden="true">&#8594;</span
        >
      </span>
      <span
        class="h-px flex-1 bg-beige transition-colors duration-500 group-hover:bg-brass"
        aria-hidden="true"></span>
      <time datetime={publishedAt.toISOString()} class="label shrink-0 text-teal/35">
        {formatDate(publishedAt)}
      </time>
    </div>
  </a>
</Reveal>
