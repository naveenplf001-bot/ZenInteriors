---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you are looking for is not here."
  noindex
>
  <section class="bg-ivory">
    <Container class="flex min-h-[62svh] flex-col justify-center py-(--section-y)">
      <p class="label text-teal/50">Error 404</p>
      <h1 class="mt-7 max-w-[14ch] font-display text-display-lg text-teal">
        This page has been moved, or never existed.
      </h1>
      <p class="lede mt-8 max-w-[44ch] text-charcoal/72">
        Nothing here. The work is worth seeing though.
      </p>
      <div class="mt-12 flex flex-wrap items-center gap-6">
        <Button href="/projects" variant="primary" size="lg">View Projects</Button>
        <Button href="/" variant="link">Return Home</Button>
      </div>
    </Container>
  </section>
</BaseLayout>
