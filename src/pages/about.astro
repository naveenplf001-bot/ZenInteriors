---
import { Image } from 'astro:assets';

import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import Reveal from '@components/ui/Reveal.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import SplitHeading from '@components/ui/SplitHeading.astro';
import SectionNumber from '@components/ui/SectionNumber.astro';

import { capabilities } from '@data/services';
import { site } from '@config/site';
import { breadcrumbSchema } from '@lib/seo';
import { pad } from '@lib/format';

import aboutHero from '@/assets/images/about/hero.jpg';
import craftImage from '@/assets/images/about/craft.jpg';
import thresholdImage from '@/assets/images/projects/the-emerald-residence/01-threshold.jpg';
import livingVolumeImage from '@/assets/images/projects/the-quiet-villa/01-living-volume.jpg';
import kitchenDetailImage from '@/assets/images/projects/the-slate-apartment/02-kitchen-detail.jpg';

/**
 * The About page opens with philosophy, not incorporation history.
 * "Zen Interior was established in 20XX" is brochure language and it answers
 * a question nobody asked first.
 *
 * Structurally this page has one job beyond describing the studio: it has to
 * make a client who is about to commit somewhere between forty lakh and fifty
 * crore feel that the commitment is safe. Trust is built here by rhythm —
 * philosophy, evidence, photography, process — rather than by longer columns
 * of prose. Every claim below is either verifiable or a statement of method.
 */

const commitments = [
  {
    index: '01',
    title: 'One accountable team',
    body: 'Design, sourcing and execution are held by the same studio. Nothing is resolved on site by three parties who never met, and there is never a question about who is responsible.',
  },
  {
    index: '02',
    title: 'Selected, not specified',
    body: 'Materials are chosen against the drawing that will use them, in person, before anything is committed. A written specification is not a selection, and the difference shows on the wall.',
  },
  {
    index: '03',
    title: 'Detailing that survives inspection',
    body: 'Every junction between two materials is a decision, drawn and sequenced in advance. If a joint looks like a tolerance absorbed on site, it was not designed.',
  },
  {
    index: '04',
    title: 'Finishing as a discipline',
    body: 'The last five percent of a project is where interiors are won or lost. Snagging, commissioning and handover are scheduled work, not an afterthought.',
  },
];

/*
  The assurance band. Derived from the studio's own data rather than typed by
  hand, so the page cannot drift out of agreement with the footer, the contact
  page or the capability list.
*/
const cities = site.regions.flatMap((region) => region.cities);

const assurances = [
  {
    value: 'One',
    label: 'Accountable studio',
    note: 'Design, sourcing and execution held by a single team from first drawing to handover.',
  },
  {
    value: pad(capabilities.length),
    label: 'Disciplines in-house',
    note: 'Spatial planning, joinery, surfaces, lighting, sourcing and site supervision.',
  },
  {
    value: pad(site.regions.length),
    label: 'States covered',
    note: cities.join(' · '),
  },
  {
    value: 'Turnkey',
    label: 'Single point of delivery',
    note: 'From first drawing through sourcing and site to snagging and handover.',
  },
];

/* The three checks behind the finishing claim. Short, scannable, specific. */
const checks = [
  { title: 'Dry-fitted joinery', note: 'Assembled and corrected in the workshop, never on your floor.' },
  { title: 'Stone numbered at origin', note: 'Vein continuity survives the crate, the truck and the wall.' },
  { title: 'Reveals set first', note: 'Shadow gaps are built into the substrate, not cut in afterwards.' },
];

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about' },
  ]),
];
---

<BaseLayout
  title="About the Studio"
  description="Zen Interior combines international product sourcing with local design expertise and professional execution to create distinctive, premium spaces across Tamil Nadu and Bangalore."
  schema={schema}
>
  {/* ------------------------------------------------- philosophy first */}
  {/*
    The opening composition. A single full-bleed photograph read as a stock
    header, so the frame is now a staggered collage: the studio's own language
    set down the first panel, a counter, and a written line in the gutter.

    The teal rail is pinned to the true right edge of the viewport rather than
    to the container, which is what makes the band read as a printed spread.
    It only appears once there is genuinely width for it.
  */}
  <section class="relative isolate overflow-hidden bg-ivory">
    <div
      class="absolute inset-y-0 right-0 hidden w-[clamp(8rem,11vw,12rem)] bg-teal xl:block"
      aria-hidden="true"
    >
    </div>

    <Container
      class="pt-[clamp(3rem,5.5vw,5.5rem)] pb-(--section-y-tight) xl:pr-[clamp(9.5rem,13vw,15rem)]"
    >
      <div class="grid gap-y-14 lg:grid-cols-12 lg:gap-x-12">
        {/* ------------------------------------------------- the statement */}
        <div class="lg:col-span-5 lg:flex lg:flex-col" data-reveal-group>
          <Reveal variant="fade">
            <Eyebrow>The Studio</Eyebrow>
          </Reveal>

          <SplitHeading
            as="h1"
            size="xl"
            lines={['Exceptional interiors', 'are not assembled.', 'They are considered.']}
            accentFrom={2}
            accentItalic
            class="mt-7"
          />

          <Reveal>
            <p class="lede mt-(--stack-md) max-w-[42ch] text-charcoal/75">
              Zen Interior is an interior design and execution studio working across Tamil
              Nadu and Bangalore, for clients who intend to live with the result for a very
              long time.
            </p>
          </Reveal>

          {/* The circle is the page's one drawn object. Everything else here
              is type, rule or photograph. */}
          <Reveal class="mt-(--stack-md)">
            <a href="#story" class="group flex items-center gap-6">
              <span
                class="label flex size-[5.5rem] shrink-0 items-center justify-center rounded-full border border-teal/25 text-center leading-[1.6] text-teal transition-colors duration-500 ease-(--ease-zen) group-hover:border-brass group-hover:text-brass"
              >
                Our<br />Story
              </span>
              <span
                class="relative block h-px w-[clamp(3rem,6vw,6rem)] bg-teal/30 transition-all duration-500 ease-(--ease-zen) group-hover:w-[clamp(4rem,8vw,8rem)] group-hover:bg-brass"
                aria-hidden="true"
              >
                <span
                  class="absolute -top-[3px] right-0 block size-[7px] rotate-45 border-t border-r border-current"
                ></span>
              </span>
            </a>
          </Reveal>

          <Reveal variant="fade" class="mt-auto pt-(--stack-lg)">
            <p class="label text-teal/35">
              Spaces &nbsp;/&nbsp; People &nbsp;/&nbsp; Purpose
            </p>
          </Reveal>
        </div>

        {/* ----------------------------------------------------- the collage */}
        <div class="lg:col-span-7" data-reveal-group="90">
          <div class="grid grid-cols-2 gap-4 sm:gap-5">
            <Reveal variant="clip" class="col-span-2 sm:col-span-1">
              <div class="relative aspect-[3/4] overflow-hidden bg-stone">
                <Image
                  src={aboutHero}
                  alt="Double-height lounge with a floating stone stair and a brass ring pendant above the seating"
                  widths={[480, 800, 1200, 1600]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw"
                  loading="eager"
                  fetchpriority="high"
                  class="h-full w-full object-cover"
                />

                {/* The studio's own language, set down the frame. */}
                <div
                  class="absolute inset-y-0 left-0 flex flex-col justify-center gap-6 bg-gradient-to-r from-ink/55 to-transparent pr-16 pl-6"
                >
                  <p class="label text-ivory/85">Materials</p>
                  <p class="label text-ivory/85">People</p>
                  <p class="label text-ivory/85">Spaces</p>
                  <p class="label text-ivory/85">A Better Tomorrow</p>
                </div>

                <p class="label absolute right-5 bottom-5 text-ivory/70">01 / 03</p>
              </div>
            </Reveal>

            <Reveal variant="clip" class="col-span-2 sm:col-span-1 sm:mt-[clamp(2rem,5vw,4.5rem)]">
              <div class="aspect-[3/4] overflow-hidden bg-stone">
                <Image
                  src={craftImage}
                  alt="Joinery detail under raking light, showing the reveal between two timber faces"
                  widths={[480, 800, 1200, 1600]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw"
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              </div>
            </Reveal>
          </div>

          <div class="mt-6 grid gap-6 sm:grid-cols-2 sm:items-end sm:gap-8">
            <Reveal variant="fade">
              <p
                class="font-display text-[clamp(1.25rem,0.95rem+1vw,1.75rem)] leading-[1.35] text-teal/70 italic"
              >
                Thoughtful spaces<br />last longer.
              </p>
              <span class="mt-4 block h-px w-10 bg-brass" aria-hidden="true"></span>
            </Reveal>

            <Reveal variant="clip">
              <div class="aspect-[16/10] overflow-hidden bg-stone">
                <Image
                  src={thresholdImage}
                  alt="Shaped timber archway framing the dining and tea area beyond"
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 1024px) 28vw, (min-width: 640px) 46vw, 92vw"
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              </div>
            </Reveal>
          </div>
        </div>
      </div>
    </Container>

    {/* The rail's own type, positioned against the viewport edge so it stays
        aligned with the strip behind it at every width above xl. */}
    <div
      class="absolute top-[clamp(4rem,7vw,7rem)] right-0 hidden w-[clamp(8rem,11vw,12rem)] pr-[clamp(1rem,1.6vw,1.75rem)] text-right xl:block"
    >
      <p class="label text-ivory/80">Design</p>
      <p class="label mt-3.5 text-ivory/80">Execute</p>
      <p class="label mt-3.5 text-ivory/80">Nurture</p>
    </div>
  </section>

  {/* ------------------------------------------- who we are, as a strip */}
  {/*
    One ruled line, not a section. No eyebrow and no section number: the band
    is a rule across the page carrying the four assurances, the studio note and
    a way onward, which is the whole reason it reads as a spread rather than as
    another block of content.

    Values come from site config and the capability list, so this cannot drift
    out of agreement with the footer or the services page.
  */}
  <section id="story" class="border-y border-beige bg-ivory">
    <Container class="py-[clamp(2rem,3.4vw,3rem)]">
      <div
        class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-[repeat(4,minmax(0,1fr))_1.5fr_auto] lg:items-stretch lg:gap-x-[clamp(1.25rem,2vw,2.5rem)]"
        data-reveal-group="60"
      >
        {
          assurances.map((item, index) => (
            <Reveal
              variant="fade"
              class:list={[index > 0 && 'lg:border-l lg:border-beige lg:pl-[clamp(1.25rem,2vw,2.5rem)]']}
            >
              <p class="font-display text-[clamp(1.75rem,1.35rem+1.1vw,2.375rem)] leading-none text-teal">
                {item.value}
              </p>
              <p class="label mt-3.5 leading-[1.9] text-teal/60">{item.label}</p>
              <p class="mt-2 max-w-[30ch] text-[0.75rem] leading-[1.6] text-charcoal/55">
                {item.note}
              </p>
            </Reveal>
          ))
        }

        {/* The studio note, held on the same line rather than in a paragraph
            block underneath, which is what keeps the band a single gesture. */}
        <Reveal
          variant="fade"
          class="lg:border-l lg:border-beige lg:pl-[clamp(1.25rem,2vw,2.5rem)]"
        >
          <p class="max-w-[42ch] text-[0.8125rem] leading-[1.75] text-charcoal/70">
            We combine international product sourcing with local design expertise and
            professional execution. That combination is deliberate, and it is why one
            studio can be accountable for a finished space rather than a delivered
            component.
          </p>
        </Reveal>

        <Reveal variant="fade" class="sm:col-span-2 lg:col-span-1 lg:self-center">
          <a href="#process" class="group flex items-center gap-5">
            <span
              class="label flex size-[5rem] shrink-0 items-center justify-center rounded-full border border-teal/25 text-center leading-[1.7] text-teal transition-colors duration-500 ease-(--ease-zen) group-hover:border-brass group-hover:text-brass"
            >
              Our<br />Approach
            </span>
            <span
              class="relative block h-px w-[clamp(2.5rem,4vw,4.5rem)] bg-teal/35 transition-all duration-500 ease-(--ease-zen) group-hover:w-[clamp(3.5rem,5.5vw,5.5rem)] group-hover:bg-brass"
              aria-hidden="true"
            >
              <span
                class="absolute -top-[3px] right-0 block size-[7px] rotate-45 border-t border-r border-current"
              ></span>
            </span>
          </a>
        </Reveal>
      </div>
    </Container>
  </section>

  {/* ------------------------------------------------------ commitments */}
  {/* id is the footer's "Our Process" target. Renaming it breaks that link. */}
  <section id="process" class="bg-stone">
    <Container class="pt-(--section-y) pb-(--section-y-tight)">
      <div class="grid gap-y-12 md:grid-cols-12 md:gap-x-10 lg:gap-x-16">
        <div class="md:col-span-12 lg:col-span-4" data-reveal-group>
          <Reveal variant="fade">
            <SectionNumber value="01" />
          </Reveal>
          <Reveal variant="fade" class="mt-4">
            <Eyebrow>How We Work</Eyebrow>
          </Reveal>
          <SplitHeading lines={['Four commitments', 'we do not negotiate.']} class="mt-6" />
          <Reveal>
            <p class="mt-(--stack-md) max-w-[42ch] text-small text-charcoal/70">
              Access to unusual materials is worth very little without the judgement to
              place them and the discipline to install them correctly, and most projects
              buy those three capabilities from three separate parties. We hold all three.
            </p>
          </Reveal>
          <Reveal>
            <p class="mt-5 max-w-[42ch] text-small text-charcoal/70">
              None of these is a service line. They are the conditions under which we agree
              to take a project on at all.
            </p>
          </Reveal>
        </div>

        <div
          class="grid gap-x-10 sm:grid-cols-2 md:col-span-12 lg:col-span-7 lg:col-start-6"
          data-reveal-group="70"
        >
          {
            commitments.map((item) => (
              <Reveal>
                <div class="h-full border-t border-beige py-8">
                  <span class="label text-brass" aria-hidden="true">
                    {item.index}
                  </span>
                  <h3 class="mt-5 font-display text-display-sm text-teal">{item.title}</h3>
                  <p class="mt-3.5 max-w-[46ch] text-small text-charcoal/70">{item.body}</p>
                </div>
              </Reveal>
            ))
          }
        </div>
      </div>
    </Container>

    {/* A wide frame closes the stone band, so the page never runs two text
        sections back to back. */}
    <Reveal variant="clip" class="mt-(--section-y-tight) block">
      <div class="bleed aspect-[4/3] overflow-hidden bg-beige sm:aspect-[16/9] lg:aspect-[21/9]">
        <Image
          src={livingVolumeImage}
          alt="Open living and dining volume under layered architectural lighting"
          widths={[768, 1280, 1600, 2000, 2400]}
          sizes="100vw"
          loading="lazy"
          class="h-full w-full object-cover"
        />
      </div>
    </Reveal>
  </section>

  {/* ---------------------------------------------------------- quality */}
  <section class="bg-ivory">
    <Container class="section">
      <div class="grid items-center gap-y-12 md:grid-cols-12 md:gap-x-10 lg:gap-x-16">
        <div class="md:col-span-6 lg:col-span-6">
          <Reveal variant="clip">
            <div class="aspect-[4/5] overflow-hidden rounded-zen bg-stone sm:aspect-[3/2] md:aspect-[4/5]">
              <Image
                src={craftImage}
                alt="Entrance with full-height lacquer wardrobes, a walnut console and a fluted black panel"
                widths={[640, 1024, 1400, 1800]}
                sizes="(min-width: 768px) 46vw, 92vw"
                loading="lazy"
                class="h-full w-full object-cover"
              />
            </div>
          </Reveal>

          {/* Offset second frame. Deliberately narrower and pulled in from the
              left, so the pair reads as a spread rather than as two cards. */}
          <Reveal variant="clip" class="mt-6 hidden w-[62%] lg:ml-auto lg:block">
            <div class="aspect-[3/2] overflow-hidden rounded-zen bg-stone">
              <Image
                src={kitchenDetailImage}
                alt="Kitchen detail showing the handleless drawer line and undercabinet lighting"
                widths={[400, 640, 900]}
                sizes="28vw"
                loading="lazy"
                class="h-full w-full object-cover"
              />
            </div>
          </Reveal>
        </div>

        <div class="md:col-span-6 lg:col-span-5 lg:col-start-8" data-reveal-group>
          <Reveal variant="fade">
            <SectionNumber value="02" />
          </Reveal>
          <Reveal variant="fade" class="mt-4">
            <Eyebrow>Quality</Eyebrow>
          </Reveal>

          <SplitHeading lines={['The detail', 'you notice last.']} class="mt-6" />

          <Reveal>
            <p class="lede mt-(--stack-md) text-charcoal/75">
              None of this is visible in a photograph, and all of it is the reason one
              interior still holds five years later.
            </p>
          </Reveal>

          <dl class="mt-(--stack-md)">
            {
              checks.map((check) => (
                <Reveal>
                  <div class="border-t border-beige py-5">
                    <dt class="label text-teal">{check.title}</dt>
                    <dd class="mt-2.5 max-w-[42ch] text-micro text-charcoal/65">{check.note}</dd>
                  </div>
                </Reveal>
              ))
            }
          </dl>
        </div>
      </div>
    </Container>
  </section>

  {/* ----------------------------------------------------- capabilities */}
  <section class="bg-teal text-ivory on-dark">
    <Container class="section">
      <div
        class="grid gap-y-10 md:grid-cols-12 md:items-end md:gap-x-10 lg:gap-x-16"
        data-reveal-group
      >
        <div class="md:col-span-7">
          <Reveal variant="fade">
            <SectionNumber value="03" tone="dark" />
          </Reveal>
          <Reveal variant="fade" class="mt-4">
            <Eyebrow tone="inverse">Capabilities</Eyebrow>
          </Reveal>
          <SplitHeading
            lines={['Complete environments,', 'not components.']}
            tone="dark"
            accentFrom={1}
            class="mt-6"
          />
        </div>

        <div class="md:col-span-5 md:col-start-8">
          <Reveal>
            <p class="lede text-ivory/65">
              Stated broadly and never itemised. A client at this level is not buying a
              modular kitchen; they are buying a resolved space.
            </p>
          </Reveal>
        </div>
      </div>

      <div
        class="mt-(--stack-lg) grid gap-x-10 gap-y-2 sm:grid-cols-2 lg:grid-cols-3"
        data-reveal-group="70"
      >
        {
          capabilities.map((capability) => (
            <Reveal>
              <div class="h-full border-t border-ivory/15 py-8">
                <p class="label" aria-hidden="true">
                  {capability.index}
                </p>
                <h3 class="mt-4 font-display text-display-sm text-ivory">
                  {capability.title}
                </h3>
                <p class="mt-3.5 max-w-[42ch] text-small text-ivory/65">
                  {capability.description}
                </p>
              </div>
            </Reveal>
          ))
        }
      </div>
    </Container>
  </section>

  {/* -------------------------------------------------------- geography */}
  <section class="bg-stone">
    <Container class="section-tight">
      <div
        class="grid gap-y-10 md:grid-cols-12 md:items-end md:gap-x-10 lg:gap-x-16"
        data-reveal-group
      >
        <div class="md:col-span-6">
          <Reveal variant="fade">
            <SectionNumber value="04" />
          </Reveal>
          <Reveal variant="fade" class="mt-4">
            <Eyebrow>Where We Work</Eyebrow>
          </Reveal>
          <SplitHeading lines={['Across', 'South India.']} class="mt-6" />
          <Reveal>
            <p class="lede mt-(--stack-md) max-w-[44ch] text-charcoal/72">
              Our own team supervises each site rather than a subcontracted local crew, which
              is what makes the standard portable.
            </p>
          </Reveal>
        </div>

        <div class="grid gap-x-10 sm:grid-cols-2 md:col-span-5 md:col-start-8">
          {
            site.regions.map((region) => (
              <Reveal>
                <div class="border-t border-beige py-5">
                  <p class="label text-teal">{region.name}</p>
                  <p class="mt-2.5 text-micro text-charcoal/60">{region.cities.join(' · ')}</p>
                </div>
              </Reveal>
            ))
          }
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
