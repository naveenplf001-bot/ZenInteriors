---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import PageHero from '@components/sections/PageHero.astro';
import CTASection from '@components/sections/CTASection.astro';
import ProjectCard from '@components/projects/ProjectCard.astro';
import { getProjects, projectCategories } from '@lib/content';
import { slugify } from '@lib/format';
import { breadcrumbSchema } from '@lib/seo';

const projects = await getProjects();
const categories = projectCategories(projects);

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Projects', path: '/projects' },
  ]),
];
---

<BaseLayout
  title="Projects"
  description="Selected residences, villas, apartments and commercial interiors by Zen Interior across Tamil Nadu and Bangalore."
  schema={schema}
>
  <PageHero
    eyebrow="Selected Work"
    title="Spaces that hold their composure."
    lede="A selection of completed residences, villas and commercial interiors. Each began with a conversation about how the space would actually be used."
  />

  <Container class="pb-[--section-y]">
    {/*
      Category filter. Vanilla DOM filtering over already-rendered cards, so
      every project is in the HTML and indexable regardless of the active
      filter. No client-side routing, no framework.
    */}
    <div
      class="flex flex-wrap items-center gap-x-8 gap-y-4 border-y border-beige py-6"
      data-filter
      role="group"
      aria-label="Filter projects by category"
    >
      <button
        type="button"
        data-filter-value="all"
        aria-pressed="true"
        class="label text-teal/50 transition-colors duration-300 hover:text-teal aria-pressed:text-teal"
      >
        All
      </button>
      {
        categories.map((category) => (
          <button
            type="button"
            data-filter-value={slugify(category)}
            aria-pressed="false"
            class="label text-teal/50 transition-colors duration-300 hover:text-teal aria-pressed:text-teal"
          >
            {category}
          </button>
        ))
      }
      <p class="label ml-auto text-teal/30" data-filter-count aria-live="polite">
        {projects.length} Projects
      </p>
    </div>

    <div class="mt-16 grid gap-16 sm:grid-cols-2 sm:gap-10 lg:grid-cols-3 lg:gap-x-10 lg:gap-y-24">
      {
        projects.map((project, index) => (
          <div data-project-category={slugify(project.data.category)}>
            <ProjectCard
              project={project}
              index={index + 1}
              delay={(index % 3) * 90}
              priority={index === 0}
            />
          </div>
        ))
      }
    </div>

    <p class="label mt-20 hidden text-center text-teal/50" data-filter-empty>
      No projects in this category yet.
    </p>
  </Container>

  <CTASection />
</BaseLayout>

<script>
  const group = document.querySelector<HTMLElement>('[data-filter]');
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('[data-project-category]'),
  );
  const count = document.querySelector<HTMLElement>('[data-filter-count]');
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');

  if (group && cards.length > 0) {
    const buttons = Array.from(
      group.querySelectorAll<HTMLButtonElement>('[data-filter-value]'),
    );

    const apply = (value: string) => {
      let visible = 0;

      for (const card of cards) {
        const matches = value === 'all' || card.dataset.projectCategory === value;
        card.hidden = !matches;
        if (matches) visible += 1;
      }

      for (const button of buttons) {
        button.setAttribute(
          'aria-pressed',
          button.dataset.filterValue === value ? 'true' : 'false',
        );
      }

      if (count) {
        count.textContent = `${visible} ${visible === 1 ? 'Project' : 'Projects'}`;
      }
      if (empty) empty.classList.toggle('hidden', visible > 0);
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const value = button.dataset.filterValue ?? 'all';
        apply(value);
        // Keep the filter shareable and survivable across a back navigation.
        const url = new URL(window.location.href);
        value === 'all'
          ? url.searchParams.delete('category')
          : url.searchParams.set('category', value);
        window.history.replaceState({}, '', url);
      });
    }

    // Honour ?category= on load, so footer links deep-link into a filter.
    const initial = new URL(window.location.href).searchParams.get('category');
    if (initial && buttons.some((b) => b.dataset.filterValue === initial)) {
      apply(initial);
    }
  }
</script>
