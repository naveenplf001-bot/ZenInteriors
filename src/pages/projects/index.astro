---
import { Image } from 'astro:assets';

import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Reveal from '@components/ui/Reveal.astro';
import Button from '@components/ui/Button.astro';
import SplitHeading from '@components/ui/SplitHeading.astro';
import SectionNumber from '@components/ui/SectionNumber.astro';
import CTASection from '@components/sections/CTASection.astro';
import ProjectCard from '@components/projects/ProjectCard.astro';
import { getProjects, projectCategories } from '@lib/content';
import { slugify, pad, counter } from '@lib/format';
import { breadcrumbSchema } from '@lib/seo';

const projects = await getProjects();
const categories = projectCategories(projects);
const total = projects.length;

/*
  The lead is the first project flagged as featured, falling back to manual
  order. It is shown at full size before the index and it still appears in the
  index below, exactly as the homepage does: the index is the complete
  portfolio, so quietly dropping one project out of it to avoid a repeat would
  be the worse trade.
*/
const lead = projects.find((project) => project.data.featured) ?? projects[0];
const leadPosition = lead ? projects.indexOf(lead) + 1 : 1;

const leadFacts = lead
  ? [
      { label: 'Location', value: `${lead.data.location}, ${lead.data.region}` },
      { label: 'Typology', value: lead.data.category },
      { label: 'Year', value: String(lead.data.year) },
      { label: 'Scope', value: lead.data.scope },
    ]
  : [];

/* Per-category counts, so the filter row reads as a contents page. */
const categoryCounts = new Map(
  categories.map((category) => [
    category,
    projects.filter((project) => project.data.category === category).length,
  ]),
);

const regions = [...new Set(projects.map((project) => project.data.region))];
const years = projects.map((project) => project.data.year);
const earliest = years.length > 0 ? Math.min(...years) : new Date().getFullYear();

const stats = [
  { label: 'Completed', value: pad(total) },
  { label: 'Typologies', value: pad(categories.length) },
  { label: 'Regions', value: pad(regions.length) },
  { label: 'Since', value: String(earliest) },
];

/**
 * Grid rhythm.
 *
 * A repeating three-step figure rather than a uniform run of rectangles: a
 * wide frame, a portrait dropped below its baseline, then a half-width
 * portrait that leaves the right of the row open. Spans only — no explicit
 * column starts — so the composition still reflows correctly when the filter
 * hides half the cards.
 */
const layouts = [
  {
    span: 'sm:col-span-2 md:col-span-6 lg:col-span-8',
    ratio: 'wide' as const,
  },
  {
    span: 'md:col-span-3 lg:col-span-4 lg:mt-[--section-y-tight]',
    ratio: 'portrait' as const,
  },
  {
    span: 'md:col-span-3 lg:col-span-6',
    ratio: 'portrait' as const,
  },
];

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Projects', path: '/projects' },
  ]),
];
---

<BaseLayout
  title="Projects"
  description="Selected residences, villas, apartments and commercial interiors by Zen Interior across Tamil Nadu and Bangalore."
  schema={schema}
>
  {/* ------------------------------------------------------------- masthead */}
  <section class="bg-ivory">
    <Container class="pt-[clamp(3rem,6vw,6rem)] pb-[--section-y-tight]">
      <div class="grid gap-y-[--stack-md] md:grid-cols-12 md:items-end md:gap-x-10 lg:gap-x-16">
        <div class="md:col-span-7">
          <Reveal variant="fade">
            <SectionNumber value="01" />
          </Reveal>
          <Reveal variant="fade" class="mt-4">
            <Eyebrow>Selected Work</Eyebrow>
          </Reveal>
          <SplitHeading
            as="h1"
            size="xl"
            lines={['Spaces that hold', 'their composure.']}
            accentFrom={1}
            class="mt-6"
          />
        </div>

        <div class="md:col-span-5 md:col-start-8">
          <Reveal>
            <p class="lede max-w-[42ch] text-charcoal/72">
              A selection of completed residences, villas and commercial interiors. Each
              began with a conversation about how the space would actually be used.
            </p>
          </Reveal>
        </div>
      </div>

      {/* A title block, read the way a drawing sheet is read. */}
      <dl
        class="mt-[--stack-lg] grid grid-cols-2 gap-x-8 gap-y-8 sm:grid-cols-4 lg:gap-x-16"
        data-reveal-group="70"
      >
        {
          stats.map((stat) => (
            <Reveal variant="fade">
              <div class="border-t border-beige pt-4">
                <dt class="label text-teal/45">{stat.label}</dt>
                <dd class="mt-2.5 font-display text-display-sm text-teal">{stat.value}</dd>
              </div>
            </Reveal>
          ))
        }
      </dl>
    </Container>
  </section>

  {/* ----------------------------------------------------------- lead project */}
  {
    lead && (
      <section class="bg-stone">
        <Container class="section-tight">
          <div
            class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4"
            data-reveal-group
          >
            <div>
              <Reveal variant="fade">
                <SectionNumber value="02" />
              </Reveal>
              <Reveal variant="fade" class="mt-4">
                <Eyebrow>Featured Project</Eyebrow>
              </Reveal>
            </div>
            <Reveal variant="fade">
              <p class="label text-teal/40">{counter(leadPosition, total)}</p>
            </Reveal>
          </div>

          <div class="mt-[--stack-lg] grid gap-y-[--stack-md] lg:grid-cols-12 lg:items-center lg:gap-x-16">
            <Reveal variant="clip" class="lg:col-span-7">
              <a href={`/projects/${lead.id}`} class="group block focus-visible:outline-offset-8">
                <div class="aspect-[4/5] overflow-hidden rounded-zen bg-beige sm:aspect-[16/10] lg:aspect-[5/4]">
                  <Image
                    src={lead.data.cover}
                    alt={lead.data.coverAlt}
                    widths={[640, 1000, 1400, 1800]}
                    sizes="(min-width: 1024px) 56vw, 92vw"
                    loading="eager"
                    fetchpriority="high"
                    class="h-full w-full object-cover transition-transform duration-[1600ms] ease-[--ease-zen] group-hover:scale-[1.03]"
                  />
                </div>
              </a>
            </Reveal>

            <div class="lg:col-span-5 lg:col-start-8" data-reveal-group>
              <Reveal variant="fade">
                <p class="label text-teal/50">
                  {lead.data.location} &nbsp;/&nbsp; {lead.data.category}
                </p>
              </Reveal>

              <Reveal variant="fade" class="mt-5">
                <a
                  href={`/projects/${lead.id}`}
                  class="group block focus-visible:outline-offset-6"
                >
                  <h2 class="font-display text-display-lg text-teal transition-colors duration-500 group-hover:text-brass">
                    {lead.data.title}
                  </h2>
                </a>
              </Reveal>

              <Reveal>
                <p class="lede mt-6 max-w-[44ch] text-charcoal/72">{lead.data.summary}</p>
              </Reveal>

              <dl class="mt-[--stack-md] grid grid-cols-2 gap-x-8 gap-y-6">
                {leadFacts.map((fact) => (
                  <Reveal variant="fade">
                    <div class="border-t border-beige pt-4">
                      <dt class="label text-teal/45">{fact.label}</dt>
                      <dd class="mt-2.5 text-small text-charcoal/75">{fact.value}</dd>
                    </div>
                  </Reveal>
                ))}
              </dl>

              <Reveal variant="fade" class="mt-9">
                <Button href={`/projects/${lead.id}`} variant="outline">
                  View Project
                </Button>
              </Reveal>
            </div>
          </div>
        </Container>
      </section>
    )
  }

  {/* ---------------------------------------------------------------- index */}
  <section class="bg-ivory">
    <Container class="pt-[--section-y] pb-[--stack-md]">
      <div class="grid gap-y-[--stack-md] md:grid-cols-12 md:items-end md:gap-x-10 lg:gap-x-16">
        <div class="md:col-span-7">
          <Reveal variant="fade">
            <SectionNumber value="03" />
          </Reveal>
          <Reveal variant="fade" class="mt-4">
            <Eyebrow>The Index</Eyebrow>
          </Reveal>
          <SplitHeading lines={['Every project,', 'in full.']} size="lg" class="mt-6" />
        </div>

        <div class="md:col-span-5 md:col-start-8">
          <Reveal>
            <p class="max-w-[40ch] text-small text-charcoal/65">
              Filter by typology to see how a single approach behaves across a private
              residence, a villa and a working commercial floor.
            </p>
          </Reveal>
        </div>
      </div>
    </Container>

    {/*
      Category filter. Vanilla DOM filtering over already-rendered cards, so
      every project is in the HTML and indexable regardless of the active
      filter. No client-side routing, no framework.

      It sticks under the fixed header, because a filter that scrolls away is
      only useful for as long as the first row of results.
    */}
    <div
      class="sticky top-[--header-h] z-[40] border-y border-beige bg-ivory/92 backdrop-blur-md"
    >
      <Container class="py-4">
        <div
          class="flex flex-wrap items-center gap-x-2.5 gap-y-2.5"
          data-filter
          role="group"
          aria-label="Filter projects by category"
        >
          <button
            type="button"
            data-filter-value="all"
            aria-pressed="true"
            class="label rounded-zen border border-beige px-4 py-2.5 text-teal/55 transition-colors duration-300 hover:border-teal/45 hover:text-teal aria-pressed:border-teal aria-pressed:bg-teal aria-pressed:text-ivory"
          >
            All
            <span class="ml-2 opacity-50" aria-hidden="true">{pad(total)}</span>
          </button>

          {
            categories.map((category) => (
              <button
                type="button"
                data-filter-value={slugify(category)}
                aria-pressed="false"
                class="label rounded-zen border border-beige px-4 py-2.5 text-teal/55 transition-colors duration-300 hover:border-teal/45 hover:text-teal aria-pressed:border-teal aria-pressed:bg-teal aria-pressed:text-ivory"
              >
                {category}
                <span class="ml-2 opacity-50" aria-hidden="true">
                  {pad(categoryCounts.get(category) ?? 0)}
                </span>
              </button>
            ))
          }

          <p
            class="label w-full pt-1 text-teal/35 sm:ml-auto sm:w-auto sm:pt-0"
            data-filter-count
            aria-live="polite"
          >
            {total} Projects
          </p>
        </div>
      </Container>
    </div>

    <Container class="pt-[--stack-lg] pb-[--section-y]">
      <div
        class="grid grid-cols-1 items-start gap-x-8 gap-y-14 sm:grid-cols-2 md:grid-cols-6 md:gap-x-10 md:gap-y-16 lg:grid-cols-12 lg:gap-y-24"
      >
        {
          projects.map((project, index) => {
            const layout = layouts[index % layouts.length]!;
            return (
              <div
                data-project-category={slugify(project.data.category)}
                class:list={[layout.span]}
              >
                <ProjectCard
                  project={project}
                  index={index + 1}
                  ratio={layout.ratio}
                  delay={(index % 3) * 90}
                />
              </div>
            );
          })
        }
      </div>

      <p class="label mt-20 hidden text-center text-teal/50" data-filter-empty>
        No projects in this category yet.
      </p>
    </Container>
  </section>

  <CTASection />
</BaseLayout>

<script>
  const group = document.querySelector<HTMLElement>('[data-filter]');
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('[data-project-category]'),
  );
  const count = document.querySelector<HTMLElement>('[data-filter-count]');
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');

  if (group && cards.length > 0) {
    const buttons = Array.from(
      group.querySelectorAll<HTMLButtonElement>('[data-filter-value]'),
    );

    const apply = (value: string) => {
      let visible = 0;

      for (const card of cards) {
        const matches = value === 'all' || card.dataset.projectCategory === value;
        card.hidden = !matches;
        if (matches) visible += 1;
      }

      for (const button of buttons) {
        button.setAttribute(
          'aria-pressed',
          button.dataset.filterValue === value ? 'true' : 'false',
        );
      }

      if (count) {
        count.textContent = `${visible} ${visible === 1 ? 'Project' : 'Projects'}`;
      }
      if (empty) empty.classList.toggle('hidden', visible > 0);
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const value = button.dataset.filterValue ?? 'all';
        apply(value);
        // Keep the filter shareable and survivable across a back navigation.
        const url = new URL(window.location.href);
        value === 'all'
          ? url.searchParams.delete('category')
          : url.searchParams.set('category', value);
        window.history.replaceState({}, '', url);
      });
    }

    // Honour ?category= on load, so footer links deep-link into a filter.
    const initial = new URL(window.location.href).searchParams.get('category');
    if (initial && buttons.some((b) => b.dataset.filterValue === initial)) {
      apply(initial);
    }
  }
</script>
