---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Reveal from '@components/ui/Reveal.astro';
import Button from '@components/ui/Button.astro';
import SplitHeading from '@components/ui/SplitHeading.astro';
import ProjectCard from '@components/projects/ProjectCard.astro';

import { getArticles, getProjects } from '@lib/content';
import { articleSchema, breadcrumbSchema } from '@lib/seo';
import { formatDate, readingTime } from '@lib/format';

/**
 * The article template.
 *
 * Reading comfort outranks decoration here. Everything above the body is
 * staged — a dark header band with the cover photograph lifted up across its
 * lower edge — and then the page hands over to a single narrow column of
 * text and stops interrupting it. The body stays at the reading measure with
 * `.prose-zen` doing all of the work.
 */

export const getStaticPaths = (async () => {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}) satisfies GetStaticPaths;

const { article } = Astro.props;
const {
  title,
  excerpt,
  category,
  cover,
  coverAlt,
  publishedAt,
  updatedAt,
  author,
  relatedProjects,
} = article.data;

const { Content } = await render(article);

const minutes = readingTime(article.body ?? '');

// Resolve the related project references against the published project list.
const projects = await getProjects();
const related = relatedProjects
  .map((ref) => projects.find((project) => project.id === ref.id))
  .filter((project): project is (typeof projects)[number] => Boolean(project));

/*
  Adjacent articles, in published order. Not wrapped: the newest article has
  nothing newer, and pretending otherwise sends the reader in a circle.
*/
const articles = await getArticles();
const position = articles.findIndex((entry) => entry.id === article.id);
const newer = position > 0 ? articles[position - 1] : undefined;
const older =
  position > -1 && position < articles.length - 1 ? articles[position + 1] : undefined;

/*
  One related project reads better as a wide editorial frame than as a lone
  portrait card stranded in a three-column grid.
*/
const relatedSolo = related.length === 1;
const relatedGrid = relatedSolo
  ? 'lg:grid-cols-2'
  : related.length === 2
    ? 'sm:grid-cols-2'
    : 'sm:grid-cols-2 lg:grid-cols-3';

const meta = [
  { label: 'Published', value: formatDate(publishedAt), time: publishedAt },
  ...(updatedAt ? [{ label: 'Updated', value: formatDate(updatedAt), time: updatedAt }] : []),
  { label: 'Written by', value: author, time: undefined },
  { label: 'Reading time', value: `${minutes} min`, time: undefined },
];

const path = `/journal/${article.id}`;

const schema = [
  articleSchema({
    title,
    description: excerpt.trim(),
    path,
    publishedAt,
    author,
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Journal', path: '/journal' },
    { name: title, path },
  ]),
];
---

<BaseLayout
  title={title}
  description={excerpt.trim().slice(0, 200)}
  type="article"
  publishedTime={publishedAt.toISOString()}
  schema={schema}
>
  {/* Reading progress, a brass hairline under the header. */}
  <div
    class="pointer-events-none fixed inset-x-0 top-(--header-h) z-[49] h-[2px]"
    aria-hidden="true"
  >
    <span
      class="block h-full origin-left bg-brass"
      style="transform: scaleX(0)"
      data-progress></span>
  </div>

  <article data-article>
    {/*
      Dark header band. The padding at the bottom is deliberately deep: the
      cover photograph is pulled back up into it below, so this measurement
      and the negative margin on the figure are a pair.
    */}
    <header class="zen-article-head bg-teal text-ivory on-dark" data-article-head>
      <Container width="narrow" class="pt-[clamp(2.5rem,5vw,4.5rem)] pb-[clamp(6.5rem,13vw,12rem)]">
        <div data-reveal-group>
          <Reveal variant="fade">
            <a
              href="/journal"
              class="label inline-flex items-center gap-3 text-brass-soft transition-colors duration-300 hover:text-ivory focus-visible:outline-offset-4"
            >
              <span aria-hidden="true">&#8592;</span>
              The Journal
            </a>
          </Reveal>

          <Reveal variant="fade" class="mt-9">
            <Eyebrow tone="inverse">{category}</Eyebrow>
          </Reveal>

          <Reveal>
            <h1 class="mt-6 max-w-[18ch] font-display text-display-xl text-ivory">{title}</h1>
          </Reveal>

          <Reveal>
            <p class="lede mt-8 max-w-[54ch] text-ivory/75">{excerpt}</p>
          </Reveal>

          <Reveal variant="fade" class="mt-(--stack-md)">
            <dl class="grid grid-cols-2 gap-x-8 gap-y-6 border-t border-ivory/15 pt-7 sm:grid-cols-4">
              {
                meta.map((item) => (
                  <div>
                    <dt class="label text-ivory/55">{item.label}</dt>
                    <dd class="mt-2.5 text-small text-ivory/88">
                      {item.time ? (
                        <time datetime={item.time.toISOString()}>{item.value}</time>
                      ) : (
                        item.value
                      )}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </Reveal>
        </div>
      </Container>
    </header>

    {/*
      The cover straddles the boundary between the header and the page, which
      is what stops the article opening as two stacked blocks. Portrait on a
      phone, landscape once there is width for it.
    */}
    <Container class="zen-article-cover relative z-[1] mt-[calc(clamp(4.5rem,9.5vw,9rem)*-1)]">
      <Reveal variant="clip">
        <figure class="overflow-hidden rounded-zen bg-stone">
          <div class="aspect-square sm:aspect-[3/2] lg:aspect-[16/9]">
            <div class="zen-parallax h-full w-full">
              <Image
                src={cover}
                alt={coverAlt}
                widths={[768, 1280, 1600, 2000]}
                sizes="92vw"
                loading="eager"
                fetchpriority="high"
                class="h-full w-full object-cover"
              />
            </div>
          </div>
        </figure>
      </Reveal>
    </Container>

    {/* ---------------------------------------------------------------- body */}
    <Container width="reading" class="pt-(--section-y-tight) pb-(--section-y-tight)">
      <div class="prose-zen zen-prose">
        <Content />
      </div>

      <footer class="mt-(--stack-lg) border-t border-beige pt-7">
        <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3">
          <p class="label text-teal/62">{author}</p>
          <p class="label text-teal/50">
            {category} &nbsp;·&nbsp; <time datetime={publishedAt.toISOString()}>
              {formatDate(publishedAt)}
            </time>
          </p>
        </div>
      </footer>
    </Container>

    {/* ------------------------------------------------------ newer / older */}
    {
      (newer || older) && (
        <nav aria-label="More from the journal" class="bg-ivory">
          <Container class="pb-(--section-y)">
            <div class="grid border-t border-beige sm:grid-cols-2" data-reveal-group>
              {newer && (
                <Reveal variant="fade" class="border-b border-beige sm:border-b-0 sm:border-r sm:pr-10">
                  <a
                    href={`/journal/${newer.id}`}
                    class="group block py-8 focus-visible:outline-offset-4 sm:py-10 max-sm:py-6"
                  >
                    <p class="label flex items-center gap-3 text-teal/60 transition-colors duration-300 group-hover:text-brass">
                      <span aria-hidden="true">&#8592;</span>
                      Newer Article
                    </p>
                    <p class="mt-4 max-w-[24ch] font-display text-display-sm text-teal transition-colors duration-300 group-hover:text-brass">
                      {newer.data.title}
                    </p>
                  </a>
                </Reveal>
              )}

              {older && (
                <Reveal
                  variant="fade"
                  class:list={[
                    'sm:pl-10',
                    newer ? '' : 'sm:col-start-2 sm:border-l sm:border-beige',
                  ]}
                >
                  <a
                    href={`/journal/${older.id}`}
                    class="group block py-8 focus-visible:outline-offset-4 sm:py-10 sm:text-right max-sm:py-6"
                  >
                    <p class="label flex items-center gap-3 text-teal/60 transition-colors duration-300 group-hover:text-brass sm:justify-end">
                      Older Article
                      <span aria-hidden="true">&#8594;</span>
                    </p>
                    <p class="mt-4 max-w-[24ch] font-display text-display-sm text-teal transition-colors duration-300 group-hover:text-brass sm:ml-auto">
                      {older.data.title}
                    </p>
                  </a>
                </Reveal>
              )}
            </div>
          </Container>
        </nav>
      )
    }
  </article>

  {/* ------------------------------------------------------------- related */}
  {
    related.length > 0 && (
      <section class="bg-stone">
        <Container class="section-tight">
          <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-8" data-reveal-group>
            <div>
              <Reveal variant="fade">
                <Eyebrow>Related Work</Eyebrow>
              </Reveal>

              <SplitHeading
                lines={['The same thinking,', 'already built.']}
                accentFrom={1}
                class="mt-6"
              />
            </div>

            <Reveal variant="fade">
              <Button href="/projects" variant="link">All Projects</Button>
            </Reveal>
          </div>

          <div
            class:list={['mt-(--stack-lg) grid gap-x-10 gap-y-14', relatedGrid]}
            data-reveal-group
          >
            {related.map((project) => (
              <ProjectCard project={project} ratio={relatedSolo ? 'wide' : 'portrait'} />
            ))}
          </div>
        </Container>
      </section>
    )
  }
</BaseLayout>

<script>
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Reading progress across the article, header to last paragraph. */
  const article = document.querySelector<HTMLElement>('[data-article]');
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  if (article && bar) {
    let frame = 0;
    const update = () => {
      frame = 0;
      const rect = article.getBoundingClientRect();
      const distance = rect.height - window.innerHeight;
      const progress = distance > 0 ? Math.min(Math.max(-rect.top / distance, 0), 1) : 1;
      bar.style.transform = `scaleX(${progress})`;
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    update();
  }

  /* The header and cover are on the first screen, so they play an entrance of their own. */
  if (article && !calm) {
    article
      .querySelectorAll<HTMLElement>('[data-article-head] [data-reveal]')
      .forEach((el, index) => el.style.setProperty('--intro', `${100 + index * 90}ms`));
    article.setAttribute('data-intro', '');
  }
</script>

<style>
  @media (prefers-reduced-motion: no-preference) {
    [data-article][data-intro] .zen-article-head :global([data-reveal]) {
      animation: zen-a-rise 1100ms var(--ease-zen-out) var(--intro, 0ms) both;
    }

    [data-article][data-intro] :global(.zen-article-cover [data-reveal='clip']) {
      animation: zen-a-clip 1300ms var(--ease-zen-out) 450ms both;
    }

    [data-article][data-intro] :global(.zen-article-cover [data-reveal='clip'] img) {
      animation: zen-a-settle 1900ms var(--ease-zen-out) 450ms both;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .zen-parallax {
        scale: 1.06;
        animation: zen-a-parallax linear both;
        animation-timeline: view();
        animation-range: cover;
      }

      /* Headings, quotes and images ease in as they reach the reader. Body
         paragraphs never move: reading comes first. */
      .zen-prose > :global(h2),
      .zen-prose > :global(blockquote),
      .zen-prose > :global(figure),
      .zen-prose :global(img) {
        animation: zen-a-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 70%;
      }
    }
  }

  /* ------------------------------------------------------------ phone only */
  @media (width < 40rem) {
    .zen-prose {
      font-size: 1.0625rem;
      line-height: 1.8;
    }

    .zen-prose > :global(h2) {
      font-size: 1.625rem;
      line-height: 1.18;
      margin-block-start: 2em;
      margin-block-end: -0.25em;
    }

    .zen-prose > :global(blockquote) {
      font-size: 1.375rem;
      line-height: 1.35;
      padding-inline-start: 1.1rem;
      margin-block: 2em;
    }

    .zen-article-head :global(.lede) {
      font-size: 1rem;
      line-height: 1.75;
    }
  }

  @keyframes zen-a-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 1.5rem, 0);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }

  @keyframes zen-a-clip {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes zen-a-settle {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1);
    }
  }

  @keyframes zen-a-parallax {
    from {
      translate: 0 -3%;
    }
    to {
      translate: 0 3%;
    }
  }

  @keyframes zen-a-in {
    from {
      opacity: 0;
      translate: 0 1.25rem;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
