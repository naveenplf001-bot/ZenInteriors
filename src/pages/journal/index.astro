---
import { Image } from 'astro:assets';

import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Reveal from '@components/ui/Reveal.astro';
import Button from '@components/ui/Button.astro';
import SplitHeading from '@components/ui/SplitHeading.astro';
import SectionNumber from '@components/ui/SectionNumber.astro';
import ArticleCard from '@components/journal/ArticleCard.astro';

import mastheadBg from '@/assets/images/journal/masthead.jpg';

import { getArticles } from '@lib/content';
import { formatDate, pad, readingTime, slugify } from '@lib/format';
import { breadcrumbSchema } from '@lib/seo';

/**
 * Called the Journal, not the Blog. The word does most of the positioning
 * work on its own, and the articles are written to demonstrate expertise
 * rather than to chase keywords.
 *
 * Laid out as a magazine contents page rather than a blog roll:
 *
 *   masthead → cover story → the index
 *
 * The cover story is the newest article given a full dark band of its own,
 * because a uniform grid gives the reader no reason to start anywhere in
 * particular. The index below then lists everything, the cover story
 * included, which is the same convention a printed contents page follows and
 * the same one the portfolio index on the homepage uses.
 */

const articles = await getArticles();
const lead = articles[0];

/*
  Categories in the order they first appear, so the filter row reads as a
  reflection of what has actually been written rather than as the full enum
  from the schema, most of which may have nothing behind it yet.
*/
const categories = [...new Set(articles.map((article) => article.data.category))];

/* Counted per subject, so the contents strip states what has actually been
   written rather than the full enum from the schema. */
const categoryCounts = categories.map((category) => ({
  name: category,
  count: articles.filter((article) => article.data.category === category).length,
}));

const total = articles.length;
const latest = lead ? formatDate(lead.data.publishedAt) : '';

/* Line icons, drawn inline rather than pulled from a set, so the masthead
   carries no icon dependency for three 18px marks. */
const icons = {
  article:
    '<svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M4 1.5h6.5L14 5v11.5H4z"/><path d="M10.5 1.5V5H14M6.5 8.5h5M6.5 11.5h5"/></svg>',
  subject:
    '<svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M2.5 2.5h5v5h-5zM10.5 2.5h5v5h-5zM2.5 10.5h5v5h-5zM10.5 10.5h5v5h-5z"/></svg>',
  latest:
    '<svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M2.5 3.5h13v12h-13zM2.5 7h13M6 1.5v3M12 1.5v3"/></svg>',
};

const issueFacts = [
  { label: 'Articles', value: pad(total), icon: icons.article },
  { label: 'Subjects', value: pad(categories.length), icon: icons.subject },
  { label: 'Latest', value: latest, icon: icons.latest },
];

/*
  A three-step rhythm across the index, so no two rows of the grid are
  measured the same. The wide slot takes the feature frame, which is a
  different crop and a larger heading, not just a wider column.
*/
const rhythm = (index: number) => {
  switch (index % 3) {
    case 0:
      return { span: 'md:col-span-7', variant: 'feature' as const };
    case 1:
      return { span: 'md:col-span-5 md:mt-(--stack-lg)', variant: 'default' as const };
    default:
      return { span: 'md:col-span-6 md:col-start-4', variant: 'default' as const };
  }
};

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Journal', path: '/journal' },
  ]),
];
---

<BaseLayout
  title="Journal"
  description="Writing on materials, craft, sourcing and considered interior design from the studio at Zen Interior."
  schema={schema}
>
  {/* ------------------------------------------------------------ masthead */}
  {/*
    Set as a printed masthead on the studio's own plaster: a dateline rule
    across the top, the title with the second line in italic brass, the issue
    figures held beside it, and the subjects as a contents strip along the foot.

    The photograph is the ground rather than a panel. A wash carries the left
    two thirds so the type sits on plaster, and the frame is anchored right so
    the plinth and the branch survive every crop. Below lg the wash covers the
    full width, because at that size there is no clear plaster left.

    Every figure is counted from the articles themselves, so the masthead
    cannot advertise a subject with nothing behind it.
  */}
  <section class="zen-masthead relative isolate overflow-hidden bg-ivory" data-masthead>
    <Image
      src={mastheadBg}
      alt=""
      aria-hidden="true"
      widths={[900, 1400, 1969]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="zen-masthead__bg absolute inset-0 -z-20 h-full w-full object-cover object-[80%_center] lg:object-right"
    />

    <div
      class="absolute inset-0 -z-10 bg-gradient-to-r from-ivory via-ivory/92 to-ivory/65 lg:via-ivory/85 lg:to-transparent"
      aria-hidden="true"
    >
    </div>

    <Container class="pt-[clamp(2.25rem,4vw,4rem)] pb-(--section-y-tight)">
      {/* ------------------------------------------------------- the dateline */}
      <Reveal variant="fade">
        <div class="flex items-center gap-6">
          <p class="label shrink-0 text-teal/80">The Zen Journal</p>
          <span class="h-px flex-1 bg-teal/20" aria-hidden="true"></span>
          <p class="label hidden shrink-0 text-teal/55 sm:block">Written from the studio</p>
        </div>
      </Reveal>

      <div
        class="mt-[clamp(2.5rem,5vw,5rem)] grid gap-y-12 lg:grid-cols-12 lg:gap-x-12"
        data-reveal-group
      >
        {/* -------------------------------------------------------- the title */}
        <div class="lg:col-span-6">
          <SplitHeading
            as="h1"
            size="xl"
            lines={['Notes on material,', 'proportion and craft.']}
            accentFrom={1}
            accentItalic
          />

          <Reveal variant="line">
            <span class="mt-8 block h-px w-16 origin-left bg-brass" aria-hidden="true"></span>
          </Reveal>

          <Reveal>
            <p class="lede mt-8 max-w-[42ch] text-charcoal/82">
              What we have learned building interiors that have to hold up close, and what
              we think is worth knowing before you commission one.
            </p>
          </Reveal>
        </div>

        {/* ------------------------------------------------------ the figures */}
        {/* Held beside the title rather than under the standfirst, so the band
            resolves as one spread instead of two stacked blocks. */}
        <div class="lg:col-span-5 lg:col-start-8">
          <dl class="grid grid-cols-3 gap-x-2 sm:gap-x-6 max-sm:grid-cols-2 max-sm:gap-3" data-reveal-group="60">
            {
              issueFacts.map((fact, index) => (
                <Reveal
                  variant="fade"
                  class:list={[
                    'max-sm:rounded-zen max-sm:border max-sm:border-teal/12 max-sm:bg-ivory-warm/75 max-sm:p-4',
                    index > 0 && 'sm:border-l sm:border-teal/15 sm:pl-6',
                    index === issueFacts.length - 1 && 'max-sm:col-span-2',
                  ]}
                >
                  <span class="block text-brass" aria-hidden="true" set:html={fact.icon} />
                  <dt class="label mt-4 text-teal/62">{fact.label}</dt>
                  <dd
                    class="mt-3 font-display text-[clamp(1.25rem,1rem+0.9vw,1.875rem)] leading-[1.25] text-teal max-sm:mt-2 max-sm:text-[1.5rem]"
                    data-count={/^\d+$/.test(fact.value) ? fact.value : undefined}
                  >
                    {fact.value}
                  </dd>
                </Reveal>
              ))
            }
          </dl>
        </div>
      </div>

      {/* ------------------------------------------------------ the contents */}
      <Reveal variant="fade" class="mt-[clamp(2.5rem,4.5vw,4rem)] lg:max-w-[58%]">
        <div class="zen-subjects flex flex-wrap items-baseline gap-x-8 gap-y-3 border-b border-teal/15 pb-4">
          <p class="label shrink-0 text-teal/60">Subjects</p>
          {
            categoryCounts.map((subject) => (
              <p class="group flex items-baseline gap-2.5">
                <span class="font-display text-[clamp(1rem,0.92rem+0.35vw,1.25rem)] text-teal">
                  {subject.name}
                </span>
                <span class="label text-teal/55">{pad(subject.count)}</span>
              </p>
            ))
          }
        </div>
      </Reveal>
    </Container>
  </section>

  {/* --------------------------------------------------------- cover story */}
  {
    lead && (
      <section class="bg-teal text-ivory on-dark">
        <Container class="section-tight">
          <div
            class="grid gap-y-(--stack-md) lg:grid-cols-12 lg:items-center lg:gap-x-16"
            data-reveal-group
          >
            <div class="lg:col-span-7">
              <Reveal variant="clip">
                <a
                  href={`/journal/${lead.id}`}
                  class="group block focus-visible:outline-offset-4"
                  tabindex="-1"
                  aria-hidden="true"
                >
                  <div class="aspect-[5/4] overflow-hidden rounded-zen bg-teal-deep sm:aspect-[16/10] lg:aspect-[4/3]">
                    <div class="zen-parallax h-full w-full">
                    <Image
                      src={lead.data.cover}
                      alt=""
                      widths={[480, 800, 1200, 1600]}
                      sizes="(min-width: 1024px) 56vw, 92vw"
                      loading="eager"
                      fetchpriority="high"
                      class="h-full w-full object-cover transition-transform duration-[1600ms] ease-(--ease-zen) group-hover:scale-[1.03]"
                    />
                    </div>
                  </div>
                </a>
              </Reveal>
            </div>

            <div class="lg:col-span-5">
              <Reveal variant="fade">
                <SectionNumber value="01" tone="dark" />
              </Reveal>

              <Reveal variant="fade" class="mt-4">
                <Eyebrow tone="inverse">Cover Story &nbsp;/&nbsp; {lead.data.category}</Eyebrow>
              </Reveal>

              <Reveal>
                <h2 class="mt-6 font-display text-display-lg text-ivory">
                  <a
                    href={`/journal/${lead.id}`}
                    class="transition-colors duration-500 hover:text-brass-soft focus-visible:outline-offset-4"
                  >
                    {lead.data.title}
                  </a>
                </h2>
              </Reveal>

              <Reveal>
                <p class="lede mt-6 max-w-[46ch] text-ivory/75 max-sm:line-clamp-6">{lead.data.excerpt}</p>
              </Reveal>

              <Reveal variant="fade" class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4 max-sm:[&>a]:w-full max-sm:[&>a]:justify-center">
                <Button href={`/journal/${lead.id}`} variant="outline" tone="dark">
                  Read the Article
                </Button>
                <p class="label text-ivory/60">
                  <time datetime={lead.data.publishedAt.toISOString()}>
                    {formatDate(lead.data.publishedAt)}
                  </time>
                  &nbsp;·&nbsp; {readingTime(lead.body ?? '')} Min Read
                </p>
              </Reveal>
            </div>
          </div>
        </Container>
      </section>
    )
  }

  {/* --------------------------------------------------------------- index */}
  <section class="bg-ivory">
    <Container class="section">
      <div data-reveal-group>
        <Reveal variant="fade">
          <SectionNumber value="02" />
        </Reveal>

        <Reveal variant="fade" class="mt-4">
          <Eyebrow>The Index</Eyebrow>
        </Reveal>

        <SplitHeading
          lines={['Everything we have', 'written, in order.']}
          accentFrom={1}
          class="mt-6"
        />
      </div>

      {/*
        Category filter. Vanilla DOM filtering over already-rendered cards, so
        every article is in the HTML and indexable regardless of the active
        filter. No client-side routing, no framework.
      */}
      <div
        class="zen-filter mt-(--stack-lg) flex flex-wrap items-center gap-x-8 gap-y-4 border-y border-beige py-6"
        data-journal-filter
        role="group"
        aria-label="Filter articles by subject"
      >
        <button
          type="button"
          data-filter-value="all"
          aria-pressed="true"
          class="zen-filter__btn label text-teal/65 transition-colors duration-300 hover:text-teal aria-pressed:text-teal"
        >
          All
        </button>
        {
          categories.map((category) => (
            <button
              type="button"
              data-filter-value={slugify(category)}
              aria-pressed="false"
              class="zen-filter__btn label text-teal/65 transition-colors duration-300 hover:text-teal aria-pressed:text-teal"
            >
              {category}
            </button>
          ))
        }
        <p class="label ml-auto text-teal/50" data-filter-count aria-live="polite">
          {total} {total === 1 ? 'Article' : 'Articles'}
        </p>
      </div>

      {/*
        Deliberately not a uniform grid. Twelve columns from the medium
        breakpoint up, two even columns on small tablets, one on a phone.
      */}
      <div
        class="mt-(--stack-lg) grid gap-x-10 gap-y-16 sm:grid-cols-2 sm:gap-y-20 md:grid-cols-12 md:gap-x-12 md:gap-y-24"
        data-reveal-group
      >
        {
          articles.map((article, index) => {
            const slot = rhythm(index);

            return (
              <div
                class:list={[slot.span]}
                data-article-category={slugify(article.data.category)}
              >
                <Reveal variant="fade" class="mb-5 flex items-center gap-4">
                  <span class="label text-teal/50" aria-hidden="true">
                    {pad(index + 1)}
                  </span>
                  <span class="h-px flex-1 bg-beige" aria-hidden="true" />
                </Reveal>

                <ArticleCard article={article} variant={slot.variant} enhance />
              </div>
            );
          })
        }
      </div>

      <p class="label mt-20 hidden text-center text-teal/65" data-filter-empty>
        Nothing on this subject yet.
      </p>
    </Container>
  </section>
</BaseLayout>

<script>
  /**
   * Subject filter for the journal index.
   *
   * Same contract as the projects filter: every article is already in the
   * document, the buttons only toggle visibility, and the active subject is
   * written into the query string so a filtered view can be shared and
   * survives a back navigation.
   */
  const group = document.querySelector<HTMLElement>('[data-journal-filter]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-article-category]'));
  const count = document.querySelector<HTMLElement>('[data-filter-count]');
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (group && cards.length > 0) {
    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-filter-value]'));

    const apply = (value: string, animate = false) => {
      let visible = 0;

      for (const card of cards) {
        const matches = value === 'all' || card.dataset.articleCategory === value;
        card.hidden = !matches;
        if (matches) {
          // Cards that stay or return rise back in, one after another.
          if (animate && !calm) {
            card.animate(
              [
                { opacity: 0, transform: 'translate3d(0, 1rem, 0)' },
                { opacity: 1, transform: 'none' },
              ],
              { duration: 700, delay: visible * 80, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'backwards' },
            );
          }
          visible += 1;
        }
      }

      for (const button of buttons) {
        button.setAttribute(
          'aria-pressed',
          button.dataset.filterValue === value ? 'true' : 'false',
        );
      }

      if (count) {
        count.textContent = `${visible} ${visible === 1 ? 'Article' : 'Articles'}`;
      }
      if (empty) empty.classList.toggle('hidden', visible > 0);
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const value = button.dataset.filterValue ?? 'all';
        apply(value, true);
        const url = new URL(window.location.href);
        if (value === 'all') url.searchParams.delete('subject');
        else url.searchParams.set('subject', value);
        window.history.replaceState({}, '', url);
      });
    }

    // Honour ?subject= on load, so a link can deep-link into a filter.
    const initial = new URL(window.location.href).searchParams.get('subject');
    if (initial && buttons.some((button) => button.dataset.filterValue === initial)) {
      apply(initial);
    }
  }

  /*
    The masthead is on the first screen, where the reveal system shows content
    at once. It plays its own entrance instead, and the figures count up.
  */
  const masthead = document.querySelector<HTMLElement>('[data-masthead]');
  if (masthead && !calm) {
    masthead
      .querySelectorAll<HTMLElement>('[data-reveal]')
      .forEach((el, index) => el.style.setProperty('--intro', `${100 + index * 90}ms`));
    masthead.setAttribute('data-intro', '');

    masthead.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const target = Number(el.dataset.count);
      const width = el.dataset.count?.length ?? 2;
      const start = performance.now() + 700;
      const tick = (now: number) => {
        const t = Math.min(Math.max((now - start) / 1300, 0), 1);
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 3)))).padStart(width, '0');
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }
</script>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .zen-masthead[data-intro]
      :global([data-reveal]:not([data-reveal='mask']):not([data-reveal='line'])) {
      animation: zen-j-rise 1100ms var(--ease-zen-out) var(--intro, 0ms) both;
    }

    .zen-masthead[data-intro] :global([data-reveal='mask']) {
      animation: zen-j-mask 1200ms var(--ease-zen-out) var(--intro, 0ms) both;
    }

    .zen-masthead[data-intro] :global([data-reveal='line']) {
      transform-origin: left center;
      animation: zen-j-line 1100ms var(--ease-zen-out) var(--intro, 0ms) both;
    }

    .zen-masthead__bg {
      animation: zen-j-drift 28s ease-in-out infinite alternate;
    }
  }

  /* Scroll-linked drift on the cover story photograph, where supported. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .zen-parallax {
        scale: 1.08;
        animation: zen-j-parallax linear both;
        animation-timeline: view();
        animation-range: cover;
      }
    }
  }

  /* A hairline draws under a subject on hover. */
  @media (hover: hover) and (width >= 40rem) {
    .zen-filter__btn {
      position: relative;
    }

    .zen-filter__btn::after {
      content: '';
      position: absolute;
      inset-inline: 0;
      bottom: -0.5rem;
      height: 1px;
      background: var(--color-brass);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 500ms var(--ease-zen);
    }

    .zen-filter__btn:hover::after {
      transform: scaleX(1);
    }
  }

  /* ------------------------------------------------------------ phone only */
  @media (width < 40rem) {
    .zen-subjects {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-inline-end: 2rem;
      scrollbar-width: none;
      mask-image: linear-gradient(90deg, #000 calc(100% - 2.5rem), transparent);
    }

    .zen-subjects::-webkit-scrollbar {
      display: none;
    }

    .zen-subjects > p {
      flex-shrink: 0;
    }

    .zen-filter {
      flex-wrap: nowrap;
      gap: 0.5rem;
      overflow-x: auto;
      padding-block: 1rem;
      scrollbar-width: none;
      mask-image: linear-gradient(90deg, #000 calc(100% - 2.5rem), transparent);
    }

    .zen-filter::-webkit-scrollbar {
      display: none;
    }

    .zen-filter__btn {
      flex-shrink: 0;
      padding: 0.75rem 1.1rem;
      border: 1px solid var(--color-beige);
      border-radius: 9999px;
      transition:
        background-color 400ms var(--ease-zen),
        border-color 400ms var(--ease-zen),
        color 400ms var(--ease-zen);
    }

    .zen-filter__btn[aria-pressed='true'] {
      background: var(--color-teal);
      border-color: var(--color-teal);
      color: var(--color-ivory);
    }

    .zen-filter [data-filter-count] {
      flex-shrink: 0;
      padding-inline: 0.5rem 2rem;
    }
  }

  @keyframes zen-j-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 1.5rem, 0);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }

  @keyframes zen-j-mask {
    from {
      transform: translate3d(0, 110%, 0);
    }
    to {
      transform: none;
    }
  }

  @keyframes zen-j-line {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes zen-j-drift {
    from {
      transform: scale(1.03) translate3d(-0.8%, 0, 0);
    }
    to {
      transform: scale(1.07) translate3d(1.2%, -0.8%, 0);
    }
  }

  @keyframes zen-j-parallax {
    from {
      translate: 0 -3.5%;
    }
    to {
      translate: 0 3.5%;
    }
  }
</style>
