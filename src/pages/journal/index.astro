---
import { Image } from 'astro:assets';

import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Reveal from '@components/ui/Reveal.astro';
import Button from '@components/ui/Button.astro';
import SplitHeading from '@components/ui/SplitHeading.astro';
import SectionNumber from '@components/ui/SectionNumber.astro';
import ArticleCard from '@components/journal/ArticleCard.astro';

import { getArticles } from '@lib/content';
import { formatDate, pad, readingTime, slugify } from '@lib/format';
import { breadcrumbSchema } from '@lib/seo';

/**
 * Called the Journal, not the Blog. The word does most of the positioning
 * work on its own, and the articles are written to demonstrate expertise
 * rather than to chase keywords.
 *
 * Laid out as a magazine contents page rather than a blog roll:
 *
 *   masthead → cover story → the index
 *
 * The cover story is the newest article given a full dark band of its own,
 * because a uniform grid gives the reader no reason to start anywhere in
 * particular. The index below then lists everything, the cover story
 * included, which is the same convention a printed contents page follows and
 * the same one the portfolio index on the homepage uses.
 */

const articles = await getArticles();
const lead = articles[0];

/*
  Categories in the order they first appear, so the filter row reads as a
  reflection of what has actually been written rather than as the full enum
  from the schema, most of which may have nothing behind it yet.
*/
const categories = [...new Set(articles.map((article) => article.data.category))];

/* Counted per subject, so the contents strip states what has actually been
   written rather than the full enum from the schema. */
const categoryCounts = categories.map((category) => ({
  name: category,
  count: articles.filter((article) => article.data.category === category).length,
}));

const total = articles.length;
const latest = lead ? formatDate(lead.data.publishedAt) : '';

const issueFacts = [
  { label: 'Articles', value: pad(total) },
  { label: 'Subjects', value: pad(categories.length) },
  { label: 'Latest', value: latest },
];

/*
  A three-step rhythm across the index, so no two rows of the grid are
  measured the same. The wide slot takes the feature frame, which is a
  different crop and a larger heading, not just a wider column.
*/
const rhythm = (index: number) => {
  switch (index % 3) {
    case 0:
      return { span: 'md:col-span-7', variant: 'feature' as const };
    case 1:
      return { span: 'md:col-span-5 md:mt-(--stack-lg)', variant: 'default' as const };
    default:
      return { span: 'md:col-span-6 md:col-start-4', variant: 'default' as const };
  }
};

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Journal', path: '/journal' },
  ]),
];
---

<BaseLayout
  title="Journal"
  description="Writing on materials, craft, sourcing and considered interior design from the studio at Zen Interior."
  schema={schema}
>
  {/* ------------------------------------------------------------ masthead */}
  {/*
    Set as a printed masthead rather than a page header: a dateline rule above
    the title, the title at full width, then the standfirst and the issue
    figures on one line, and the subjects as a contents strip along the foot.

    Every figure here is counted from the articles themselves, so the masthead
    cannot advertise a subject with nothing behind it.
  */}
  <section class="relative isolate overflow-hidden bg-ivory">
    <span
      class="pointer-events-none absolute -right-[2vw] -bottom-[0.3em] font-display text-[clamp(9rem,26vw,22rem)] leading-none tracking-[-0.05em] text-teal/[0.035] select-none"
      aria-hidden="true">Journal</span
    >

    <Container class="pt-[clamp(2.5rem,4.5vw,4.5rem)] pb-(--section-y-tight)">
      {/* ------------------------------------------------------- the dateline */}
      <Reveal variant="fade">
        <div
          class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 border-b border-beige pb-4"
        >
          <p class="label text-teal/70">The Zen Journal</p>
          <p class="label text-teal/35">Written from the studio</p>
        </div>
      </Reveal>

      {/* ---------------------------------------------------------- the title */}
      <div data-reveal-group>
        <SplitHeading
          as="h1"
          size="xl"
          lines={['Notes on material,', 'proportion and craft.']}
          accentFrom={1}
          accentItalic
          class="mt-[clamp(2rem,3.5vw,3.5rem)]"
        />

        <div
          class="mt-[clamp(2rem,3.5vw,3.25rem)] grid gap-y-9 md:grid-cols-12 md:items-end md:gap-x-12"
        >
          <div class="md:col-span-6">
            <Reveal>
              <p class="lede max-w-[46ch] text-charcoal/72">
                What we have learned building interiors that have to hold up close, and what
                we think is worth knowing before you commission one.
              </p>
            </Reveal>
          </div>

          {/* The issue figures, kept on the same line as the standfirst so the
              masthead resolves in one band instead of two stacked blocks. */}
          <div class="md:col-span-5 md:col-start-8">
            <dl class="grid grid-cols-3 gap-x-6" data-reveal-group="60">
              {
                issueFacts.map((fact, index) => (
                  <Reveal
                    variant="fade"
                    class:list={[index > 0 && 'border-l border-beige pl-6']}
                  >
                    <dt class="label text-teal/40">{fact.label}</dt>
                    <dd class="mt-3 font-display text-[clamp(1.25rem,1rem+0.8vw,1.75rem)] leading-[1.2] text-teal">
                      {fact.value}
                    </dd>
                  </Reveal>
                ))
              }
            </dl>
          </div>
        </div>
      </div>

      {/* ------------------------------------------------------ the contents */}
      <Reveal variant="fade" class="mt-[clamp(2.25rem,4vw,3.5rem)] border-t border-beige pt-5">
        <div class="flex flex-wrap items-baseline gap-x-9 gap-y-3">
          <p class="label text-teal/35">Subjects</p>
          {
            categoryCounts.map((subject) => (
              <p class="flex items-baseline gap-2">
                <span class="text-small text-charcoal/75">{subject.name}</span>
                <span class="label text-teal/35">{pad(subject.count)}</span>
              </p>
            ))
          }
        </div>
      </Reveal>
    </Container>
  </section>

  {/* --------------------------------------------------------- cover story */}
  {
    lead && (
      <section class="bg-teal text-ivory on-dark">
        <Container class="section-tight">
          <div
            class="grid gap-y-(--stack-md) lg:grid-cols-12 lg:items-center lg:gap-x-16"
            data-reveal-group
          >
            <div class="lg:col-span-7">
              <Reveal variant="clip">
                <a
                  href={`/journal/${lead.id}`}
                  class="group block focus-visible:outline-offset-4"
                  tabindex="-1"
                  aria-hidden="true"
                >
                  <div class="aspect-[4/5] overflow-hidden rounded-zen bg-teal-deep sm:aspect-[16/10] lg:aspect-[4/3]">
                    <Image
                      src={lead.data.cover}
                      alt=""
                      widths={[480, 800, 1200, 1600]}
                      sizes="(min-width: 1024px) 56vw, 92vw"
                      loading="eager"
                      fetchpriority="high"
                      class="h-full w-full object-cover transition-transform duration-[1600ms] ease-(--ease-zen) group-hover:scale-[1.03]"
                    />
                  </div>
                </a>
              </Reveal>
            </div>

            <div class="lg:col-span-5">
              <Reveal variant="fade">
                <SectionNumber value="01" tone="dark" />
              </Reveal>

              <Reveal variant="fade" class="mt-4">
                <Eyebrow tone="inverse">Cover Story &nbsp;/&nbsp; {lead.data.category}</Eyebrow>
              </Reveal>

              <Reveal>
                <h2 class="mt-6 font-display text-display-lg text-ivory">
                  <a
                    href={`/journal/${lead.id}`}
                    class="transition-colors duration-500 hover:text-brass-soft focus-visible:outline-offset-4"
                  >
                    {lead.data.title}
                  </a>
                </h2>
              </Reveal>

              <Reveal>
                <p class="lede mt-6 max-w-[46ch] text-ivory/65">{lead.data.excerpt}</p>
              </Reveal>

              <Reveal variant="fade" class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
                <Button href={`/journal/${lead.id}`} variant="outline" tone="dark">
                  Read the Article
                </Button>
                <p class="label text-ivory/40">
                  <time datetime={lead.data.publishedAt.toISOString()}>
                    {formatDate(lead.data.publishedAt)}
                  </time>
                  &nbsp;·&nbsp; {readingTime(lead.body ?? '')} Min Read
                </p>
              </Reveal>
            </div>
          </div>
        </Container>
      </section>
    )
  }

  {/* --------------------------------------------------------------- index */}
  <section class="bg-ivory">
    <Container class="section">
      <div data-reveal-group>
        <Reveal variant="fade">
          <SectionNumber value="02" />
        </Reveal>

        <Reveal variant="fade" class="mt-4">
          <Eyebrow>The Index</Eyebrow>
        </Reveal>

        <SplitHeading
          lines={['Everything we have', 'written, in order.']}
          accentFrom={1}
          class="mt-6"
        />
      </div>

      {/*
        Category filter. Vanilla DOM filtering over already-rendered cards, so
        every article is in the HTML and indexable regardless of the active
        filter. No client-side routing, no framework.
      */}
      <div
        class="mt-(--stack-lg) flex flex-wrap items-center gap-x-8 gap-y-4 border-y border-beige py-6"
        data-journal-filter
        role="group"
        aria-label="Filter articles by subject"
      >
        <button
          type="button"
          data-filter-value="all"
          aria-pressed="true"
          class="label text-teal/50 transition-colors duration-300 hover:text-teal aria-pressed:text-teal"
        >
          All
        </button>
        {
          categories.map((category) => (
            <button
              type="button"
              data-filter-value={slugify(category)}
              aria-pressed="false"
              class="label text-teal/50 transition-colors duration-300 hover:text-teal aria-pressed:text-teal"
            >
              {category}
            </button>
          ))
        }
        <p class="label ml-auto text-teal/30" data-filter-count aria-live="polite">
          {total} {total === 1 ? 'Article' : 'Articles'}
        </p>
      </div>

      {/*
        Deliberately not a uniform grid. Twelve columns from the medium
        breakpoint up, two even columns on small tablets, one on a phone.
      */}
      <div
        class="mt-(--stack-lg) grid gap-x-10 gap-y-16 sm:grid-cols-2 sm:gap-y-20 md:grid-cols-12 md:gap-x-12 md:gap-y-24"
        data-reveal-group
      >
        {
          articles.map((article, index) => {
            const slot = rhythm(index);

            return (
              <div
                class:list={[slot.span]}
                data-article-category={slugify(article.data.category)}
              >
                <Reveal variant="fade" class="mb-5 flex items-center gap-4">
                  <span class="label text-teal/30" aria-hidden="true">
                    {pad(index + 1)}
                  </span>
                  <span class="h-px flex-1 bg-beige" aria-hidden="true" />
                </Reveal>

                <ArticleCard article={article} variant={slot.variant} />
              </div>
            );
          })
        }
      </div>

      <p class="label mt-20 hidden text-center text-teal/50" data-filter-empty>
        Nothing on this subject yet.
      </p>
    </Container>
  </section>
</BaseLayout>

<script>
  /**
   * Subject filter for the journal index.
   *
   * Same contract as the projects filter: every article is already in the
   * document, the buttons only toggle visibility, and the active subject is
   * written into the query string so a filtered view can be shared and
   * survives a back navigation.
   */
  const group = document.querySelector<HTMLElement>('[data-journal-filter]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-article-category]'));
  const count = document.querySelector<HTMLElement>('[data-filter-count]');
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');

  if (group && cards.length > 0) {
    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-filter-value]'));

    const apply = (value: string) => {
      let visible = 0;

      for (const card of cards) {
        const matches = value === 'all' || card.dataset.articleCategory === value;
        card.hidden = !matches;
        if (matches) visible += 1;
      }

      for (const button of buttons) {
        button.setAttribute(
          'aria-pressed',
          button.dataset.filterValue === value ? 'true' : 'false',
        );
      }

      if (count) {
        count.textContent = `${visible} ${visible === 1 ? 'Article' : 'Articles'}`;
      }
      if (empty) empty.classList.toggle('hidden', visible > 0);
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const value = button.dataset.filterValue ?? 'all';
        apply(value);
        const url = new URL(window.location.href);
        if (value === 'all') url.searchParams.delete('subject');
        else url.searchParams.set('subject', value);
        window.history.replaceState({}, '', url);
      });
    }

    // Honour ?subject= on load, so a link can deep-link into a filter.
    const initial = new URL(window.location.href).searchParams.get('subject');
    if (initial && buttons.some((button) => button.dataset.filterValue === initial)) {
      apply(initial);
    }
  }
</script>
