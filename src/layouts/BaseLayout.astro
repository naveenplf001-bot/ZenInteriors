---
import '@fontsource-variable/cormorant-garamond';
import '@fontsource-variable/manrope';
import '@styles/global.css';

import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import SEO from '@components/seo/SEO.astro';
import JsonLd from '@components/seo/JsonLd.astro';

import { site } from '@config/site';
import { organizationSchema } from '@lib/seo';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
  isHome?: boolean;
  /** overlay lets a full-bleed hero run under a transparent header. */
  header?: 'overlay' | 'solid';
  /** Extra structured data for this page, merged with the Organization schema. */
  schema?: Array<Record<string, unknown>>;
}

const {
  title,
  description,
  image,
  type,
  publishedTime,
  noindex,
  isHome = false,
  header = 'solid',
  schema = [],
} = Astro.props;

const structuredData = [organizationSchema(), ...schema];
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      noindex={noindex}
      isHome={isHome}
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#01342F" />

    {structuredData.map((entry) => <JsonLd schema={entry} />)}

    {/*
      Marks the document as script-enabled before first paint, so the reveal
      system's hidden initial state never applies to a visitor without JS.
      Inline and synchronous on purpose: deferring it would cause a flash.
    */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <Header variant={header} />

    <main id="main" class={header === 'overlay' ? '' : 'pt-[--header-h]'}>
      <slot />
    </main>

    <Footer />

    <script>
      import { initReveal } from '@/scripts/reveal';
      initReveal();
    </script>
  </body>
</html>
